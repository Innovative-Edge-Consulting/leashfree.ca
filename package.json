{
  "name": "leashfree-static-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/assert-production-branch.js",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "npm run build && npx wrangler deploy && npm run indexnow:submit",
    "build:rocky-mountain-dog-products": "node scripts/build-rocky-mountain-dog-products.js",
    "convert:cms": "node scripts/convert-cms.js",
    "build:media-map": "node scripts/build-media-map.js",
    "dedupe:directories": "node scripts/dedupe-directories.js",
    "dedupe:dog-breeds": "node scripts/dedupe-dog-breeds.js",
    "media:scan": "node scripts/build-media-map.js",
    "media:copy:dry": "node scripts/copy-media.js --dry-run",
    "media:copy": "node scripts/copy-media.js --write",
    "optimize:images": "node scripts/optimize-images.mjs",
    "audit:homepage-images": "node scripts/audit-homepage-images.mjs",
    "validate:data": "node scripts/validate-data.js",
    "data:audit:dog-food": "node scripts/auditDogFoodProducts.mjs",
    "migrate:prep": "npm run convert:cms && npm run dedupe:directories && npm run dedupe:dog-breeds && npm run build:media-map && npm run validate:data && npm run optimize:images",
    "content:prepare": "npm run convert:cms && npm run dedupe:directories && npm run dedupe:dog-breeds && npm run build:media-map && npm run validate:data && npm run optimize:images",
    "qa:pages": "node scripts/qa-pages.js",
    "content:health": "node scripts/content-health.js",
    "backlog:thin-pages": "node scripts/build-thin-page-backlog.mjs",
    "indexnow:submit": "node scripts/submit-indexnow.mjs",
    "launch:check": "npm run build && npm run qa:pages && npm audit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.1",
    "astro": "^7.0.7",
    "leaflet": "^1.9.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "typescript": "^5.6.3"
  }
}
