---
import Card from "../../components/Card.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import breeds from "../../data/generated/dog-breeds.json";
import groups from "../../data/generated/breed-groups.json";
import { excerpt, breadcrumbSchema } from "../../utils/content.js";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Dog Breeds", href: "/dog-breeds/" }
];
---

<Layout
  title="Dog Breeds"
  description="Browse dog breed profiles converted from LeashFree.ca Webflow CMS data."
  canonical="https://leashfree.ca/dog-breeds/"
  structuredData={breadcrumbSchema(breadcrumbs)}
>
  <Hero
    eyebrow="Dog breeds"
    title="Explore dog breed profiles"
    summary="Review breed guides with traits, grooming, exercise, training, and health fields where available from the CMS export."
    primaryHref="#breeds"
    primaryLabel="Browse breeds"
    secondaryHref="#groups"
    secondaryLabel="Browse groups"
  />

  <Section id="groups" title="Breed groups" intro="Group pages provide a lightweight way to browse similar breeds." alt>
    <div class="grid compact">
      {groups.map((group) => (
        <Card title={group.name} href={`/dog-breeds/group/${group.slug}/`} description={excerpt(group.metaDescription, group.description)} ctaLabel="View group" />
      ))}
    </div>
  </Section>

  <Section id="breeds" title="Breed profiles" intro={`${breeds.length} dog breed pages are generated from the CMS export.`}>
    <div class="grid">
      {breeds.map((breed) => (
        <Card
          title={breed.name}
          href={`/dog-breeds/${breed.slug}/`}
          description={excerpt(breed.metaDescription, breed.description)}
          badges={[breed.raw["Breed Group"], breed.raw["Size Category"]].filter(Boolean)}
          ctaLabel="View breed"
        />
      ))}
    </div>
  </Section>
</Layout>
