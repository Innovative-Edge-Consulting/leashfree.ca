---
interface Crumb {
  href?: string;
  label: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

{items.length > 0 && (
  <nav class="breadcrumb" aria-label="Breadcrumb">
    {items.map((item, index) => (
      <>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? <a href={item.href}>{item.label}</a> : <span>{item.label}</span>}
      </>
    ))}
  </nav>
)}
