---
interface Props {
  title?: string;
  intro?: string;
  defaultCategory?: string;
  csvUrl?: string;
}

const {
  title = "Search Dog & Puppy Names",
  intro = "Search the list or filter by gender and category.",
  defaultCategory = "",
  csvUrl = "/data/top-1000-dog-names-2026.csv"
} = Astro.props;

const categories = [
  "Male Names",
  "Female Names",
  "Cute Names",
  "Unique Names",
  "Strong Names",
  "Nature-Inspired Names",
  "Color-Inspired Names",
  "Canadian-Inspired Names"
];
---

<section
  class="dog-names-table"
  data-csv-url={csvUrl}
  data-default-category={defaultCategory}
  style="--lf-primary:#497f64;--lf-bg:#f3f9ec;--lf-ink:#173a2e;--lf-muted:#5d8a75;"
>
  <div class="lf-wrap">
    <header class="lf-head">
      <div class="lf-eyebrow">Searchable name database</div>
      <h2 class="lf-title">{title}</h2>
      <p class="lf-sub">
        {intro}
        {defaultCategory && <> Pre-filtered to <strong>{defaultCategory}</strong>.</>}
        Prefer personalized ideas? <a href="/dog-name-finder/">Try the Dog Name Finder</a>.
      </p>
    </header>
    <div class="lf-controls" role="region" aria-label="Dog name filters">
      <label class="lf-field lf-search-field"><span>Search names or meanings</span><input class="lf-search" type="search" placeholder="Try Maple, strong, nature..." /></label>
      <label class="lf-field"><span>Gender</span><select class="lf-gender">
        <option value="">All Genders</option>
        <option>Male</option>
        <option>Female</option>
        <option>Unisex</option>
      </select></label>
      <label class="lf-field"><span>Category</span><select class="lf-category">
        <option value="">All Categories</option>
        {categories.map((category) => <option selected={category === defaultCategory}>{category}</option>)}
      </select></label>
      <label class="lf-field"><span>Starts with</span><select class="lf-letter">
        <option value="">Any letter</option>
        {"ABCDEFGHIJKLMNOPQRSTUVWXYZ".split("").map((letter) => <option>{letter}</option>)}
      </select></label>
      <label class="lf-field"><span>Popularity</span><select class="lf-popularity">
        <option value="">Any rank</option>
        <option value="top-50">Top 50</option>
        <option value="top-100">Top 100</option>
        <option value="top-250">Top 250</option>
        <option value="outside-250">Beyond top 250</option>
      </select></label>
      <label class="lf-field"><span>Sort by</span><select class="lf-sort">
        <option value="rank">Popularity rank</option>
        <option value="name">Name A–Z</option>
        <option value="name-desc">Name Z–A</option>
      </select></label>
      <label class="lf-field lf-pagesize"><span>Results per page</span>
        <select class="lf-page-size" aria-label="Rows per page">
          <option selected>50</option>
          <option>100</option>
          <option>200</option>
        </select>
      </label>
      <button type="button" class="lf-clear" aria-label="Clear filters">Reset filters</button>
    </div>
    <div class="lf-meta">
      <span class="lf-count">Loading...</span>
      <div class="lf-meta-actions">
        <a class="lf-saved-link" href="/dog-names/my-list/"><span aria-hidden="true">♥</span> <strong class="lf-saved-count">0</strong> saved</a>
        <a class="lf-share" href="#" aria-label="Copy link with current filters">Share filtered view</a>
      </div>
    </div>
    <div class="lf-table-wrap">
      <table class="lf-table" aria-describedby="lf-count">
        <thead>
          <tr>
            <th class="col-rank" scope="col">Rank</th>
            <th class="col-name" scope="col">Name</th>
            <th class="col-desc" scope="col">Meaning</th>
            <th class="col-gender" scope="col">Ideal gender</th>
            <th class="col-cat" scope="col">Category</th>
            <th class="col-save" scope="col">Save</th>
          </tr>
        </thead>
        <tbody class="lf-body"></tbody>
      </table>
    </div>
    <nav class="lf-pager" aria-label="Pagination">
      <button class="lf-prev" type="button" disabled>Previous</button>
      <span class="lf-page-label">Page 1</span>
      <button class="lf-next" type="button" disabled>Next</button>
    </nav>
    <aside class="lf-related" hidden aria-live="polite">
      <div><div class="lf-eyebrow">Keep exploring</div><h3 class="lf-related-title">Names similar to your latest save</h3><p class="lf-related-copy"></p></div>
      <div class="lf-related-grid"></div>
    </aside>
  </div>
</section>

<script>
  import { getShortlist, loadMasterNames, setShortlist } from "../scripts/dog-name-shortlist.js";

  (() => {
    const tables = Array.from(document.querySelectorAll(".dog-names-table"));
    if (!tables.length) return;

    function escapeHTML(s) {
      return (s || "").replace(/[&<>"']/g, (m) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[m]);
    }

    tables.forEach((root) => {
      const DEFAULT_CAT = root.dataset.defaultCategory || "";
      const elSearch = root.querySelector(".lf-search");
      const elGender = root.querySelector(".lf-gender");
      const elCategory = root.querySelector(".lf-category");
      const elLetter = root.querySelector(".lf-letter");
      const elPopularity = root.querySelector(".lf-popularity");
      const elSort = root.querySelector(".lf-sort");
      const elPageSize = root.querySelector(".lf-page-size");
      const elBody = root.querySelector(".lf-body");
      const elCount = root.querySelector(".lf-count");
      const elPrev = root.querySelector(".lf-prev");
      const elNext = root.querySelector(".lf-next");
      const elPageLbl = root.querySelector(".lf-page-label");
      const elShare = root.querySelector(".lf-share");
      const elSavedCount = root.querySelector(".lf-saved-count");
      const elClear = root.querySelector(".lf-clear");
      const elRelated = root.querySelector(".lf-related");
      const elRelatedTitle = root.querySelector(".lf-related-title");
      const elRelatedCopy = root.querySelector(".lf-related-copy");
      const elRelatedGrid = root.querySelector(".lf-related-grid");
      let rows = [];
      let filtered = [];
      let page = 1;
      let saved = getShortlist();

      const isSaved = (record) => saved.some((item) => item.id === record.id);
      const updateSavedCount = () => { elSavedCount.textContent = String(saved.length); };

      function applyFilters() {
        const q = elSearch.value.trim().toLowerCase();
        const g = elGender.value;
        const c = elCategory.value || DEFAULT_CAT;
        const letter = elLetter.value;
        const popularity = elPopularity.value;
        filtered = rows.filter((r) => {
          const okQ = !q || r.name.toLowerCase().includes(q) || r.meaning.toLowerCase().includes(q);
          const okG = !g || r.gender === g;
          const okC = !c || r.category === c;
          const okLetter = !letter || r.name.toUpperCase().startsWith(letter);
          const okPopularity = !popularity
            || (popularity === "top-50" && r.rank <= 50)
            || (popularity === "top-100" && r.rank <= 100)
            || (popularity === "top-250" && r.rank <= 250)
            || (popularity === "outside-250" && r.rank > 250);
          return okQ && okG && okC && okLetter && okPopularity;
        });
        filtered.sort((a, b) => elSort.value === "name" ? a.name.localeCompare(b.name) : elSort.value === "name-desc" ? b.name.localeCompare(a.name) : a.rank - b.rank);
        page = 1;
        render();
      }

      function render() {
        const per = parseInt(elPageSize.value, 10) || 50;
        const total = filtered.length;
        const pages = Math.max(1, Math.ceil(total / per));
        page = Math.min(Math.max(1, page), pages);
        elCount.textContent = `${total.toLocaleString()} result${total === 1 ? "" : "s"}`;
        elPrev.disabled = page <= 1;
        elNext.disabled = page >= pages;
        elPageLbl.textContent = `Page ${page} of ${pages}`;
        const start = (page - 1) * per;
        const slice = filtered.slice(start, start + per);
        elBody.innerHTML = slice
          .map(
            (r) => `
              <tr>
                <td class="col-rank" data-label="Rank"><span>#${escapeHTML(String(r.rank || ""))}</span></td>
                <td class="col-name" data-label="Name"><strong>${escapeHTML(r.name)}</strong></td>
                <td class="col-desc" data-label="Meaning">${escapeHTML(r.meaning)}</td>
                <td class="col-gender" data-label="Ideal gender"><span class="lf-gender-tag">${escapeHTML(r.gender)}</span></td>
                <td class="col-cat" data-label="Category"><span class="lf-tag">${escapeHTML(r.category)}</span></td>
                <td class="col-save" data-label="Save"><button class="lf-save-name" type="button" data-record-id="${escapeHTML(r.id)}" aria-pressed="${isSaved(r)}" aria-label="${isSaved(r) ? "Remove" : "Save"} ${escapeHTML(r.name)} ${isSaved(r) ? "from" : "to"} your shortlist"><span aria-hidden="true">${isSaved(r) ? "♥" : "♡"}</span></button></td>
              </tr>`
          )
          .join("") || `<tr class="lf-empty"><td colspan="6"><strong>No matching names</strong><span>Try a broader search or reset the filters.</span></td></tr>`;
        elShare.href = window.location.href;
        updateSavedCount();
      }

      const debounce = (fn, ms) => {
        let t;
        return (...a) => {
          clearTimeout(t);
          t = setTimeout(() => fn.apply(null, a), ms);
        };
      };

      function renderRelated(record) {
        if (!record || !elRelated) return;
        const savedIds = new Set(saved.map((item) => item.id));
        const candidates = rows
          .filter((item) => item.id !== record.id && !savedIds.has(item.id))
          .map((item) => ({ item, score: (item.category === record.category ? 4 : 0) + (item.gender === record.gender ? 2 : 0) + (item.name[0] === record.name[0] ? 1 : 0) - Math.min(Math.abs(item.rank - record.rank) / 250, 1) }))
          .sort((a, b) => b.score - a.score || a.item.rank - b.item.rank)
          .slice(0, 4)
          .map(({ item }) => item);
        elRelated.hidden = !candidates.length;
        elRelatedTitle.textContent = `More names like ${record.name}`;
        elRelatedCopy.textContent = `Suggestions based on category, ideal gender, first letter, and nearby popularity—not assumed personality traits.`;
        elRelatedGrid.replaceChildren(...candidates.map((item) => {
          const article = document.createElement("article");
          const copy = document.createElement("div");
          const title = document.createElement("strong"); title.textContent = item.name;
          const meta = document.createElement("small"); meta.textContent = `${item.gender} · ${item.category}`;
          const button = document.createElement("button"); button.type = "button"; button.className = "lf-related-save"; button.textContent = "♡ Save";
          button.addEventListener("click", () => { saved = setShortlist([...saved, { ...item, savedAt: new Date().toISOString() }]); render(); renderRelated(record); });
          copy.append(title, meta); article.append(copy, button); return article;
        }));
      }

      loadMasterNames()
        .then((records) => {
          rows = records.filter((record) => record.name && record.rank).sort((a, b) => (a.rank || 0) - (b.rank || 0));
          if (DEFAULT_CAT) elCategory.value = DEFAULT_CAT;
          applyFilters();
        })
        .catch(() => {
          elCount.textContent = "Could not load the list.";
        });

      elSearch.addEventListener("input", debounce(applyFilters, 150));
      [elGender, elCategory, elLetter, elPopularity, elSort].forEach((control) => control.addEventListener("change", applyFilters));
      elPageSize.addEventListener("change", applyFilters);
      elPrev.addEventListener("click", () => {
        page--;
        render();
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      elNext.addEventListener("click", () => {
        page++;
        render();
        root.scrollIntoView({ behavior: "smooth", block: "start" });
      });
      elClear.addEventListener("click", () => {
        elSearch.value = "";
        elGender.value = "";
        elCategory.value = DEFAULT_CAT;
        elLetter.value = "";
        elPopularity.value = "";
        elSort.value = "rank";
        elPageSize.value = "50";
        applyFilters();
      });
      elBody.addEventListener("click", (event) => {
        const button = event.target.closest(".lf-save-name");
        if (!button) return;
        const record = rows.find((item) => item.id === button.dataset.recordId);
        if (!record) return;
        saved = isSaved(record)
          ? setShortlist(saved.filter((item) => item.id !== record.id))
          : setShortlist([...saved, { ...record, savedAt: new Date().toISOString() }]);
        render();
        if (isSaved(record)) renderRelated(record);
      });
      window.addEventListener("dog-shortlist-change", (event) => {
        saved = event.detail;
        render();
      });
      window.addEventListener("storage", (event) => {
        if (event.key === "leashfree-dog-name-shortlist-v2") {
          saved = getShortlist();
          render();
        }
      });
      elShare.addEventListener("click", (event) => {
        event.preventDefault();
        navigator.clipboard?.writeText(elShare.href).then(() => {
          elShare.textContent = "Link copied!";
          setTimeout(() => (elShare.textContent = "Share filtered view"), 1200);
        });
      });
    });
  })();
</script>

<style>
  .dog-names-table {
    overflow: hidden;
    background: var(--color-surface);
    color: var(--lf-ink);
    border: 1px solid var(--color-border);
    border-radius: 22px;
    margin: var(--space-5) 0;
    box-shadow: 0 16px 40px rgba(31, 41, 51, 0.08);
  }
  .dog-names-table .lf-wrap {
    padding: 0;
  }
  .lf-head {
    padding: var(--space-5);
    background: linear-gradient(135deg, var(--color-primary-dark), #497f64);
  }
  .lf-eyebrow {
    margin-bottom: .45rem;
    color: #f2c96d;
    font-size: .72rem;
    font-weight: 900;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .lf-title {
    color: #fff;
    font-size: clamp(24px, 4vw, 36px);
    margin: 0 0 6px;
  }
  .lf-sub {
    max-width: 780px;
    color: rgba(255,255,255,.78);
    margin: 0;
  }
  .lf-sub a { color: #fff; font-weight: 850; }
  .lf-controls, .lf-meta, .lf-table-wrap, .lf-pager { margin-inline: var(--space-5); }
  .lf-controls {
    padding-top: var(--space-5);
  }
  .lf-controls {
    display: grid;
    grid-template-columns: repeat(12,minmax(0,1fr));
    gap: var(--space-3);
    align-items: end;
    margin-bottom: var(--space-3);
  }
  .lf-search-field { grid-column: span 4; }
  .lf-controls .lf-field:not(.lf-search-field) { grid-column: span 2; }
  .lf-controls .lf-pagesize { grid-column: span 2; }
  .lf-clear { grid-column: span 2; }
  .lf-field { display: grid; gap: .4rem; color: var(--color-text); font-size: .76rem; font-weight: 850; }
  .lf-field input, .lf-field select {
    min-height: 44px;
    border: 1px solid #d7e6df;
    border-radius: 10px;
    background: #fff;
    padding: 10px 12px;
    color: var(--color-text);
  }
  .lf-pagesize {
    white-space: nowrap;
  }
  .lf-clear {
    min-height: 44px;
    border: 1px solid var(--color-border);
    border-radius: 10px;
    background: #fff;
    color: var(--color-primary-dark);
    cursor: pointer;
    padding: 10px 14px;
    font-weight: 850;
  }
  .lf-clear:hover { border-color: var(--color-primary); background: var(--color-primary-soft); }
  .lf-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--color-muted);
    margin-block: var(--space-3);
  }
  .lf-meta-actions { display: flex; align-items: center; gap: var(--space-4); }
  .lf-saved-link { display: inline-flex; align-items: center; gap: .3rem; font-weight: 850; }
  .lf-saved-link span { color: #c64f65; font-size: 1.05rem; }
  .lf-count { border-radius: 999px; background: var(--color-primary-soft); padding: .35rem .7rem; color: var(--color-primary-dark); font-weight: 850; }
  .lf-share { font-weight: 800; }
  .lf-table-wrap {
    overflow: auto;
    border: 1px solid #dbe9e3;
    border-radius: 14px;
    background: #fff;
  }
  .lf-table {
    width: 100%;
    min-width: 760px;
    border-collapse: collapse;
  }
  .lf-table th,
  .lf-table td {
    border-bottom: 1px solid #edf4f1;
    padding: .9rem 1rem;
    text-align: left;
    vertical-align: top;
  }
  .lf-table th {
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-primary-soft);
    color: var(--color-primary-dark);
    font-size: .76rem;
    font-weight: 900;
    letter-spacing: .03em;
    text-transform: uppercase;
  }
  .lf-table tbody tr:nth-child(even) { background: #fbfdfc; }
  .lf-table tbody tr:hover { background: #f4f9f6; }
  .col-rank span { color: var(--color-muted); font-weight: 850; }
  .lf-tag {
    display: inline-block;
    border: 1px solid #d3e4dd;
    border-radius: var(--radius-pill);
    background: #f5fbf8;
    color: #2a5a47;
    font-size: 12px;
    padding: 2px 8px;
  }
  .lf-gender-tag { color: var(--color-text); font-size: .86rem; font-weight: 750; }
  .col-save { width: 68px; text-align: center !important; }
  .lf-save-name { display: inline-grid; width: 38px; height: 38px; place-items: center; border: 1px solid #d7e6df; border-radius: 50%; background: #fff; color: #b3485d; cursor: pointer; font-size: 1.35rem; line-height: 1; transition: transform .15s ease, background .15s ease, border-color .15s ease; }
  .lf-save-name:hover { transform: translateY(-1px); border-color: #c9687b; background: #fff5f7; }
  .lf-save-name[aria-pressed="true"] { border-color: #e7a9b5; background: #fff0f3; color: #b33f56; }
  .lf-save-name:focus-visible { outline: 3px solid rgba(73,127,100,.3); outline-offset: 2px; }
  :global(.dog-names-table .lf-table tbody .col-save) { width: 68px; text-align: center; }
  :global(.dog-names-table .lf-save-name) { display: inline-grid; width: 38px; height: 38px; place-items: center; border: 1px solid #d7e6df; border-radius: 50%; background: #fff; color: #b3485d; cursor: pointer; font-size: 1.35rem; line-height: 1; transition: transform .15s ease, background .15s ease, border-color .15s ease; }
  :global(.dog-names-table .lf-save-name:hover) { transform: translateY(-1px); border-color: #c9687b; background: #fff5f7; }
  :global(.dog-names-table .lf-save-name[aria-pressed="true"]) { border-color: #e7a9b5; background: #fff0f3; color: #b33f56; }
  :global(.dog-names-table .lf-save-name:focus-visible) { outline: 3px solid rgba(73,127,100,.3); outline-offset: 2px; }
  .lf-empty td { padding: var(--space-6); text-align: center; }
  .lf-empty strong, .lf-empty span { display: block; }
  .lf-empty span { margin-top: .35rem; color: var(--color-muted); }
  .lf-pager {
    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: flex-end;
    margin-block: var(--space-4) var(--space-5);
  }
  .lf-related { margin: 0 var(--space-5) var(--space-5); padding: var(--space-4); border: 1px solid #d8e7e0; border-radius: 16px; background: linear-gradient(135deg,#f4f9f6,#fff); }
  .lf-related[hidden] { display: none; }
  .lf-related h3 { margin: 0 0 .25rem; }
  .lf-related-copy { margin: 0 0 var(--space-3); color: var(--color-muted); font-size: .84rem; }
  .lf-related-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: var(--space-3); }
  :global(.dog-names-table .lf-related-grid article) { display: flex; justify-content: space-between; gap: .7rem; align-items: center; padding: .75rem; border: 1px solid var(--color-border); border-radius: 12px; background: #fff; }
  :global(.dog-names-table .lf-related-grid small) { display: block; margin-top: .2rem; color: var(--color-muted); font-size: .7rem; }
  :global(.dog-names-table .lf-related-save) { flex: 0 0 auto; border: 0; background: transparent; color: #b3485d; cursor: pointer; font-weight: 850; }
  .lf-pager button {
    border: 1px solid #d3e4dd;
    min-height: 42px;
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    padding: 8px 12px;
  }
  .lf-pager button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  @media (max-width: 980px) {
    .lf-controls {
      grid-template-columns: 1fr 1fr;
    }
    .lf-search-field { grid-column: 1 / -1; }
    .lf-controls .lf-field:not(.lf-search-field), .lf-controls .lf-pagesize, .lf-clear { grid-column: auto; }
    .lf-related-grid { grid-template-columns: repeat(2,minmax(0,1fr)); }
  }
  @media (max-width: 640px) {
    .dog-names-table { margin-inline: 0; border-radius: 18px; }
    .lf-head, .lf-controls { padding-inline: var(--space-4); }
    .lf-controls, .lf-meta, .lf-table-wrap, .lf-pager { margin-inline: var(--space-4); }
    .lf-controls {
      grid-template-columns: 1fr;
    }
    .lf-search-field { grid-column: auto; }
    .lf-meta { align-items: flex-start; flex-direction: column; }
    .lf-meta-actions { width: 100%; justify-content: space-between; }
    .lf-related { margin-inline: var(--space-4); }
    .lf-related-grid { grid-template-columns: 1fr; }
    .lf-table-wrap { overflow: visible; border: 0; background: transparent; }
    .lf-table { min-width: 0; }
    .lf-table thead { display: none; }
    .lf-table tbody { display: grid; gap: var(--space-3); }
    .lf-table tbody tr { display: grid !important; grid-template-columns: 70px 1fr; overflow: hidden; border: 1px solid var(--color-border); border-radius: 14px; background: #fff; }
    .lf-table tbody tr:nth-child(even) { background: #fff; }
    .lf-table td { display: grid; grid-template-columns: 105px 1fr; grid-column: 1 / -1; gap: var(--space-2); border-bottom: 1px solid var(--color-border); padding: .7rem .85rem; }
    .lf-table td::before { content: attr(data-label); color: var(--color-muted); font-size: .72rem; font-weight: 850; text-transform: uppercase; }
    .lf-table .col-rank { grid-column: 1; grid-row: 1; grid-template-columns: 1fr; border: 0; background: var(--color-primary-soft); }
    .lf-table .col-rank::before { display: none; }
    .lf-table .col-name { grid-column: 2; grid-row: 1; grid-template-columns: minmax(0,1fr) auto; border: 0; background: var(--color-primary-soft); padding-right: 3.7rem; }
    .lf-table .col-name::before { display: none; }
    .lf-table .col-cat { border-bottom: 0; }
    .lf-table .col-save { position: absolute; top: .45rem; right: .55rem; display: block; width: auto; border: 0; padding: 0; background: transparent; }
    .lf-table .col-save::before { display: none; }
    .lf-pager { justify-content: space-between; }
