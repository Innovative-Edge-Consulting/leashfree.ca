---
interface Props {
  title: string;
  href?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  meta?: string;
  badges?: string[];
  ctaLabel?: string;
}

const { title, href, description, image, imageAlt = "", imagePosition, meta, badges = [], ctaLabel = "View details" } = Astro.props;
---

<article class="card">
  {image && <img class="card-media" style={imagePosition ? `object-position: ${imagePosition};` : undefined} src={image} alt={imageAlt} loading="lazy" decoding="async" />}
  <div class="card-body">
    {badges.length > 0 && <div class="badges">{badges.map((badge) => <span class="badge">{badge}</span>)}</div>}
    {meta && <p class="small">{meta}</p>}
    <h3>
      {href ? <a class="card-link" href={href}>{title}</a> : title}
    </h3>
    {description && <p>{description}</p>}
    {href && <a class="button secondary" href={href}>{ctaLabel}</a>}
    <slot />
  </div>
</article>
