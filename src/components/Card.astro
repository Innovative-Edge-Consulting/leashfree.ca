---
interface Props {
  title: string;
  href?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imagePosition?: string;
  meta?: string;
  badges?: string[];
  ctaLabel?: string;
  showCta?: boolean;
}

import { cleanText } from "../utils/content.js";

const {
  title,
  href,
  description,
  image,
  imageAlt = "",
  imagePosition,
  meta,
  badges = [],
  ctaLabel = "View details",
  showCta = true
} = Astro.props;

const cleanTitle = cleanText(title);
const cleanImageAlt = cleanText(imageAlt);
const cleanBadges = badges.map((badge) => cleanText(badge)).filter(Boolean);
---

<article class="card">
  {image && <img class="card-media" style={imagePosition ? `object-position: ${imagePosition};` : undefined} src={image} alt={cleanImageAlt} loading="lazy" decoding="async" />}
  <div class="card-body">
    {cleanBadges.length > 0 && <div class="badges">{cleanBadges.map((badge) => <span class="badge">{badge}</span>)}</div>}
    {meta && <p class="small">{meta}</p>}
    <h3>
      {href ? <a class="card-link" href={href}>{cleanTitle}</a> : cleanTitle}
    </h3>
    {description && <p>{description}</p>}
    {href && showCta && <a class="button secondary" href={href}>{ctaLabel}</a>}
    <slot />
  </div>
</article>
