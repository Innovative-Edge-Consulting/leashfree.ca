---
import SiteSearch from "./SiteSearch.astro";
---

<button class="header-search-trigger" type="button" aria-label="Open site search" aria-haspopup="dialog" data-search-open>
  <span class="header-search-icon" aria-hidden="true"></span>
  <span class="header-search-label">Search</span>
  <kbd>/</kbd>
</button>

<dialog class="header-search-dialog" aria-labelledby="header-search-title" data-search-dialog>
  <div class="header-search-dialog-head">
    <div>
      <span>Search LeashFree.ca</span>
      <h2 id="header-search-title">What can we help you find?</h2>
    </div>
    <button type="button" aria-label="Close search" data-search-close>Close <kbd>Esc</kbd></button>
  </div>
  <SiteSearch />
  <div class="header-search-footer">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>Enter</kbd> open</span>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("[data-search-dialog]");
  const openButton = document.querySelector("[data-search-open]");
  const closeButton = dialog?.querySelector("[data-search-close]");
  const input = dialog?.querySelector("[data-site-search-input]");

  const openSearch = () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.showModal();
    document.body.classList.add("search-dialog-open");
    requestAnimationFrame(() => input?.focus());
  };
  const closeSearch = () => {
    if (dialog instanceof HTMLDialogElement) dialog.close();
  };
  openButton?.addEventListener("click", openSearch);
  closeButton?.addEventListener("click", closeSearch);
  dialog?.addEventListener("close", () => document.body.classList.remove("search-dialog-open"));
  dialog?.addEventListener("click", (event) => { if (event.target === dialog) closeSearch(); });
  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable;
    if ((event.key === "k" && (event.metaKey || event.ctrlKey)) || (event.key === "/" && !isTyping)) {
      event.preventDefault();
      openSearch();
    }
  });
</script>
