---
import "leaflet/dist/leaflet.css";
import directories from "../data/generated/directories.json";
import { excerpt, firstValue } from "../utils/content.js";

function clean(value) {
  return typeof value === "string" ? value.trim() : "";
}

function number(value) {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : null;
}

function hasValidCoordinates(lat, lng) {
  if (lat === null || lng === null) return false;
  if (Math.abs(lat) < 0.000001 && Math.abs(lng) < 0.000001) return false;
  if (lat < -90 || lat > 90 || lng < -180 || lng > 180) return false;
  return true;
}

function slugLabel(value) {
  return clean(value)
    .split("-")
    .filter(Boolean)
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(" ");
}

function provinceName(value) {
  const key = clean(value).toLowerCase();
  const provinces = {
    ab: "Alberta",
    alberta: "Alberta",
    bc: "British Columbia",
    "british columbia": "British Columbia",
    mb: "Manitoba",
    manitoba: "Manitoba",
    nb: "New Brunswick",
    "new brunswick": "New Brunswick",
    nl: "Newfoundland and Labrador",
    "newfoundland and labrador": "Newfoundland and Labrador",
    ns: "Nova Scotia",
    "nova scotia": "Nova Scotia",
    nt: "Northwest Territories",
    "northwest territories": "Northwest Territories",
    nu: "Nunavut",
    on: "Ontario",
    ontario: "Ontario",
    pe: "Prince Edward Island",
    "prince edward island": "Prince Edward Island",
    qc: "Quebec",
    quebec: "Quebec",
    sk: "Saskatchewan",
    saskatchewan: "Saskatchewan",
    toronto: "Ontario",
    yt: "Yukon",
    yukon: "Yukon"
  };

  return provinces[key] || clean(value);
}

function businessItem(item) {
  const lat = number(item.raw.Latitude);
  const lng = number(item.raw.Longitude);
  const hasCoords = hasValidCoordinates(lat, lng);
  const categoryKey = clean(item.raw.Category || item.references.Category?.[0]);
  const description = excerpt(firstValue(item.raw["Short Description"], item.metaDescription, item.description), "", 150);

  return {
    name: item.name,
    url: `/directory/${item.slug}/`,
    lat,
    lng,
    hasCoords,
    city: slugLabel(clean(item.raw.City || item.references.City?.[0])),
    province: provinceName(item.raw.Province || item.references.Province?.[0]),
    address: clean(item.raw["Street Address"]),
    category: categoryKey ? slugLabel(categoryKey) : "Dog business",
    categoryKey,
    description,
    phone: clean(item.raw.Phone),
    directionsUrl: hasCoords ? `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`${lat},${lng}`)}` : ""
  };
}

const businessItems = directories.map(businessItem);
const provinces = [...new Set(businessItems.map((item) => item.province).filter(Boolean))].sort();
const cities = [...new Set(businessItems.map((item) => item.city).filter(Boolean))].sort();
const categories = [
  ...new Map(
    businessItems
      .filter((item) => item.categoryKey)
      .map((item) => [item.categoryKey, item.category])
  ).entries()
].map(([value, label]) => ({ value, label })).sort((a, b) => a.label.localeCompare(b.label));
const mappedCount = businessItems.filter((item) => item.hasCoords).length;
const json = JSON.stringify({ items: businessItems, provinces, cities, categories }).replace(/</g, "\\u003c");
---

<div class="home-map-search business-directory-search" data-business-directory-search>
  <div class="map-search-controls" aria-label="Business directory search filters">
    <div class="field wide">
      <label for="business-directory-query">Search</label>
      <input id="business-directory-query" type="search" autocomplete="off" placeholder="Business, category, city, address" />
    </div>

    <div class="map-actions">
      <button class="button primary" type="button" data-use-location>Use my location</button>
      <button class="button secondary" type="button" data-toggle-filters aria-expanded="false" aria-controls="advanced-business-directory-filters">Filters</button>
      <button class="button secondary" type="button" data-reset-map>Reset</button>
    </div>

    <div class="advanced-map-filters" id="advanced-business-directory-filters" hidden>
      <div class="field">
        <label for="business-directory-category">Category</label>
        <select id="business-directory-category">
          <option value="">All categories</option>
          {categories.map((category) => <option value={category.value}>{category.label}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="business-directory-province">Province</label>
        <select id="business-directory-province">
          <option value="">All provinces</option>
          {provinces.map((province) => <option value={province}>{province}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="business-directory-city">City</label>
        <select id="business-directory-city">
          <option value="">All cities</option>
          {cities.map((city) => <option value={city}>{city}</option>)}
        </select>
      </div>

      <div class="field">
        <label for="business-directory-radius">Radius</label>
        <select id="business-directory-radius">
          <option value="">Any distance</option>
          <option value="10">10 km</option>
          <option value="25">25 km</option>
          <option value="50">50 km</option>
          <option value="100">100 km</option>
        </select>
      </div>
    </div>
  </div>

  <div class="map-search-layout">
    <div class="map-canvas" id="business-directory-map" aria-label="Dog business directory map"></div>
    <aside class="map-results" aria-live="polite">
      <div class="map-results-header">
        <h3>Businesses</h3>
        <span data-result-count>{businessItems.length}</span>
      </div>
      <div class="map-location-status" data-location-status>{mappedCount} businesses shown on the map</div>
      <ol data-map-results></ol>
    </aside>
  </div>
</div>

<script type="application/json" id="business-directory-search-data" set:html={json}></script>
<script>
  import * as L from "leaflet";

  (() => {
    const root = document.querySelector("[data-business-directory-search]");
    const mapNode = document.getElementById("business-directory-map");
    const dataNode = document.getElementById("business-directory-search-data");
    if (!root || !mapNode || !dataNode) return;

    const data = JSON.parse(dataNode.textContent);
    const controls = {
      query: root.querySelector("#business-directory-query"),
      category: root.querySelector("#business-directory-category"),
      province: root.querySelector("#business-directory-province"),
      city: root.querySelector("#business-directory-city"),
      radius: root.querySelector("#business-directory-radius"),
      results: root.querySelector("[data-map-results]"),
      count: root.querySelector("[data-result-count]"),
      locationStatus: root.querySelector("[data-location-status]"),
      locationButton: root.querySelector("[data-use-location]"),
      filterToggle: root.querySelector("[data-toggle-filters]"),
      advancedFilters: root.querySelector("#advanced-business-directory-filters"),
      resetButton: root.querySelector("[data-reset-map]")
    };

    const canadaCenter = [56.4, -96.7];
    const canadaBounds = L.latLngBounds([41.6, -141], [83.2, -52.6]);
    const map = L.map(mapNode, {
      maxBounds: canadaBounds.pad(0.35),
      maxBoundsViscosity: 0.8,
      scrollWheelZoom: false
    }).setView(canadaCenter, 4);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 18,
      attribution: "&copy; OpenStreetMap contributors"
    }).addTo(map);

    let userLocation = null;
    const markers = new Map();
    const markerLayer = L.layerGroup().addTo(map);

    function escapeHtml(value) {
      return String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#39;");
    }

    function normalize(value) {
      return String(value || "").toLowerCase();
    }

    function distanceKm(a, b) {
      const radius = 6371;
      const lat1 = a.lat * Math.PI / 180;
      const lat2 = b.lat * Math.PI / 180;
      const deltaLat = (b.lat - a.lat) * Math.PI / 180;
      const deltaLng = (b.lng - a.lng) * Math.PI / 180;
      const h = Math.sin(deltaLat / 2) ** 2 + Math.cos(lat1) * Math.cos(lat2) * Math.sin(deltaLng / 2) ** 2;
      return 2 * radius * Math.atan2(Math.sqrt(h), Math.sqrt(1 - h));
    }

    function itemText(item) {
      return [item.name, item.category, item.address, item.city, item.province, item.description, item.phone]
        .map(normalize)
        .join(" ");
    }

    function filteredItems() {
      const query = normalize(controls.query.value).trim();
      const category = controls.category.value;
      const province = controls.province.value;
      const city = controls.city.value;
      const radius = Number(controls.radius.value);

      return data.items
        .filter((item) => !category || item.categoryKey === category)
        .filter((item) => !province || item.province === province)
        .filter((item) => !city || item.city === city)
        .filter((item) => !query || itemText(item).includes(query))
        .map((item) => ({
          ...item,
          distance: userLocation && item.hasCoords ? distanceKm(userLocation, item) : null
        }))
        .filter((item) => !radius || !userLocation || (item.distance !== null && item.distance <= radius))
        .sort((a, b) => {
          if (a.distance !== null && b.distance !== null) return a.distance - b.distance;
          if (a.city !== b.city) return String(a.city).localeCompare(String(b.city));
          return a.name.localeCompare(b.name);
        });
    }

    function popupHtml(item) {
      const meta = [item.city, item.province].filter(Boolean).join(", ");
      const distance = item.distance === null ? "" : `<span>${item.distance.toFixed(1)} km</span>`;
      return `
        <div class="pin-popup">
          <strong>${escapeHtml(item.name)}</strong>
          <span>${escapeHtml(item.category)}</span>
          <small>${escapeHtml(meta)}</small>
          ${distance}
          <div>
            <a href="${escapeHtml(item.url)}">Details</a>
            ${item.directionsUrl ? `<a href="${escapeHtml(item.directionsUrl)}" target="_blank" rel="noopener noreferrer">Directions</a>` : ""}
          </div>
        </div>
      `;
    }

    function hashString(value) {
      let hash = 0;
      const text = String(value || "");
      for (let i = 0; i < text.length; i += 1) {
        hash = ((hash << 5) - hash) + text.charCodeAt(i);
        hash |= 0;
      }
      return Math.abs(hash);
    }

    function categoryPinMeta(categoryKey, categoryLabel) {
      const palette = ["#0f766e", "#1d4ed8", "#9333ea", "#b45309", "#be123c", "#166534", "#0ea5e9", "#a16207", "#7c3aed", "#c2410c"];
      const source = String(categoryKey || categoryLabel || "business").trim().toLowerCase();
      const match = String(categoryLabel || source).match(/[a-z0-9]/i);
      return {
        letter: (match ? match[0] : "B").toUpperCase(),
        color: palette[hashString(source) % palette.length]
      };
    }

    function markerIcon(item) {
      const meta = categoryPinMeta(item.categoryKey, item.category);
      return L.divIcon({
        className: "map-pin business-pin",
        html: `<span style="--pin-color:${meta.color}">${meta.letter}</span>`,
        iconSize: [34, 34],
        iconAnchor: [17, 17],
        popupAnchor: [0, -17]
      });
    }

    function renderResults(items) {
      controls.count.textContent = String(items.length);
      controls.results.innerHTML = "";

      if (!items.length) {
        const li = document.createElement("li");
        li.innerHTML = "<span>No matching businesses</span><small>Try another category, city, province, or search term.</small>";
        controls.results.append(li);
        return;
      }

      items.slice(0, 12).forEach((item) => {
        const li = document.createElement("li");
        const meta = [item.city, item.province].filter(Boolean).join(", ");
        const distance = item.distance === null ? "" : `<span>${item.distance.toFixed(1)} km</span>`;
        const address = item.address ? `<small>${escapeHtml(item.address)}</small>` : "";
        li.innerHTML = `
          <a href="${escapeHtml(item.url)}">${escapeHtml(item.name)}</a>
          <span>${escapeHtml(item.category)}${meta ? ` in ${escapeHtml(meta)}` : ""}</span>
          ${address}
          ${distance}
        `;
        li.addEventListener("mouseenter", () => {
          const marker = markers.get(item.url);
          if (marker) marker.openPopup();
        });
        controls.results.append(li);
      });
    }

    function updateCityOptions(items) {
      const current = controls.city.value;
      const cities = [...new Set(items.map((item) => item.city).filter(Boolean))].sort();
      controls.city.innerHTML = `<option value="">All cities</option>${cities.map((city) => `<option value="${escapeHtml(city)}">${escapeHtml(city)}</option>`).join("")}`;
      if (cities.includes(current)) controls.city.value = current;
    }

    function renderMap() {
      const baseItems = data.items
        .filter((item) => !controls.category.value || item.categoryKey === controls.category.value)
        .filter((item) => !controls.province.value || item.province === controls.province.value);
      updateCityOptions(baseItems);

      const items = filteredItems();
      markerLayer.clearLayers();
      markers.clear();

      items.filter((item) => item.hasCoords).slice(0, 140).forEach((item) => {
        const marker = L.marker([item.lat, item.lng], { icon: markerIcon(item), title: item.name })
          .bindPopup(popupHtml(item));
        marker.addTo(markerLayer);
        markers.set(item.url, marker);
      });

      const mappedItems = items.filter((item) => item.hasCoords);
      controls.locationStatus.textContent = userLocation
        ? "Sorted by distance"
        : `${mappedItems.length} businesses shown on the map`;

      if (mappedItems.length) {
        const canadianItems = mappedItems.filter((item) => canadaBounds.contains([item.lat, item.lng]));
        if (canadianItems.length) {
          const bounds = L.latLngBounds(canadianItems.slice(0, 140).map((item) => [item.lat, item.lng]));
          map.fitBounds(bounds, { padding: [24, 24], maxZoom: 12 });
        } else {
          map.fitBounds(canadaBounds, { padding: [12, 12] });
        }
      }

      renderResults(items);
    }

    function reset() {
      controls.query.value = "";
      controls.category.value = "";
      controls.province.value = "";
      controls.city.value = "";
      controls.radius.value = "";
      userLocation = null;
      map.setView(canadaCenter, 4);
      renderMap();
    }

    controls.locationButton.addEventListener("click", () => {
      if (!navigator.geolocation) {
        controls.locationStatus.textContent = "Location unavailable";
        return;
      }

      controls.locationStatus.textContent = "Locating...";
      navigator.geolocation.getCurrentPosition(
        (position) => {
          userLocation = {
            lat: position.coords.latitude,
            lng: position.coords.longitude
          };
          renderMap();
        },
        () => {
          controls.locationStatus.textContent = "Location unavailable";
        },
        { enableHighAccuracy: false, timeout: 8000, maximumAge: 300000 }
      );
    });

    controls.resetButton.addEventListener("click", reset);
    controls.filterToggle.addEventListener("click", () => {
      const isOpen = controls.filterToggle.getAttribute("aria-expanded") === "true";
      controls.filterToggle.setAttribute("aria-expanded", String(!isOpen));
      controls.filterToggle.textContent = isOpen ? "Filters" : "Hide filters";
      controls.advancedFilters.hidden = isOpen;
      window.dispatchEvent(new Event("resize"));
    });

    [controls.query, controls.category, controls.province, controls.city, controls.radius]
      .forEach((control) => control.addEventListener("input", renderMap));

    renderMap();
  })();
</script>
