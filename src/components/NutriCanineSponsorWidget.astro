---

<div class="nutricanine-overlay-backdrop" data-nutricanine-backdrop hidden></div>
<section id="nutricanine-sponsor" class="nutricanine-widget" aria-labelledby="nutricanine-widget-title" data-nutricanine-widget>
  <button
    type="button"
    class="nutricanine-expand"
    data-nutricanine-expand
    aria-label="Expand NutriCanine sponsor widget"
    aria-expanded="false"
  >
    ⛶
  </button>
  <button type="button" class="nutricanine-close" data-nutricanine-close aria-label="Close NutriCanine sponsor widget">
    ×
  </button>

  <div class="nutricanine-brand">
    <a href={sponsorUrl} target="_blank" rel="noopener sponsored" aria-label="Open NutriCanine in a new tab">
      <img src="/images/sponsors/nutricanine/nutricanine-logo.png" alt="NutriCanine" loading="lazy" />
    </a>
    <p id="nutricanine-widget-title">Real Food, Always Fresh, Never Processed</p>
  </div>

  <div class="nutricanine-carousel" aria-live="polite">
    {recipes.map((recipe, index) => (
      <article class:list={["nutricanine-slide", index === 0 && "is-active"]} data-nutricanine-slide>
        <img class="nutricanine-recipe-image" src={recipe.image} alt={`${recipe.name} by NutriCanine`} loading="lazy" />
        <div class="nutricanine-recipe-body">
          <div class="nutricanine-recipe-heading">
            <span>{recipe.tag}</span>
            <h3>{recipe.name}</h3>
          </div>
          <ul class="nutricanine-icon-list" aria-label={`${recipe.name} featured ingredients`}>
            {recipe.icons.map((icon) => <li>{icon}</li>)}
          </ul>

          <details open={index === 0}>
            <summary>Description</summary>
            <p>{recipe.description}</p>
          </details>
          <details>
            <summary>Full Ingredients</summary>
            <ul class="nutricanine-ingredients">
              {recipe.ingredients.map((ingredient) => <li>{ingredient}</li>)}
            </ul>
          </details>
          <details>
            <summary>Nutritional Info</summary>
            <table>
              <caption>Guaranteed Analysis</caption>
              <thead>
                <tr>
                  <th scope="col"></th>
                  <th scope="col">As Fed</th>
                  <th scope="col">Dry Matter</th>
                </tr>
              </thead>
              <tbody>
                {recipe.nutrition.map(([label, asFed, dryMatter]) => (
                  <tr>
                    <th scope="row">{label}</th>
                    <td>{asFed}</td>
                    <td>{dryMatter || "-"}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </details>
        </div>
      </article>
    ))}
  </div>

  <div class="nutricanine-controls" aria-label="NutriCanine recipe carousel controls">
    <button type="button" class="nutricanine-arrow" data-nutricanine-prev aria-label="Previous recipe">‹</button>
    <span data-nutricanine-status>1 / {recipes.length}</span>
    <button type="button" class="nutricanine-arrow" data-nutricanine-next aria-label="Next recipe">›</button>
  </div>

  <a class="nutricanine-cta" href={sponsorUrl} target="_blank" rel="noopener sponsored">Get Started</a>
</section>

<script>
  document.querySelectorAll("[data-nutricanine-widget]").forEach((widget) => {
    const backdrop = widget.previousElementSibling;
    const slides = Array.from(widget.querySelectorAll("[data-nutricanine-slide]"));
    const previous = widget.querySelector("[data-nutricanine-prev]");
    const next = widget.querySelector("[data-nutricanine-next]");
    const status = widget.querySelector("[data-nutricanine-status]");
    const expand = widget.querySelector("[data-nutricanine-expand]");
    const close = widget.querySelector("[data-nutricanine-close]");
    let activeIndex = 0;

    const showSlide = (index) => {
      activeIndex = (index + slides.length) % slides.length;
      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle("is-active", slideIndex === activeIndex);
        if (slideIndex !== activeIndex) {
          slide.querySelectorAll("details").forEach((details) => {
            details.open = false;
          });
        }
      });
      status.textContent = `${activeIndex + 1} / ${slides.length}`;
    };

    const closeOverlay = () => {
      widget.classList.remove("is-expanded");
      document.body.classList.remove("nutricanine-modal-open");
      expand?.setAttribute("aria-expanded", "false");
      backdrop?.setAttribute("hidden", "");
    };

    const openOverlay = () => {
      widget.classList.add("is-expanded");
      document.body.classList.add("nutricanine-modal-open");
      expand?.setAttribute("aria-expanded", "true");
      backdrop?.removeAttribute("hidden");
      close?.focus();
    };

    window.openNutriCanineSponsor = openOverlay;

    previous?.addEventListener("click", () => showSlide(activeIndex - 1));
    next?.addEventListener("click", () => showSlide(activeIndex + 1));
    expand?.addEventListener("click", openOverlay);
    close?.addEventListener("click", closeOverlay);
    backdrop?.addEventListener("click", closeOverlay);
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      const trigger = event.target.closest("[data-nutricanine-open]");
      if (trigger) {
        event.preventDefault();
        openOverlay();
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && widget.classList.contains("is-expanded")) {
        closeOverlay();
      }
    });
  });
</script>
