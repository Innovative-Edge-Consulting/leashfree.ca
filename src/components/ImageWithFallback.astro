---
import OptimizedImage from "./OptimizedImage.astro";
import { PLACEHOLDER } from "../utils/media.js";

interface Props {
  src?: string;
  alt?: string;
  variant?: "hero" | "card";
  loading?: "lazy" | "eager";
  fetchPriority?: "high" | "low" | "auto";
  width?: number;
  height?: number;
  sizes?: string;
  srcset?: string;
  sourceSets?: {
    type: string;
    srcset: string;
  }[];
  imagePosition?: string;
  imageFit?: "cover" | "contain";
}

const {
  src,
  alt = "",
  variant = "card",
  loading = "lazy",
  fetchPriority,
  width,
  height,
  sizes,
  srcset,
  sourceSets = [],
  imagePosition,
  imageFit = "cover"
} = Astro.props;
const finalSrc = src || PLACEHOLDER;
const className = variant === "hero" ? "media hero-media" : "media card-media";
const style = `${imagePosition ? `object-position: ${imagePosition};` : ""}${imageFit ? `object-fit: ${imageFit};` : ""}`;
---

<OptimizedImage
  class={className}
  style={style}
  src={finalSrc}
  srcset={srcset}
  sizes={sizes}
  sourceSets={sourceSets}
  width={width}
  height={height}
  alt={alt}
  loading={loading}
  fetchPriority={fetchPriority}
  decoding="async"
/>
