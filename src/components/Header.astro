---
const links = [
  { href: "/dog-parks/", label: "Dog Parks" },
  { href: "/dog-breeds/", label: "Dog Breeds" },
  { href: "/blog/", label: "Blog" },
  { href: "/directory/", label: "Directory" }
];

const resourceLinks = [
  {
    title: "Tools",
    links: [
      { href: "/resources/", label: "All Resources" },
      { href: "/resources/dog-breed-match-quiz/", label: "Dog Breed Match Quiz" },
      { href: "/resources/dog-calorie-calculator/", label: "Dog Calorie Calculator" },
      { href: "/resources/dog-cost-calculator-canada/", label: "Dog Cost Calculator" },
      { href: "/dog-food-comparison-canada/", label: "Dog Food Comparison" },
      { href: "/resources/dog-gear-finder/", label: "Dog Gear Finder" }
    ]
  },
  {
    title: "Explore",
    links: [
      { href: "/dog-names/", label: "Dog Names" },
      { href: "/dog-name-finder/", label: "Dog Name Finder" },
      { href: "/blog/", label: "Dog Care Guides" },
      { href: "/directory/", label: "Dog Services Directory" }
    ]
  },
  {
    title: "Games",
    links: [
      { href: "/games/", label: "All Dog Games" },
      { href: "/games/dog-breed-guessing-game/", label: "Dog Breed Guessing Game" }
    ]
  }
];
---

<header class="site-header">
  <div class="container nav">
    <a class="brand" href="/" aria-label="LeashFree.ca home">
      <img class="brand-logo" src="/images/general/leashfree-logo.png" alt="" width="42" height="42" />
      <span>LeashFree.ca</span>
    </a>
    <nav class="nav-links" aria-label="Main navigation">
      {links.slice(0, 2).map((link) => <a href={link.href}>{link.label}</a>)}
      <details class="nav-dropdown">
        <summary>Resources</summary>
        <div class="nav-dropdown-panel">
          {resourceLinks.map((group) => (
            <div class="nav-dropdown-group">
              <p>{group.title}</p>
              {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
            </div>
          ))}
        </div>
      </details>
      {links.slice(2).map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <details class="mobile-nav">
      <summary>Menu</summary>
      <nav class="mobile-nav-panel" aria-label="Mobile navigation">
        {links.slice(0, 2).map((link) => <a href={link.href}>{link.label}</a>)}
        <details class="mobile-nav-group">
          <summary>Resources</summary>
          <div class="mobile-nav-submenu">
            {resourceLinks.map((group) => (
              <div class="mobile-nav-resource-group">
                <p>{group.title}</p>
                {group.links.map((link) => <a href={link.href}>{link.label}</a>)}
              </div>
            ))}
          </div>
        </details>
        {links.slice(2).map((link) => <a href={link.href}>{link.label}</a>)}
      </nav>
    </details>
  </div>
</header>
