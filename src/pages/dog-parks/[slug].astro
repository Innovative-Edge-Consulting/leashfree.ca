    rulesCopy: "Alberta municipalities manage off-leash rules locally. Confirm posted leash boundaries, seasonal trail restrictions, dog licensing requirements, and wildlife notices before entering.",
    terrainCopy: "Snow, ice, mud, dry summer heat, and exposed wind can change a visit quickly. Bring waste bags, water, a leash for transitions, and towels for the ride home.",
    terrainBadges: ["Water", "Towels", "Leash"]
  },
  bc: {
    shortName: "British Columbia",
    shortLabel: "BC",
    heroImage: "/images/dog-parks/british-columbia-dog-parks-hero.jpg",
    seoTitle: "British Columbia Dog Parks: Map, City Guides, and Off-Leash Areas",
    description: (count) => `Explore ${count} British Columbia dog park records with an interactive map, city guides, fenced park picks, water availability, parking details, and visit planning tips.`,
    terrainIntro: "British Columbia dog parks range from compact fenced neighbourhood areas to larger coastal, forest, and lake-adjacent spaces. Use these checks before you go.",
    rulesCopy: "BC municipalities manage off-leash rules locally. Confirm posted leash boundaries, seasonal beach restrictions, dog licensing requirements, and wildlife notices before entering.",
