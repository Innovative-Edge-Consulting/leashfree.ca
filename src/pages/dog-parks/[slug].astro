---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSenseDisplay from "../../components/AdSenseDisplay.astro";
import Card from "../../components/Card.astro";
import ContentBlock from "../../components/ContentBlock.astro";
import DogParkSearch from "../../components/DogParkSearch.astro";
import EmptyState from "../../components/EmptyState.astro";
import ImageWithFallback from "../../components/ImageWithFallback.astro";
import Layout from "../../components/Layout.astro";
import MapPanel from "../../components/MapPanel.astro";
import RockyMountainDogSponsorWidget from "../../components/RockyMountainDogSponsorWidget.astro";
import Section from "../../components/Section.astro";
import mediaMap from "../../data/media-map.json";
import cities from "../../data/generated/cities.json";
import parks from "../../data/generated/parks.json";
import provinces from "../../data/generated/provinces.json";
import { absoluteUrl, breadcrumbSchema, cleanText, excerpt, findByName, slugify } from "../../utils/content.js";
import { resolveMedia } from "../../utils/media.js";
import { isRedirectSourceRoute, withoutRedirectedRecords } from "../../utils/redirects.js";

export function getStaticPaths() {
  const activePathParks = withoutRedirectedRecords(parks);
  const grouped = new Map();
  for (const item of [...activePathParks, ...cities, ...provinces]) {
    if (!item.slug) continue;
    if (isRedirectSourceRoute(item.routePath || `/dog-parks/${item.slug}/`)) continue;
    if (!grouped.has(item.slug)) grouped.set(item.slug, []);
    grouped.get(item.slug).push(item);
  }

  return [...grouped.entries()].map(([slug, matches]) => ({
    params: { slug },
    props: { matches }
  }));
}

const { matches } = Astro.props;
const primary = matches[0];
const activeParks = withoutRedirectedRecords(parks);
const pageType = primary.collection;
const isPark = pageType === "Dog Parks";
const isCity = pageType === "City Pages";
const isProvince = pageType === "Provinces";
const enhancedProvinceConfig = {
