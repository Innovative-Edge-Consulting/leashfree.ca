        key: "fenced",
        title: `Fenced dog parks in ${primaryName}`,
        intro: `${cityIntentCounts?.fenced || 0} fenced off-leash parks in ${primaryName}. These are useful for dogs that need a more enclosed play space and for owners building recall consistency.`,
        parks: cityParks.filter((park) => isAffirmative(park.raw.Fenced)).slice(0, 12)
      },
      {
        key: "small-dog-area",
        title: `Small dog area parks in ${primaryName}`,
        intro: `${cityIntentCounts?.smallDog || 0} parks with separate small dog areas in ${primaryName}. Prioritize these locations if your dog is more comfortable in lower-intensity play zones.`,
        parks: cityParks.filter((park) => isAffirmative(park.raw["Separate Small Dog Area"])).slice(0, 12)
      },
      {
        key: "parking",
        title: `Dog parks with parking in ${primaryName}`,
        intro: `${cityIntentCounts?.parking || 0} parks that indicate nearby or on-site parking. This helps compare quick-access options for weekday visits and longer weekend trips.`,
        parks: cityParks.filter((park) => isAffirmative(park.raw["Parking Available"])).slice(0, 12)
      },
      {
        key: "water",
        title: `Dog parks with water in ${primaryName}`,
        intro: `${cityIntentCounts?.water || 0} parks that indicate a water source is available. Use this list when planning warm-weather outings or longer off-leash sessions.`,
        parks: cityParks.filter((park) => isAffirmative(park.raw["Water source available"])).slice(0, 12)
      }
    ].filter((group) => group.parks.length > 0)
  : [];
const provinceCities = isProvince
  ? cities.filter((cityItem) => matchesProvinceRecord(cityItem.raw.Province, primary)).slice(0, 120)
  : [];
const provinceParks = isProvince
  ? activeParks.filter((park) => matchesProvinceRecord(park.raw.Province, primary)).slice(0, 120)
  : [];
const allProvinceParks = isProvince
  ? activeParks.filter((park) => matchesProvinceRecord(park.raw.Province, primary))
  : [];
const provinceParkCities = isProvince
  ? [...new Set(allProvinceParks.map((park) => park.raw.City).filter(Boolean))].sort()
  : [];
const provinceStats = isProvince
  ? {
      parks: allProvinceParks.length,
      cityGuides: provinceCities.length,
      citiesWithParks: provinceParkCities.length,
      fenced: allProvinceParks.filter((park) => isAffirmative(park.raw.Fenced)).length,
      smallDog: allProvinceParks.filter((park) => isAffirmative(park.raw["Separate Small Dog Area"])).length,
      water: allProvinceParks.filter((park) => isAffirmative(park.raw["Water source available"])).length,
      parking: allProvinceParks.filter((park) => isAffirmative(park.raw["Parking Available"])).length
    }
  : null;
const provinceCityHighlights = isProvince
  ? provinceCities
      .map((cityItem) => {
        const parksForCity = allProvinceParks.filter((park) => slugify(park.raw.City) === slugify(cityItem.name));
        return {
          city: cityItem,
          count: parksForCity.length,
          fenced: parksForCity.filter((park) => isAffirmative(park.raw.Fenced)).length,
          water: parksForCity.filter((park) => isAffirmative(park.raw["Water source available"])).length,
          parking: parksForCity.filter((park) => isAffirmative(park.raw["Parking Available"])).length
        };
      })
      .filter((entry) => entry.count > 0)
      .sort((a, b) => b.count - a.count || a.city.name.localeCompare(b.city.name))
      .slice(0, 8)
  : [];
const provinceFeatureGroups = isProvince
  ? [
      {
        title: `Fenced dog parks in ${primary.name}`,
        intro: `${provinceStats?.fenced || 0} listed parks indicate fenced off-leash space.`,
        parks: allProvinceParks.filter((park) => isAffirmative(park.raw.Fenced)).slice(0, 8)
      },
      {
        title: `Dog parks with water in ${primary.name}`,
        intro: `${provinceStats?.water || 0} listed parks indicate an available water source.`,
        parks: allProvinceParks.filter((park) => isAffirmative(park.raw["Water source available"])).slice(0, 8)
      },
      {
        title: `Dog parks with parking in ${primary.name}`,
        intro: `${provinceStats?.parking || 0} listed parks indicate parking nearby or on site.`,
        parks: allProvinceParks.filter((park) => isAffirmative(park.raw["Parking Available"])).slice(0, 8)
      }
    ].filter((group) => group.parks.length > 0)
  : [];
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Dog Parks", href: "/dog-parks/" },
  city && isPark ? { label: city.name, href: `/dog-parks/${city.slug}/` } : null,
  { label: primaryName }
].filter(Boolean);
const amenityDefs = [
  { label: "Fenced area", icon: "fence", field: "Fenced" },
  { label: "Small dog area", icon: "paw", field: "Separate Small Dog Area" },
  { label: "Surface", icon: "surface", field: "Surface type" },
  { label: "Size", icon: "size", field: "Size" },
  { label: "Water", icon: "water", field: "Water source available" },
  { label: "Benches", icon: "bench", field: "Benches" },
  { label: "Shade", icon: "shade", field: "Shaded area" },
  { label: "Waste bins", icon: "waste", field: "Waste bins" },
  { label: "Bag dispensers", icon: "bag", field: "Bag Dispensers" },
  { label: "Parking", icon: "parking", field: "Parking Available" },
  { label: "Washrooms", icon: "washroom", field: "Washrooms nearby" }
];
const seoAmenityLabels = amenityDefs
  .filter((item) => primary.raw[item.field] && ["Fenced area", "Washrooms", "Parking", "Small dog area"].includes(item.label))
  .map((item) => item.label.toLowerCase())
  .slice(0, 2);
const fallbackTitle = isPark && city && province
  ? `${primaryName} Off-Leash Dog Park in ${cityName}, ${provinceName} | LeashFree.ca`
  : cleanText(primary.title || primary.name);
const title = enhancedProvince
  ? enhancedProvince.seoTitle
  : cleanText(primary.seoTitle) || fallbackTitle;
const fallbackDescription = isPark
  ? `${primaryName} dog park profile${cityName ? ` in ${cityName}` : ""}${provinceName ? `, ${provinceName}` : ""}. ${seoAmenityLabels.length > 0 ? `Highlights: ${seoAmenityLabels.join(", ")}. ` : ""}Check map, rules, and visit details.`
  : isCity
  ? `${primaryName} dog park guide with ${cityParks.length} off-leash park listings, including fenced parks, small dog areas, parking, and water availability. Compare parks and plan your visit.`
  : enhancedProvince
  ? enhancedProvince.description(provinceStats?.parks || 0)
  : `${primaryName} on LeashFree.ca.`;
const description = cleanText(primary.metaDescription) || fallbackDescription;
const locationLinks = [
  city ? { href: `/dog-parks/${city.slug}/`, label: `Dog parks in ${city.name}` } : null,
  province ? { href: `/dog-parks/${province.slug}/`, label: `Dog parks in ${province.name}` } : null
].filter(Boolean);
const parkRulesText = primary.raw["Park Rules"] ? cleanText(primary.raw["Park Rules"]) : "";
const parkFaqField =
  primary.raw["Dog Park FAQs"] ||
  primary.raw["FAQs"] ||
  primary.raw["FAQ"] ||
  primary.raw["FAQ (Group)"] ||
  "";
const cityFaqField = city
  ? city.raw["Dog Park FAQs"] || city.raw["FAQs"] || city.raw["FAQ"] || city.raw["FAQ (Group)"] || ""
  : "";
const parkFaqEntries = isPark
  ? (() => {
      const parkEntries = parseFaqHtml(parkFaqField);
      if (parkEntries.length > 0) return parkEntries;
      return parseFaqHtml(cityFaqField);
    })()
  : [];
const parkFaqEntities = [
  ...parkFaqEntries.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer
    }
  })),
  ...(
    parkRulesText
      ? [
          {
            "@type": "Question",
            name: `What are the rules at ${primaryName}?`,
            acceptedAnswer: {
              "@type": "Answer",
              text: parkRulesText
            }
          }
        ]
      : []
  )
];
const mapLink = primary.raw["Google Maps Link"] || (primary.raw.latitude && primary.raw.longitude
  ? `https://www.google.com/maps?q=${primary.raw.latitude},${primary.raw.longitude}`
  : "");
const atAGlanceItems = isPark
  ? [
      { label: "Fenced", value: fieldText("Fenced") || "Not listed" },
      { label: "Small dog area", value: fieldText("Separate Small Dog Area") || "Not listed" },
      { label: "Parking", value: fieldText("Parking Available") || "Not listed" },
      { label: "Water", value: fieldText("Water source available") || "Not listed" },
      { label: "Hours", value: fieldText("Operating hours") || "Check posted signs" },
      { label: "Surface", value: fieldText("Surface type") || "Not listed" }
    ]
  : [];
const amenityIcons = {
  fence: "M4 6h16M4 12h16M4 18h16M8 4v16M16 4v16",
  paw: "M8 12a2 2 0 1 0 0-4a2 2 0 0 0 0 4Zm8 0a2 2 0 1 0 0-4a2 2 0 0 0 0 4Zm-4 8c2.8 0 5-1.4 5-3.3S14.8 13 12 13s-5 1.8-5 3.7S9.2 20 12 20ZM6 8a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3Zm12 0a1.5 1.5 0 1 0 0-3a1.5 1.5 0 0 0 0 3Z",
  surface: "M3 8l9-5l9 5l-9 5l-9-5Zm0 8l9 5l9-5M3 12l9 5l9-5",
  size: "M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7",
  water: "M12 3c3 4 6 7 6 11a6 6 0 1 1-12 0c0-4 3-7 6-11Z",
  bench: "M4 14h16M5 10h14M6 14v4M18 14v4",
  shade: "M12 4v2M12 18v2M4 12h2M18 12h2M6.5 6.5l1.4 1.4M16.1 16.1l1.4 1.4M17.5 6.5l-1.4 1.4M7.9 16.1l-1.4 1.4M12 16a4 4 0 1 0 0-8a4 4 0 0 0 0 8Z",
  waste: "M4 7h16M9 7V5h6v2M8 7l1 12h6l1-12",
  bag: "M7 8h10l-1 12H8L7 8Zm3 0V6a2 2 0 1 1 4 0v2",
  parking: "M5 4h14v16H5zM9 17V7h4a3 3 0 1 1 0 6H9",
  washroom: "M8 4a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3Zm8 0a1.5 1.5 0 1 1 0 3a1.5 1.5 0 0 1 0-3ZM7 10h2v4l-1 6M15 10h2v10M13 12h6"
};
const amenityGroups = [
  {
    title: "Park setup",
    items: amenityDefs
      .filter((item) => ["Fenced", "Separate Small Dog Area", "Surface type", "Size"].includes(item.field))
      .map((item) => ({ icon: item.icon, label: item.label, value: primary.raw[item.field] }))
      .filter((item) => item.value)
  },
  {
    title: "Facilities",
    items: amenityDefs
      .filter((item) => ["Water source available", "Benches", "Shaded area", "Waste bins", "Bag Dispensers", "Parking Available", "Washrooms nearby"].includes(item.field))
      .map((item) => ({ icon: item.icon, label: item.label, value: primary.raw[item.field] }))
      .filter((item) => item.value)
  }
].filter((group) => group.items.length > 0);
const bestForParts = [
  isAffirmative(primary.raw.Fenced) ? "dog owners who prefer fenced off-leash spaces" : "",
  isAffirmative(primary.raw["Separate Small Dog Area"]) ? "small dogs that benefit from a separate area" : "",
  isAffirmative(primary.raw["Parking Available"]) ? "visitors who need nearby parking" : "",
  isAffirmative(primary.raw["Washrooms nearby"]) ? "longer visits with nearby washrooms" : ""
].filter(Boolean);
const bestFor = bestForParts.length > 0
  ? `This park is best for ${bestForParts.join(", ")}.`
  : "This park supports general off-leash visits; check posted guidance before entering.";
const visitTips = [
  primary.raw["Operating hours"] ? `Operating hours: ${primary.raw["Operating hours"]}.` : "",
  primary.raw["Seasonal Restrictions"] ? cleanText(primary.raw["Seasonal Restrictions"]) : "",
  parkRulesText ? `Park rules: ${parkRulesText}` : "Check posted signage for temporary restrictions and leash requirements."
].filter(Boolean).join(" ");
const whatToBring = [
  "waste bags",
  isAffirmative(primary.raw["Water source available"]) ? "" : "water for your dog",
  "a leash for entering and exiting",
  isAffirmative(primary.raw["Shaded area"]) ? "" : "sun protection in warmer weather"
].filter(Boolean).join(", ");
const parkIntentLinks = isPark && city
  ? [
      isAffirmative(primary.raw.Fenced)
        ? { href: `/dog-parks/${city.slug}/#fenced`, label: `More fenced parks in ${city.name}` }
        : null,
      isAffirmative(primary.raw["Separate Small Dog Area"])
        ? { href: `/dog-parks/${city.slug}/#small-dog-area`, label: `More small dog area parks in ${city.name}` }
        : null,
      isAffirmative(primary.raw["Parking Available"])
        ? { href: `/dog-parks/${city.slug}/#parking`, label: `More parks with parking in ${city.name}` }
        : null,
      isAffirmative(primary.raw["Water source available"])
        ? { href: `/dog-parks/${city.slug}/#water`, label: `More parks with water in ${city.name}` }
        : null
    ].filter(Boolean)
  : [];
const sharedAmenityFields = amenityDefs
  .map((item) => item.field)
  .filter((field) => primary.raw[field]);
const primaryLat = Number.parseFloat(String(primary.raw.latitude ?? ""));
const primaryLng = Number.parseFloat(String(primary.raw.longitude ?? ""));
const hasPrimaryCoords = Number.isFinite(primaryLat) && Number.isFinite(primaryLng);
const toRadians = (value) => (value * Math.PI) / 180;
const distanceKm = (lat1, lng1, lat2, lng2) => {
  const earthRadiusKm = 6371;
  const dLat = toRadians(lat2 - lat1);
  const dLng = toRadians(lng2 - lng1);
  const a =
    Math.sin(dLat / 2) * Math.sin(dLat / 2) +
    Math.cos(toRadians(lat1)) * Math.cos(toRadians(lat2)) * Math.sin(dLng / 2) * Math.sin(dLng / 2);
  const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  return earthRadiusKm * c;
};
const nearbyParks = isPark && hasPrimaryCoords
  ? activeParks
