    shortLabel: "ON",
    seoTitle: "Ontario Dog Parks: Map, City Guides, and Off-Leash Areas",
    description: (count) => `Explore ${count} Ontario dog park records with an interactive map, city guides, fenced park picks, water availability, parking details, and visit planning tips.`,
    terrainIntro: "Ontario dog parks range from fenced neighbourhood runs to waterfront, ravine, woodland, and community park spaces. Use these checks before you go.",
    rulesCopy: "Ontario municipalities manage off-leash rules locally. Confirm posted leash boundaries, seasonal trail or beach restrictions, dog licensing requirements, and park-specific notices before entering.",
    terrainCopy: "Snow, ice, spring mud, summer heat, ticks, and busy waterfront paths can change a visit quickly. Bring waste bags, water, a leash for transitions, and towels for the ride home.",
    terrainBadges: ["Water", "Towels", "Leash"]
  },
  qc: {
    shortName: "Quebec",
    shortLabel: "QC",
    heroImage: "/images/dog-parks/quebec-dog-parks-hero.jpg",
    seoTitle: "Quebec Dog Parks: Map, City Guides, and Off-Leash Areas",
    description: (count) => `Explore ${count} Quebec dog park records with an interactive map, city guides, fenced park picks, water availability, parking details, and visit planning tips.`,
    terrainIntro: "Quebec dog parks range from fenced neighbourhood enclosures to riverside, lakeside, mountain-adjacent, and urban community park spaces. Use these checks before you go.",
    rulesCopy: "Quebec municipalities manage dog park and off-leash rules locally. Confirm posted leash boundaries, seasonal park restrictions, licensing requirements, and any borough-specific notices before entering.",
    terrainCopy: "Snow, ice, spring mud, summer heat, ticks, and busy waterfront paths can change a visit quickly. Bring waste bags, water, a leash for transitions, and towels for the ride home.",
    terrainBadges: ["Water", "Towels", "Leash"]
  }
};
const enhancedProvince = isProvince ? enhancedProvinceConfig[primary.slug] : null;
const resolvedImage = resolveMedia(primary, undefined, mediaMap);
const image = enhancedProvince
  ? { ...resolvedImage, ...(enhancedProvince.heroImage ? { src: enhancedProvince.heroImage } : {}) }
  : resolvedImage;
const city = isPark ? findByName(cities, primary.raw.City) : null;
const province = isPark || isCity ? findByName(provinces, primary.raw.Province) : primary;
const sourceUrl = primary.raw["Park Website or Source"] || "";
const parseDateValue = (value) => {
  if (!value || typeof value !== "string") return null;
  const parsed = new Date(value);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
};
const toIsoDate = (date) => (date ? date.toISOString() : undefined);
const formatDisplayDate = (date) => (date
  ? new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "short", day: "numeric" }).format(date)
  : "");
const updatedAt = parseDateValue(primary.raw["Updated On"]);
const publishedAt = parseDateValue(primary.raw["Published On"]) || parseDateValue(primary.raw["Created On"]);
const updatedIso = toIsoDate(updatedAt);
const publishedIso = toIsoDate(publishedAt);
const normalizeText = (value) => cleanText(value);
const siteUrl = Astro.site || "https://leashfree.ca";
const pageUrl = absoluteUrl(primary.canonicalUrl || `/dog-parks/${primary.slug}/`, siteUrl);
const parkUrl = (park) => absoluteUrl(`/dog-parks/${park.slug}/`, siteUrl);
const primaryName = cleanText(primary.name);
const cityName = cleanText(city?.name || primary.raw.City);
const provinceName = cleanText(province?.name || primary.raw.Province);
const fieldText = (field) => cleanText(primary.raw[field]);
const notesText = normalizeText(primary.raw["Notes / Comments"]);
const parseFaqHtml = (html) => {
  if (!html || typeof html !== "string") return [];
  const items = [];
  const strongPattern = /<strong[^>]*>([\s\S]*?)<\/strong>/gi;
  const matches = [...html.matchAll(strongPattern)];
  if (matches.length === 0) return items;

  for (let index = 0; index < matches.length; index += 1) {
    const current = matches[index];
    const next = matches[index + 1];
    const questionRaw = normalizeText(current[1]).replace(/^\d+\.\s*/, "");
    if (!questionRaw) continue;
    const answerStart = (current.index || 0) + current[0].length;
    const answerEnd = next?.index ?? html.length;
    const answerRaw = normalizeText(html.slice(answerStart, answerEnd));
    if (!answerRaw) continue;
    items.push({ question: questionRaw, answer: answerRaw });
  }
  return items;
};
const freshnessText = updatedAt
  ? `Last updated ${formatDisplayDate(updatedAt)}`
  : publishedAt
  ? `Published ${formatDisplayDate(publishedAt)}`
  : "";
const isAffirmative = (value) => {
  if (typeof value === "boolean") return value;
  if (typeof value !== "string") return false;
  const normalized = value.trim().toLowerCase();
  return ["yes", "true", "y", "available", "open"].includes(normalized);
};
const matchesProvinceRecord = (value, provinceItem) =>
  slugify(value) === slugify(provinceItem.name) || slugify(value) === slugify(provinceItem.slug);
