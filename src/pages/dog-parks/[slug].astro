      .map((park) => {
        const lat = Number.parseFloat(String(park.raw.latitude ?? ""));
        const lng = Number.parseFloat(String(park.raw.longitude ?? ""));
        if (!Number.isFinite(lat) || !Number.isFinite(lng)) return null;
        return {
          park,
          distance: distanceKm(primaryLat, primaryLng, lat, lng)
        };
      })
      .filter(Boolean)
      .sort((a, b) => a.distance - b.distance)
      .slice(0, 6)
  : [];
const relatedParks = isPark
  ? activeParks
      .filter((park) => park.slug !== primary.slug && slugify(park.raw.City) === slugify(primary.raw.City))
      .map((park) => ({
        park,
        score: sharedAmenityFields.filter((field) => Boolean(park.raw[field])).length
      }))
      .filter((entry) => entry.score > 0)
      .sort((a, b) => b.score - a.score)
      .slice(0, 6)
  : [];
const parkFeatureBadges = (park, { includeCity = false, includeDistance } = {}) => [
  includeDistance ? `${includeDistance.toFixed(1)} km away` : "",
  includeCity ? cleanText(park.raw.City) : "",
  park.raw.Fenced ? `Fenced: ${cleanText(park.raw.Fenced)}` : "",
  park.raw["Separate Small Dog Area"] ? `Small dogs: ${cleanText(park.raw["Separate Small Dog Area"])}` : "",
  park.raw["Water source available"] ? `Water: ${cleanText(park.raw["Water source available"])}` : "",
  park.raw["Parking Available"] ? `Parking: ${cleanText(park.raw["Parking Available"])}` : ""
].filter(Boolean).slice(0, 4);
const structuredData = [
  breadcrumbSchema(breadcrumbs),
  isPark && primary.raw.latitude && primary.raw.longitude
    ? {
        "@context": "https://schema.org",
        "@type": "Park",
        name: primaryName,
        description: cleanText(description),
        address: {
          "@type": "PostalAddress",
          streetAddress: fieldText("Street Address") || undefined,
          addressLocality: cityName || undefined,
          addressRegion: provinceName || undefined,
          postalCode: fieldText("Postal Code") || undefined,
          addressCountry: "CA"
        },
        hasMap: mapLink || undefined,
        sameAs: sourceUrl || undefined,
        dateModified: updatedIso,
        datePublished: publishedIso,
        amenityFeature: amenityDefs
          .filter((item) => isAffirmative(primary.raw[item.field]))
          .map((item) => ({
            "@type": "LocationFeatureSpecification",
            name: item.label,
            value: true
          })),
        geo: {
          "@type": "GeoCoordinates",
          latitude: primary.raw.latitude,
          longitude: primary.raw.longitude
        },
        url: pageUrl
      }
    : null,
  isPark && parkFaqEntities.length > 0
    ? {
        "@context": "https://schema.org",
          "@type": "FAQPage",
          dateModified: updatedIso,
          datePublished: publishedIso,
          mainEntity: parkFaqEntities
      }
    : null,
  ...(
    isCity
      ? cityFilteredGroups.map((group) => ({
          "@context": "https://schema.org",
          "@type": "ItemList",
          name: group.title,
          url: `${primary.canonicalUrl}#${group.key}`,
          numberOfItems: group.parks.length,
          dateModified: updatedIso,
          datePublished: publishedIso,
          itemListElement: group.parks.map((park, index) => ({
            "@type": "ListItem",
            position: index + 1,
            url: parkUrl(park),
            name: cleanText(park.name)
          }))
        }))
      : []
  )
].filter(Boolean);
---

<Layout title={title} description={excerpt(description)} canonical={primary.canonicalUrl} ogImage={image.src} ogType={isPark ? "place" : "website"} structuredData={structuredData}>
  <section class="page-header">
    <div class="container detail-layout">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="eyebrow">{isPark ? "Dog park" : isCity ? "City guide" : "Province guide"}</div>
        <h1>{enhancedProvince ? `${enhancedProvince.shortName} dog parks` : isCity ? `${primaryName} dog parks` : cleanText(primary.title || primary.name)}</h1>
        <p class="summary">{excerpt(description)}</p>
        {freshnessText && <p class="summary">{freshnessText}</p>}
        <div class="button-row">
          {isPark ? (
            <a class="button primary" href="#park-map">Map and directions</a>
          ) : (
            <a class="button primary" href={enhancedProvince ? `#${primary.slug}-dog-park-map` : "/dog-parks/"}>
              {enhancedProvince ? `Open ${enhancedProvince.shortLabel} map` : "Back to dog parks"}
            </a>
          )}
          {isPark && <a class="button secondary" href="/dog-parks/">Back to dog parks</a>}
          {enhancedProvince && <a class="button secondary" href={`#${primary.slug}-cities`}>Browse cities</a>}
          {city && <a class="button secondary" href={`/dog-parks/${city.slug}/`}>More in {cityName}</a>}
        </div>
      </div>
      <ImageWithFallback src={image.src} alt={isPark ? `Dog park guide for ${primaryName}` : `${primaryName} dog parks`} variant="hero" loading="eager" />
    </div>
  </section>

  {matches.length > 1 && (
    <Section title="Related records" intro="This page includes more than one matching dog park record." alt tight>
      <ul>
        {matches.map((item) => <li>{item.collection}: {item.name}</li>)}
      </ul>
    </Section>
  )}

  {isPark && (
    <Section title="Park details">
      <div class="split park-details-layout">
        <div class="park-details-main">
          <section class="park-at-a-glance" aria-labelledby="park-at-a-glance-title">
            <h2 id="park-at-a-glance-title">At a glance</h2>
            <dl>
              {atAGlanceItems.map((item) => (
                <div>
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))}
            </dl>
          </section>
          <dl class="meta-list park-meta-list">
            {primary.raw["Street Address"] && (
              <div class="park-meta-item">
                <dt>Address</dt>
                <dd>{fieldText("Street Address")}</dd>
              </div>
            )}
            {primary.raw.City && (
              <div class="park-meta-item">
                <dt>City</dt>
                <dd>{cityName}</dd>
              </div>
            )}
            {primary.raw.Province && (
              <div class="park-meta-item">
                <dt>Province</dt>
                <dd>{provinceName}</dd>
              </div>
            )}
            {primary.raw["Operating hours"] && (
              <div class="park-meta-item">
                <dt>Hours</dt>
                <dd>{fieldText("Operating hours")}</dd>
              </div>
            )}
            {mapLink && (
              <div class="park-meta-item">
                <dt>Map</dt>
                <dd><a class="button secondary park-map-button" href="#park-map">View on map</a></dd>
              </div>
            )}
            {locationLinks.length > 0 && (
              <div class="park-meta-item park-meta-item-links">
                <dt>Location links</dt>
                <dd>
                  <ul class="park-mini-links">
                    {locationLinks.map((link) => (
                      <li><a href={link.href}>{link.label}</a></li>
                    ))}
                  </ul>
                </dd>
              </div>
            )}
          </dl>
          <ContentBlock html={primary.body || primary.description} />
          {parkRulesText && (
            <p class="park-rules-summary"><strong>Park Rules:</strong> {parkRulesText}</p>
          )}
          {notesText && <p>{notesText}</p>}
          {amenityGroups.length > 0 && (
            <section class="card">
              <div class="card-body amenities-card">
                <h2>Amenities</h2>
                {amenityGroups.map((group) => (
                  <section class="amenity-group">
                    <h3>{group.title}</h3>
                    <ul class="amenity-chip-list">
                      {group.items.map((item) => (
                        <li class="amenity-chip">
                          <span class="amenity-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                              <path d={amenityIcons[item.icon]}></path>
                            </svg>
                          </span>
                          <span class="amenity-text"><strong>{item.label}</strong><span>{item.value}</span></span>
                        </li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            </section>
          )}
          <AdSenseDisplay slot="2445869045" className="park-profile-ad" />
        </div>
        <aside class="sidebar">
          <p class="sponsored-label">Sponsored</p>
          <RockyMountainDogSponsorWidget />
        </aside>
      </div>
    </Section>
  )}

  {isPark && (
    <Section tight id="park-map">
      <MapPanel
        title="Map and directions"
        intro={`Use the map to confirm the location for ${primaryName}, then open directions in your device map before you leave.`}
        name={primaryName}
        address={fieldText("Street Address")}
        city={cityName}
        province={provinceName}
        postalCode={primary.raw["Postal Code"]}
        latitude={primary.raw.latitude}
        longitude={primary.raw.longitude}
        googleMapsLink={primary.raw["Google Maps Link"]}
      />
    </Section>
  )}

  {isPark && (
    <Section tight>
      <div class="card park-profile-summary">
        <div class="card-body">
          <h2>Park profile</h2>
          <p><strong>Best for:</strong> {bestFor}</p>
          <p><strong>Visit tips:</strong> {visitTips}</p>
          <p><strong>What to bring:</strong> {whatToBring}.</p>
          {parkIntentLinks.length > 0 && (
            <p>
              <strong>Explore by feature:</strong>{" "}
              {parkIntentLinks.map((link, index) => (
                <>
                  {index > 0 && " - "}
                  <a href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          )}
          {sourceUrl && (
            <p><strong>Official source:</strong> <a href={sourceUrl} target="_blank" rel="noreferrer">Municipal or official park listing</a></p>
          )}
        </div>
      </div>
    </Section>
  )}

  {isPark && relatedParks.length > 0 && (
    <Section title={`Related parks in ${cityName}`} intro="Parks with similar amenities in the same city.">
      <div class="grid">
        {relatedParks.map(({ park }) => (
          <Card
            title={park.name}
            href={`/dog-parks/${park.slug}/`}
            description={excerpt(park.description, park.raw["Street Address"])}
            badges={parkFeatureBadges(park)}
            ctaLabel="View park"
          />
        ))}
      </div>
    </Section>
  )}

  {isPark && parkFaqEntries.length > 0 && (
    <Section title={`FAQs about ${primaryName}`} intro="Common questions and answers for this park.">
      <div class="card">
        <div class="card-body faq-accordion">
          {parkFaqEntries.map((item) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </Section>
  )}

  {isPark && nearbyParks.length > 0 && (
    <Section title="Nearby parks" intro="Closest off-leash parks by map distance.">
      <div class="grid">
        {nearbyParks.map(({ park, distance }) => (
          <Card
            title={park.name}
            href={`/dog-parks/${park.slug}/`}
            description={excerpt(park.description, park.raw["Street Address"])}
            badges={parkFeatureBadges(park, { includeCity: true, includeDistance: distance })}
            ctaLabel="View park"
          />
        ))}
      </div>
    </Section>
  )}

  {isCity && (
    <>
      <Section title="City dog park guidance" alt>
        <ContentBlock html={primary.body || primary.raw["About Section"] || primary.raw["Intro Paragraph"]} />
        {primary.raw["Park Rules"] && <ContentBlock html={primary.raw["Park Rules"]} />}
        {primary.raw["Seasonal Tips"] && <ContentBlock html={primary.raw["Seasonal Tips"]} />}
      </Section>
      <Section
        title={`Map of dog parks in ${primaryName}`}
        intro={`Use the map to compare ${primaryName} parks by location, address, amenities, and distance from your location.`}
      >
        <DogParkSearch initialProvince={provinceName} initialCity={primaryName} />
      </Section>
      <Section title={`Dog parks in ${primaryName}`} intro={`${cityParks.length} park records currently match this city.`}>
        {cityParks.length > 0 ? (
          <div class="grid">
            {cityParks.map((park) => (
              <Card
                title={park.name}
                href={`/dog-parks/${park.slug}/`}
                description={excerpt(park.description, park.raw["Street Address"])}
                badges={parkFeatureBadges(park)}
                ctaLabel="View park"
              />
            ))}
          </div>
        ) : (
          <EmptyState text="No park records currently match this city." />
        )}
      </Section>
      {cityFilteredGroups.map((group) => (
        <Section title={group.title} intro={`${group.parks.length} matching parks.`} alt id={group.key}>
          <div class="grid">
            {group.parks.map((park) => (
              <Card
                title={park.name}
                href={`/dog-parks/${park.slug}/`}
                description={excerpt(park.description, park.raw["Street Address"])}
                badges={[
                  cleanText(park.raw["Street Address"]) || "",
                  park.raw["Operating hours"] ? `Hours: ${cleanText(park.raw["Operating hours"])}` : ""
                ].filter(Boolean)}
                ctaLabel="View park"
              />
            ))}
          </div>
        </Section>
      ))}
    </>
  )}

  {isProvince && (
    <>
      {enhancedProvince && (
        <>
          <Section title={`${enhancedProvince.shortLabel} dog park coverage`} tight>
            <div class="stat-strip">
              <div class="stat"><strong>{provinceStats.parks}</strong><span>{enhancedProvince.shortLabel} park records</span></div>
              <div class="stat"><strong>{provinceStats.cityGuides}</strong><span>city guides</span></div>
              <div class="stat"><strong>{provinceStats.fenced}</strong><span>fenced parks listed</span></div>
              <div class="stat"><strong>{provinceStats.parking}</strong><span>parks with parking</span></div>
            </div>
          </Section>

          <Section
            id={`${primary.slug}-dog-park-map`}
            title={`Search ${enhancedProvince.shortLabel} dog parks on the map`}
            intro={`Use the interactive map to compare ${enhancedProvince.shortName} off-leash areas by city, address, amenities, and distance from your location.`}
            alt
          >
            <DogParkSearch initialProvince={enhancedProvince.shortName} />
          </Section>

          <Section title={`Plan a better ${enhancedProvince.shortLabel} park visit`} intro={enhancedProvince.terrainIntro}>
            <div class="grid compact">
              <Card
                title="Choose the right park type"
                description="For high-energy play, start with fenced parks. For heat or longer outings, compare water availability, shade, and parking before driving across town."
                badges={[`${provinceStats.fenced} fenced`, `${provinceStats.water} with water`]}
                showCta={false}
              />
              <Card
                title="Check local rules"
                description={enhancedProvince.rulesCopy}
                badges={["Local bylaws", "Seasonal rules"]}
                showCta={false}
              />
              <Card
                title="Prepare for terrain"
                description={enhancedProvince.terrainCopy}
                badges={enhancedProvince.terrainBadges}
                showCta={false}
              />
            </div>
          </Section>

          {provinceCityHighlights.length > 0 && (
            <Section
              id={`${primary.slug}-cities`}
              title={`Popular ${enhancedProvince.shortLabel} city guides`}
              intro={`Start with cities that currently have the most matching ${enhancedProvince.shortLabel} park records in the LeashFree directory.`}
              alt
            >
              <div class="grid compact">
                {provinceCityHighlights.map(({ city: cityItem, count, fenced, water, parking }) => (
                  <Card
                    title={`${cityItem.name} dog parks`}
                    href={`/dog-parks/${cityItem.slug}/`}
                    description={`${count} listed park${count === 1 ? "" : "s"} in ${cityItem.name}, including ${fenced} fenced, ${water} with water, and ${parking} with parking where data is available.`}
                    badges={[cityItem.raw.Province].filter(Boolean)}
                    ctaLabel="View city guide"
                  />
                ))}
              </div>
            </Section>
          )}

          {provinceFeatureGroups.map((group) => (
            <Section title={group.title} intro={group.intro}>
              <div class="grid compact">
                {group.parks.map((park) => (
                  <Card
                    title={park.name}
                    href={`/dog-parks/${park.slug}/`}
                    description={excerpt(park.description, park.raw["Street Address"])}
                    meta={[park.raw.City, park.raw["Street Address"]].filter(Boolean).join(" - ")}
                    ctaLabel="View park"
                  />
                ))}
              </div>
            </Section>
          ))}
        </>
      )}

      <Section title={`Cities in ${primary.name}`} intro={`${provinceCities.length} city guides currently match this province.`}>
        <div class="grid">
          {provinceCities.map((cityItem) => (
            <Card
              title={`${cityItem.name} dog parks`}
              href={`/dog-parks/${cityItem.slug}/`}
              description={excerpt(cityItem.description, `${cityItem.name} dog park guide`)}
              ctaLabel="View city"
            />
          ))}
        </div>
      </Section>
      <Section title={`Dog parks in ${primary.name}`} intro={`${provinceParks.length} park records currently match this province.`} alt>
        <div class="grid">
          {provinceParks.map((park) => (
            <Card
              title={park.name}
              href={`/dog-parks/${park.slug}/`}
              description={excerpt(park.description, park.raw["Street Address"])}
              meta={park.raw.City}
              ctaLabel="View park"
            />
          ))}
        </div>
      </Section>
    </>
  )}

  <Section title="Before you visit" tight>
    <div class="card">
      <div class="card-body">
        {isPark ? (
          <>
            <ul class="visit-checklist">
              <li>Confirm current hours, posted leash boundaries, and seasonal restrictions before entering.</li>
              <li>Bring waste bags, water, and a leash for parking lots, paths, entrances, and exits.</li>
              <li>Check the map and directions before leaving, especially when coordinates or addresses are approximate.</li>
            </ul>
            {sourceUrl && <p><a href={sourceUrl} target="_blank" rel="noreferrer">Check the official park source</a></p>}
          </>
        ) : (
          <p>Confirm current rules, hours, seasonal restrictions, and leash requirements with the municipality or park operator before visiting.</p>
        )}
      </div>
    </div>
  </Section>
</Layout>

<style>
  .park-at-a-glance {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    padding: var(--space-5);
  }

  .park-at-a-glance h2 {
    margin-bottom: var(--space-4);
    font-size: 1.25rem;
  }

  .park-at-a-glance dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: var(--space-3);
    margin: 0;
  }

  .park-at-a-glance div {
    display: grid;
    gap: 0.22rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
    padding: var(--space-3);
  }

  .park-at-a-glance dt {
    color: var(--color-primary-dark);
    font-size: 0.76rem;
    font-weight: 850;
    text-transform: uppercase;
  }

  .park-at-a-glance dd {
    margin: 0;
    font-weight: 750;
    line-height: 1.35;
  }

  .visit-checklist {
    margin: 0 0 var(--space-4);
    padding-left: 1.1rem;
  }

  .visit-checklist li + li {
    margin-top: 0.45rem;
  }

  .faq-accordion {
    display: grid;
    gap: 0.65rem;
  }

  .faq-item {
    border: 1px solid var(--border, #d7dbe4);
    border-radius: 8px;
    background: var(--surface, #fff);
    padding: 0.4rem 0.75rem;
  }

  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    line-height: 1.45;
    list-style: none;
    padding: 0.35rem 0;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item p {
    margin: 0 0 0.35rem;
    color: var(--muted);
    line-height: 1.65;
  }
</style>
