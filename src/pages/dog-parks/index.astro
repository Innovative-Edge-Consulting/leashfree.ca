---
import Card from "../../components/Card.astro";
import DogParkSearch from "../../components/DogParkSearch.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import mediaMap from "../../data/media-map.json";
import parks from "../../data/generated/parks.json";
import cities from "../../data/generated/cities.json";
import provinces from "../../data/generated/provinces.json";
import { excerpt, breadcrumbSchema } from "../../utils/content.js";
import { resolveMedia } from "../../utils/media.js";
import { withoutRedirectedRecords } from "../../utils/redirects.js";

const featuredCities = cities.slice(0, 24);
const activeParks = withoutRedirectedRecords(parks);
const featuredParks = activeParks.slice(0, 48);
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Dog Parks", href: "/dog-parks/" }
];
---

<Layout
  title="Find Leash-Free Dog Parks in Canada"
  description="Browse leash-free dog parks across Canada by province, city, and park page."
  canonical="https://leashfree.ca/dog-parks/"
  structuredData={breadcrumbSchema(breadcrumbs)}
>
  <Hero
    eyebrow="Dog parks"
    title="Find leash-free dog parks in Canada"
    summary="Browse dog park, city, and province guides with local details for Canadian dog owners."
    primaryHref="#provinces"
    primaryLabel="Browse provinces"
    secondaryHref="#suggest-a-park"
    secondaryLabel="Suggest a Park"
    image="/images/blog/blog-how-to-choose-the-right-dog-park-for-your-pup-hero.jpg"
    imageAlt="Dog enjoying a leash-free park"
  />

  <Section title="Dog park coverage" tight>
    <div class="stat-strip">
      <div class="stat"><strong>{activeParks.length}</strong><span>active park records</span></div>
      <div class="stat"><strong>{cities.length}</strong><span>city guides</span></div>
      <div class="stat"><strong>{provinces.length}</strong><span>province guides</span></div>
    </div>
  </Section>

  <Section title="Search dog parks" intro="Search leash-free park records by name, city, province, address, map location, and park amenities.">
    <DogParkSearch />
  </Section>

  <Section
    title="Seasonal safety before you go"
    intro="Use these practical guides before heading to brushy parks, ravines, or summer trail access points."
    alt
  >
    <div class="grid compact">
      <Card
        title="Dog park safety checklist for Canada"
        href="/blog/dog-park-safety-checklist-canada/"
        description="Check heat, wildfire smoke, ticks, water, recall, and play-group safety before every visit."
        ctaLabel="Read safety checklist"
      />
      <Card
        title="Wildfire smoke and dogs in Ontario"
        href="/blog/wildfire-smoke-dogs-canada/"
        description="Use AQHI and smoke alerts to decide when to skip walks, dog parks, and strenuous outdoor play."
        ctaLabel="Read smoke guide"
      />
      <Card
        title="Tick prevention for dogs in Canada"
        href="/blog/tick-prevention-dogs-canada/"
        description="Know when ticks are active, which regions need earlier vigilance, and how to do a proper post-park tick check."
        ctaLabel="Read tick guide"
      />
      <Card
        title="How to choose the right dog park"
        href="/blog/how-to-choose-the-right-dog-park-for-your-pup/"
        description="Use park layout, fencing, water access, and surface conditions to pick a better fit for your dog."
        ctaLabel="Read park guide"
      />
    </div>
  </Section>

  <Section id="provinces" title="Browse by province" intro="Province pages group city guides and park records across Canada." alt>
    <div class="grid compact">
      {provinces.map((item) => (
        <Card title={item.name} href={`/dog-parks/${item.slug}/`} description={item.metaDescription || `Browse dog parks in ${item.name}.`} ctaLabel="View province" />
      ))}
    </div>
  </Section>

  <Section title="City dog park guides" intro="Find local dog park pages by city.">
    <div class="grid">
      {featuredCities.map((item) => (
        <Card
          title={`${item.name} dog parks`}
          href={`/dog-parks/${item.slug}/`}
          description={excerpt(item.description, item.metaDescription)}
          image={resolveMedia(item, "Hero Image", mediaMap).src}
          imageAlt={`${item.name} dog park guide`}
          badges={[item.raw.Province].filter(Boolean)}
          ctaLabel="View city"
        />
      ))}
    </div>
  </Section>

  <Section id="parks" title="Individual park pages" intro="Compare park amenities, locations, and visitor details." alt>
    <div class="grid">
      {featuredParks.map((item) => (
        <Card
          title={item.name}
          href={`/dog-parks/${item.slug}/`}
          description={excerpt(item.description, item.raw["Street Address"])}
          image={resolveMedia(item, undefined, mediaMap).src}
          imageAlt={`${item.name} dog park`}
          meta={[item.raw.City, item.raw.Province].filter(Boolean).join(", ")}
          badges={[item.raw.Fenced ? `Fenced: ${item.raw.Fenced}` : ""].filter(Boolean)}
          ctaLabel="View park"
        />
      ))}
    </div>
  </Section>

  <Section
    id="suggest-a-park"
    title="Know a great park we missed?"
    intro="Suggest a dog park and we will review it for inclusion in our Canada dog park directory."
    alt
  >
    <div class="suggest-park-panel">
      <div data-quizflow-embed="submit-a-dog-park-suggestion"></div>
    </div>
    <script async src="https://quizflowlabs.com/embed.js"></script>
  </Section>
</Layout>
