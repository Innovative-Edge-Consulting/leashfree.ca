---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Layout from "../../../components/Layout.astro";
import Section from "../../../components/Section.astro";
import { breadcrumbSchema } from "../../../utils/content.js";
const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Dog Names", href: "/dog-names/" }, { label: "My Shortlist" }];
---

<Layout title="My Dog Name Shortlist | LeashFree.ca" description="Review, annotate, reorder, print, share, and export your saved dog names with meanings, ideal gender, category, and source." canonical="https://leashfree.ca/dog-names/my-list/" robots="noindex,follow" structuredData={breadcrumbSchema(breadcrumbs)}>
  <section class="list-hero"><div class="container"><Breadcrumbs items={breadcrumbs} /><div class="eyebrow">Dog name workspace</div><h1>My dog name shortlist</h1><p class="summary">Compare your saved names with their meanings, ideal gender, category, personal notes, and original guide.</p></div></section>
  <Section tight>
    <div class="manager" data-shortlist-manager>
      <div class="shared-notice" data-shared-notice hidden><div><strong>A shared shortlist is open</strong><p>Save a copy on this device if you want to keep editing it later.</p></div><button class="button primary" type="button" data-save-shared>Save this list</button></div>
      <div class="manager-toolbar"><label><span>Dog's name or temporary label</span><input type="text" data-dog-label placeholder="For our new puppy" /></label><div class="manager-buttons"><button class="button secondary" type="button" data-print-list>Print</button><button class="button secondary" type="button" data-copy-list>Copy list</button><button class="button secondary" type="button" data-export-list>Export CSV</button><button class="button primary" type="button" data-share-list>Share</button></div></div>
      <div class="manager-meta"><strong data-manager-count>0 saved names</strong><div><button class="button secondary" type="button" data-compare-list>Compare finalists</button> <button class="text-button" type="button" data-clear-list>Clear all</button></div></div>
      <section class="comparison" data-comparison hidden aria-live="polite"><div class="comparison-head"><div><div class="eyebrow">Finalist view</div><h2>Compare your favourite names</h2><p>Select two to five names below. Comparisons use recorded facts without inventing personality claims.</p></div><button type="button" class="text-button" data-close-comparison>Close comparison</button></div><div class="comparison-grid" data-comparison-grid></div></section>
      <div class="manager-empty" data-manager-empty><span aria-hidden="true">♡</span><h2>Your shortlist is empty</h2><p>Explore a guide or search the complete database, then select the heart beside names you want to compare.</p><div class="button-row"><a class="button primary" href="/dog-names/">Explore dog names</a><a class="button secondary" href="/dog-name-finder/">Try the Name Finder</a></div></div>
      <div class="manager-table-wrap" data-manager-table><table class="manager-table"><thead><tr><th scope="col">Compare</th><th scope="col">Name</th><th scope="col">Meaning / why it fits</th><th scope="col">Ideal gender</th><th scope="col">Category</th><th scope="col">Personal note</th><th scope="col">Actions</th></tr></thead><tbody data-manager-body></tbody></table></div>
      <p class="manager-footnote">Your shortlist is stored locally in this browser. Shared links contain a copy of the displayed records and do not require an account.</p>
    </div>
  </Section>
  <script>
    import { initShortlistManager } from "../../../scripts/dog-name-shortlist.js";
    initShortlistManager();
  </script>
</Layout>

<style>
  .list-hero{padding:var(--space-4) 0 var(--space-6);background:linear-gradient(135deg,#f4f8f5,#fff 55%,#edf5f0)}.list-hero h1{font-size:clamp(2.4rem,5vw,4.4rem)}.list-hero .summary{max-width:780px}.manager{padding:var(--space-5);border:1px solid var(--color-border);border-radius:22px;background:var(--color-surface);box-shadow:0 16px 40px rgba(31,41,51,.08)}.shared-notice{display:flex;justify-content:space-between;gap:var(--space-4);align-items:center;margin-bottom:var(--space-4);padding:var(--space-4);border:1px solid #dec991;border-radius:14px;background:#fff9e8}.shared-notice[hidden]{display:none}.shared-notice p{margin:.15rem 0 0;color:#695929}.manager-toolbar{display:flex;justify-content:space-between;gap:var(--space-5);align-items:end}.manager-toolbar label{display:grid;min-width:260px;gap:.4rem;font-size:.76rem;font-weight:850}.manager-toolbar input{min-height:44px;border:1px solid var(--color-border);border-radius:10px;padding:.65rem .75rem}.manager-buttons{display:flex;flex-wrap:wrap;gap:.65rem}.manager-meta{display:flex;justify-content:space-between;align-items:center;margin:var(--space-5) 0 var(--space-3)}.text-button{border:0;background:transparent;color:var(--color-primary-dark);cursor:pointer;font-weight:850;text-decoration:underline}.manager-empty{padding:var(--space-7) var(--space-4);border:1px dashed var(--color-border);border-radius:16px;background:var(--color-primary-soft);text-align:center}.manager-empty[hidden]{display:none}.manager-empty>span{font-size:2.2rem;color:var(--color-primary)}.manager-empty h2{margin:.5rem 0}.manager-empty p{max-width:600px;margin:.5rem auto var(--space-4);color:var(--color-muted)}.manager-empty .button-row{justify-content:center}.manager-table-wrap{overflow:auto;border:1px solid var(--color-border);border-radius:14px}.manager-table{width:100%;min-width:1050px;border-collapse:collapse}.manager-table th,.manager-table td{padding:.85rem;border-bottom:1px solid var(--color-border);text-align:left;vertical-align:top}.manager-table th{background:var(--color-primary-soft);color:var(--color-primary-dark);font-size:.72rem;text-transform:uppercase;letter-spacing:.04em}.manager-table tbody tr:nth-child(even){background:#fbfdfc}.manager-table textarea{width:100%;min-width:150px;border:1px solid var(--color-border);border-radius:8px;padding:.5rem;resize:vertical}.manager-actions{white-space:nowrap}.manager-actions button+button{margin-left:.35rem}.icon-button{width:30px;height:30px;border:1px solid var(--color-border);border-radius:8px;background:#fff;cursor:pointer}.manager-footnote{margin-bottom:0;color:var(--color-muted);font-size:.8rem}
  @media(max-width:850px){.manager-toolbar{align-items:stretch;flex-direction:column}.manager-toolbar label{min-width:0}.manager-buttons{display:grid;grid-template-columns:repeat(2,1fr)}.manager-buttons .button{justify-content:center}.manager{padding:var(--space-4)}}
  @media(max-width:650px){.manager-table-wrap{overflow:visible;border:0}.manager-table{min-width:0}.manager-table thead{display:none}.manager-table tbody{display:grid;gap:var(--space-3)}.manager-table :global(tr){display:grid!important;overflow:hidden;border:1px solid var(--color-border);border-radius:14px;background:#fff}.manager-table :global(td){display:grid;grid-template-columns:105px minmax(0,1fr);gap:var(--space-2);border-bottom:1px solid var(--color-border);padding:.7rem .8rem}.manager-table :global(td::before){content:attr(data-label);color:var(--color-muted);font-size:.68rem;font-weight:850;text-transform:uppercase}.manager-table :global(td:last-child){border-bottom:0}.shared-notice{align-items:flex-start;flex-direction:column}}
  @media print{header,footer,.list-hero nav,.manager-buttons,.manager-meta .text-button,.shared-notice,.manager-footnote{display:none!important}.list-hero{padding:0;background:#fff}.manager{padding:0;border:0;box-shadow:none}.manager-toolbar{margin-bottom:1rem}.manager-toolbar input{border:0;font-size:1.2rem;font-weight:800}.manager-table-wrap{overflow:visible}.manager-table{min-width:0;font-size:10pt}.manager-actions{display:none}.manager-table th:last-child,.manager-table td:last-child{display:none}}
  .manager-table :global(textarea){width:100%;min-width:150px;border:1px solid var(--color-border);border-radius:8px;padding:.5rem;resize:vertical}.manager-table :global(.manager-actions){white-space:nowrap}.manager-table :global(.manager-actions button+button){margin-left:.35rem}.manager-table :global(.icon-button){width:32px;height:32px;border:1px solid var(--color-border);border-radius:8px;background:#fff;color:var(--color-primary-dark);cursor:pointer;font-weight:900}.manager-table :global(.manager-actions .text-button){display:block;margin:.45rem 0 0!important;font-size:.78rem}
  .comparison{margin-bottom:var(--space-5);padding:var(--space-5);border:1px solid #d8e7e0;border-radius:18px;background:linear-gradient(135deg,#f4f9f6,#fff)}.comparison[hidden]{display:none}.comparison-head{display:flex;justify-content:space-between;gap:var(--space-4)}.comparison-head h2{margin:.2rem 0}.comparison-head p{max-width:760px;margin:.25rem 0 var(--space-4);color:var(--color-muted)}.comparison-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:var(--space-3)}.comparison-grid :global(article){padding:var(--space-4);border:1px solid var(--color-border);border-radius:14px;background:#fff}.comparison-grid :global(h3){margin:0 0 .75rem;color:var(--color-primary-dark)}.comparison-grid :global(dl){display:grid;gap:.65rem;margin:0}.comparison-grid :global(dt){color:var(--color-muted);font-size:.67rem;font-weight:900;letter-spacing:.04em;text-transform:uppercase}.comparison-grid :global(dd){margin:.1rem 0 0}.manager-table :global(.compare-check){width:18px;height:18px;accent-color:var(--color-primary)}
  @media(max-width:650px){.comparison-head{flex-direction:column}.comparison{padding:var(--space-4)}}
  @media print{.manager-table :global(.manager-actions){display:none!important}}
</style>
