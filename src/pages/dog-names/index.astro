---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";
import DogNamesTable from "../../components/DogNamesTable.astro";
import ImageWithFallback from "../../components/ImageWithFallback.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import dogNames from "../../data/generated/dog-names.json";
import manualDogNameGuides from "../../data/manual-dog-name-guides.json";
import { excerpt, breadcrumbSchema, stripHtml } from "../../utils/content.js";

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Dog Names", href: "/dog-names/" }];
const topCsvUrl = "/data/top-1000-dog-names-2026.csv";
const searchableNameCount = 488;
const heroImage = "/images/blog/blog-trending-dog-names-2026-hero.jpg";
const allDogNames = [...manualDogNameGuides, ...dogNames];
const normalizeText = (text = "") => text.replace(/â€™|Ã¢â‚¬â„¢/g, "'").replace(/â€œ|â€|Ã¢â‚¬Å“|Ã¢â‚¬Â/g, '"').replace(/â€“|Ã¢â‚¬â€œ/g, "–").replace(/â€”|Ã¢â‚¬â€/g, "—").replace(/â€¦/g, "...").replace(/â€/g, "").replace(/\s+/g, " ").trim();
const guideCard = (entry) => {
  const breed = entry.references?.["Breed Name"]?.[0] || entry.raw?.["Breed Name"] || "";
  const intro = normalizeText(stripHtml(entry.raw?.["Intro Summary"] || ""));
  const sourceImage = entry.raw?.["Hero Image"] || entry.media?.find((asset) => asset.fieldName === "Hero Image")?.value || "";
  const extension = sourceImage.match(/\.(avif|png|webp|jpe?g)(?:\?|$)/i)?.[1]?.toLowerCase().replace("jpeg", "jpg") || "jpg";
  const image = sourceImage.startsWith("/images/dog-names/") ? sourceImage : `/images/dog-names/dog-name-${entry.slug}-hero.${extension}`;
  return { ...entry, breed, description: excerpt(intro || normalizeText(entry.metaDescription || ""), normalizeText(entry.description || ""), 150), image };
};
const themeGuides = manualDogNameGuides.map(guideCard);
const breedGuides = dogNames.map(guideCard).slice(0, 8);
const faqs = [
  { question: "How should I choose a dog name?", answer: "Choose a short, distinct name that is easy to say, sounds different from common training cues, and suits your dog's personality. Test it aloud in both calm and busy settings." },
  { question: "Are one- or two-syllable dog names better?", answer: "Short names are often easier to repeat consistently and easier for a dog to distinguish. Longer names can still work well when they have a clear everyday nickname." },
  { question: "Can I rename an adopted dog?", answer: "Yes. Dogs can learn a new name through repetition, rewards, and positive associations. Use the new name consistently and reward your dog when they respond." },
  { question: "Should a dog name sound different from commands?", answer: "Yes. Avoid names that closely resemble cues such as no, stay, sit, down, or come because similar sounds can cause confusion during training." }
];
const structuredData = [
  breadcrumbSchema(breadcrumbs),
  { "@context": "https://schema.org", "@type": "Dataset", name: "488 Dog and Puppy Names for 2026", description: "A searchable list of dog names with rankings, meanings, suggested gender, and category.", url: "https://leashfree.ca/dog-names/", distribution: { "@type": "DataDownload", encodingFormat: "text/csv", contentUrl: `https://leashfree.ca${topCsvUrl}` } },
  { "@context": "https://schema.org", "@type": "ItemList", name: "Dog name guides", itemListElement: allDogNames.map((entry, index) => ({ "@type": "ListItem", position: index + 1, name: entry.title || entry.name, url: `https://leashfree.ca/dog-names/${entry.slug}/` })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) }
];
---

<Layout title="488 Dog Names for 2026: Search by Style & Meaning | LeashFree.ca" description="Search 488 dog and puppy names for 2026 by meaning, gender, and style, or explore Canadian, cute, unique, nature, and breed-specific guides." canonical="https://leashfree.ca/dog-names/" ogImage={heroImage} structuredData={structuredData}>
  <section class="names-hero"><div class="container names-hero-grid"><div><Breadcrumbs items={breadcrumbs} /><div class="eyebrow">2026 dog name guide</div><h1>Find a name that fits your dog</h1><p class="summary">Search nearly 500 dog names by meaning, gender, and style—or explore curated ideas for your dog's breed and personality.</p><div class="button-row"><a class="button primary" href="#name-table">Search {searchableNameCount} names</a><a class="button secondary" href="/dog-name-finder/">Try the Name Finder</a><a class="button secondary" href="/dog-names/my-list/">My saved list</a></div></div><figure class="names-hero-media"><ImageWithFallback src={heroImage} alt="Dog owner choosing a name for a new puppy" variant="hero" loading="eager" fetchPriority="high" imagePosition="center 20%" /><figcaption><span aria-hidden="true">♥</span> The best name is clear, memorable, and easy to call.</figcaption></figure></div></section>

  <div class="names-trust"><div class="container names-trust-grid"><span><strong>{searchableNameCount}</strong><small>searchable names</small></span><span><strong>8</strong><small>name categories</small></span><span><strong>{allDogNames.length}</strong><small>curated guides</small></span><span><strong>2026</strong><small>updated collection</small></span></div></div>

  <Section eyebrow="Choose your path" title="Three ways to find the right name" intro="Start broad, get personalized suggestions, or browse ideas tailored to a naming style."><div class="path-grid"><a href="#name-table"><span>01</span><div><h3>Search every name</h3><p>Filter the complete list by name, meaning, gender, and category.</p></div><b aria-hidden="true">→</b></a><a href="/dog-name-finder/"><span>02</span><div><h3>Get personalized picks</h3><p>Use your preferences to generate a more focused shortlist.</p></div><b aria-hidden="true">→</b></a><a href="#name-guides"><span>03</span><div><h3>Browse curated guides</h3><p>Explore Canadian, cute, unique, nature, and breed-specific ideas.</p></div><b aria-hidden="true">→</b></a></div></Section>

  <Section id="name-table" alt eyebrow="Searchable database" title={`Explore ${searchableNameCount} dog names`} intro="Search meanings or filter the list. Every filtered view can be shared with someone helping you choose."><DogNamesTable title={`${searchableNameCount} Dog & Puppy Names`} csvUrl={topCsvUrl} intro="Search names and meanings, then narrow the results by gender or naming style." /></Section>

  <Section id="name-guides" eyebrow="Theme collections" title="Popular dog name guides" intro="Begin with a naming style, then use each guide's editor picks and practical naming tips."><div class="theme-guide-grid">{themeGuides.map((entry) => <Card className="name-guide-card" title={entry.title || entry.name} href={`/dog-names/${entry.slug}/`} description={entry.description} image={entry.image} imageAlt={`${entry.title || entry.name} guide`} imageLabel="Name ideas" ctaLabel="Explore names" />)}</div></Section>

  <Section alt eyebrow="Breed-specific ideas" title="Names inspired by your dog's breed" intro="Match a name to breed history, appearance, energy, temperament, or personality."><div class="breed-guide-grid">{breedGuides.map((entry) => <Card className="name-guide-card" title={entry.title || entry.name} href={`/dog-names/${entry.slug}/`} description={entry.description} image={entry.image} imageAlt={`${entry.title || entry.name} guide`} imagePosition="center top" imageLabel={entry.breed || "Breed guide"} ctaLabel="Read guide" />)}</div></Section>

  <Section eyebrow="Naming checklist" title="Test a name before it becomes permanent" intro="A name can look great on a list and still be awkward in daily life."><div class="tips-grid"><article><span>1</span><h3>Say it out loud</h3><p>Try it softly, enthusiastically, and from across a room or yard.</p></article><article><span>2</span><h3>Check training cues</h3><p>Avoid names that sound too much like no, sit, stay, down, or come.</p></article><article><span>3</span><h3>Try the nickname</h3><p>Make sure the likely shortened version is something you also enjoy.</p></article><article><span>4</span><h3>Use it for a day</h3><p>Test your shortlist naturally before updating tags and veterinary records.</p></article></div></Section>

  <Section alt eyebrow="Common questions" title="Choosing a dog name"><div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div></Section>
</Layout>

<style>
  .names-hero{padding:var(--space-4) 0 var(--space-7);background:linear-gradient(135deg,#f4f8f5,#fff 55%,#edf5f0)}.names-hero-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(350px,.75fr);gap:var(--space-7);align-items:center}.names-hero .summary{max-width:680px}.names-hero-media{position:relative;overflow:hidden;margin:0;border:1px solid rgba(73,127,100,.22);border-radius:22px;background:var(--color-primary-soft);box-shadow:0 18px 42px rgba(31,41,51,.14)}.names-hero-media :global(.hero-media){width:100%;min-height:390px;aspect-ratio:3/2;object-fit:cover}.names-hero-media figcaption{position:absolute;right:var(--space-4);bottom:var(--space-4);left:var(--space-4);display:flex;gap:.55rem;align-items:center;padding:.7rem .85rem;border:1px solid rgba(255,255,255,.7);border-radius:12px;background:rgba(255,255,255,.9);font-size:.82rem;font-weight:850;box-shadow:0 8px 24px rgba(31,41,51,.12);backdrop-filter:blur(10px)}
  .names-trust{border-block:1px solid var(--color-border);background:var(--color-surface)}.names-trust-grid{display:grid;grid-template-columns:repeat(4,1fr)}.names-trust-grid span{padding:1rem;text-align:center}.names-trust-grid span+span{border-left:1px solid var(--color-border)}.names-trust-grid strong,.names-trust-grid small{display:block}.names-trust-grid strong{color:var(--color-primary-dark);font-size:1.05rem}.names-trust-grid small{margin-top:.15rem;color:var(--color-muted)}
  .path-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-4)}.path-grid a{display:flex;gap:var(--space-3);align-items:flex-start;padding:var(--space-5);border:1px solid var(--color-border);border-radius:18px;background:var(--color-surface);color:var(--color-text);text-decoration:none;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}.path-grid a:hover{transform:translateY(-3px);border-color:var(--color-primary);box-shadow:0 14px 30px rgba(31,41,51,.09)}.path-grid>a>span{color:var(--color-primary);font-size:.78rem;font-weight:950}.path-grid div{flex:1}.path-grid h3,.path-grid p{margin:0}.path-grid p{margin-top:.35rem;color:var(--color-muted)}.path-grid b{color:var(--color-primary-dark)}
  .theme-guide-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-4)}.breed-guide-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-4)}.theme-guide-grid :global(.name-guide-card),.breed-guide-grid :global(.name-guide-card){display:flex;min-height:100%;flex-direction:column;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease}.theme-guide-grid :global(.name-guide-card:hover),.breed-guide-grid :global(.name-guide-card:hover){transform:translateY(-3px);border-color:var(--color-primary);box-shadow:0 14px 32px rgba(31,41,51,.1)}.theme-guide-grid :global(.card-media-wrap),.breed-guide-grid :global(.card-media-wrap){aspect-ratio:16/10}.theme-guide-grid :global(.card-media),.breed-guide-grid :global(.card-media){height:100%}.theme-guide-grid :global(.card-body),.breed-guide-grid :global(.card-body){display:flex;flex:1;flex-direction:column;padding:var(--space-4)}.theme-guide-grid :global(.card-body>p),.breed-guide-grid :global(.card-body>p){display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3}.theme-guide-grid :global(.card-body>.button),.breed-guide-grid :global(.card-body>.button){align-self:flex-start;margin-top:auto}
  .tips-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--space-4)}.tips-grid article{padding:var(--space-5);border:1px solid var(--color-border);border-radius:17px;background:var(--color-surface)}.tips-grid span{display:grid;width:36px;height:36px;place-items:center;border-radius:10px;background:var(--color-primary-soft);color:var(--color-primary-dark);font-weight:950}.tips-grid h3{margin:var(--space-3) 0 .35rem}.tips-grid p{margin:0;color:var(--color-muted)}.faq-list{display:grid;max-width:900px;gap:var(--space-3)}.faq-list details{padding:0 var(--space-4);border:1px solid var(--color-border);border-radius:14px;background:var(--color-surface)}.faq-list summary{cursor:pointer;padding:1rem 2rem 1rem 0;font-weight:850}.faq-list p{margin:0;padding:0 0 1rem;color:var(--color-muted)}
  @media(max-width:1000px){.theme-guide-grid,.breed-guide-grid{grid-template-columns:repeat(2,1fr)}.tips-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:820px){.names-hero-grid{grid-template-columns:1fr}.names-hero-media :global(.hero-media){min-height:0}.path-grid{grid-template-columns:1fr}}
  @media(max-width:600px){.names-hero{padding-bottom:var(--space-5)}.names-trust-grid,.theme-guide-grid,.breed-guide-grid,.tips-grid{grid-template-columns:1fr}.names-trust-grid span+span{border-top:1px solid var(--color-border);border-left:0}}
</style>
