---
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Card from "../../../components/Card.astro";
import ContentBlock from "../../../components/ContentBlock.astro";
import Layout from "../../../components/Layout.astro";
import Section from "../../../components/Section.astro";
import groups from "../../../data/generated/breed-groups.json";
import breeds from "../../../data/generated/dog-breeds.json";
import { breadcrumbSchema, excerpt, slugify } from "../../../utils/content.js";

export function getStaticPaths() {
  return groups.filter((group) => group.slug).map((group) => ({
    params: { slug: group.slug },
    props: { group }
  }));
}

const { group } = Astro.props;
const groupBreeds = breeds.filter((breed) => slugify(breed.raw["Breed Group"]) === slugify(group.name));
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Dog Breeds", href: "/dog-breeds/" },
  { label: group.name }
];
---

<Layout title={group.seoTitle || group.title || group.name} description={group.metaDescription || group.description} canonical={group.canonicalUrl} structuredData={breadcrumbSchema(breadcrumbs)}>
  <section class="page-header">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="eyebrow">Breed group</div>
      <h1>{group.title || group.name}</h1>
      <p class="summary">{excerpt(group.description, group.metaDescription)}</p>
    </div>
  </section>

  {group.body && (
    <Section>
      <ContentBlock html={group.body} />
    </Section>
  )}

  <Section title={`Breeds in ${group.name}`} intro={`${groupBreeds.length} breed profiles currently match this group.`} alt>
    <div class="grid">
      {groupBreeds.map((breed) => (
        <Card title={breed.name} href={`/dog-breeds/${breed.slug}/`} description={excerpt(breed.metaDescription, breed.description)} ctaLabel="View breed" />
      ))}
    </div>
  </Section>
</Layout>
