---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ContentBlock from "../../components/ContentBlock.astro";
import ImageWithFallback from "../../components/ImageWithFallback.astro";
import Layout from "../../components/Layout.astro";
import NutriCanineSponsorWidget from "../../components/NutriCanineSponsorWidget.astro";
import RelatedLinks from "../../components/RelatedLinks.astro";
import Section from "../../components/Section.astro";
import SimilarBreedsCarousel from "../../components/SimilarBreedsCarousel.astro";
import mediaMap from "../../data/media-map.json";
import breeds from "../../data/generated/dog-breeds.json";
import groups from "../../data/generated/breed-groups.json";
import { breadcrumbSchema, excerpt, findByName } from "../../utils/content.js";
import { resolveMedia } from "../../utils/media.js";

export function getStaticPaths() {
  return breeds.filter((breed) => breed.slug).map((breed) => ({
    params: { slug: breed.slug },
    props: { breed }
  }));
}

const { breed } = Astro.props;
const image = resolveMedia(breed, "Featured Image", mediaMap);
const group = findByName(groups, breed.raw["Breed Group"]);

function extractFaqItems(html) {
  if (!html || typeof html !== "string") {
    return [];
  }

  const items = [];
  const qaPattern = /<p[^>]*>\s*<strong[^>]*>([\s\S]*?)<\/strong>\s*<br\s*\/?>\s*([\s\S]*?)<\/p>/gi;
  let match;

  while ((match = qaPattern.exec(html)) !== null) {
    const question = match[1].replace(/<[^>]+>/g, "").replace(/\s+/g, " ").trim();
    const answer = match[2].trim();
    if (question && answer) {
      items.push({ question, answer });
    }
  }

  return items;
}

const faqHtml = breed.raw.FAQs;
const faqItems = extractFaqItems(faqHtml);

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Dog Breeds", href: "/dog-breeds/" },
  group ? { label: group.name, href: `/dog-breeds/group/${group.slug}/` } : null,
  { label: breed.name }
].filter(Boolean);
const traits = [
  ["Breed group", group ? group.name : breed.raw["Breed Group"]],
  ["Size", breed.raw["Size Category"]],
  ["Coat", breed.raw["Coat Type"]],
  ["Activity level", breed.raw["Activity Level"]],
  ["Trainability", breed.raw.Trainability],
  ["Shedding", breed.raw["Shedding Level"]],
  ["Family friendly", breed.raw["Family Friendly"]],
  ["Apartment friendly", breed.raw["Apartment Friendly"]],
  ["Hypoallergenic", breed.raw.Hypoallergenic]
].filter(([, value]) => value);
const sections = [
  ["Breed history", breed.raw["Breed History"]],
  ["Physical characteristics", breed.raw["Physical Characteristics"]],
  ["Grooming", breed.raw.Grooming],
  ["Exercise needs", breed.raw["Exercise Needs"]],
  ["Training tips", breed.raw["Training Tips"]],
  ["Nutrition and diet", breed.raw["Nutrition & Diet"]],
  ["Health concerns", breed.raw["Health Concerns"]],
  ["Adoption and breeders", breed.raw["Adoption & Breeders"]]
].filter(([, value]) => value);
---

<Layout title={breed.seoTitle || breed.title || breed.name} description={breed.metaDescription || breed.description} canonical={breed.canonicalUrl} ogImage={image.src} structuredData={breadcrumbSchema(breadcrumbs)}>
  <section class="page-header">
    <div class="container detail-layout">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="eyebrow">Dog breed</div>
        <h1>{breed.name}</h1>
        <p class="summary">{excerpt(breed.description, breed.metaDescription)}</p>
      </div>
      <ImageWithFallback src={image.src} alt={`${breed.name} breed image`} variant="hero" loading="eager" imagePosition="center 20%" imageFit="contain" />
    </div>
  </section>

  <Section title="Breed traits">
    <ul class="meta-list">
      {traits.map(([label, value]) => <li><strong>{label}</strong><br />{value}</li>)}
    </ul>
  </Section>

  <Section>
    <div class="split">
      <article>
        <ContentBlock html={breed.body || breed.raw["Breed Summary"] || breed.description} />
        {sections.map(([heading, html]) => (
          <section class="content-block">
            <h2>{heading}</h2>
            <div set:html={html} />
            {heading === "Nutrition and diet" && (
              <p class="sponsor-context-link">
                For owners comparing fresh dog food options in Canada,{" "}
                <a
                  href="#nutricanine-sponsor"
                  data-nutricanine-open
                >
                  NutriCanine offers real, gently cooked meals made with fresh ingredients
                </a>
                .
              </p>
            )}
          </section>
        ))}
        {faqItems.length > 0 ? (
          <section class="content-block faq-accordion">
            <h2>FAQs</h2>
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary>{item.question}</summary>
                <div class="faq-answer" set:html={item.answer} />
              </details>
            ))}
          </section>
        ) : faqHtml ? (
          <section class="content-block">
            <h2>FAQs</h2>
            <div set:html={faqHtml} />
          </section>
        ) : null}
      </article>
      <aside class="sidebar">
        <RelatedLinks title="Breed links" links={group ? [{ href: `/dog-breeds/group/${group.slug}/`, label: `More ${group.name}` }] : []} />
        <p class="sponsored-label">Sponsored</p>
        <NutriCanineSponsorWidget />
      </aside>
    </div>
  </Section>

  <SimilarBreedsCarousel currentBreed={breed} allBreeds={breeds} mediaMap={mediaMap} />

  <script is:inline>
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Element)) {
        return;
      }

      const trigger = event.target.closest("[data-nutricanine-open]");
      if (!trigger) {
        return;
      }

      event.preventDefault();
      if (window.openNutriCanineSponsor) {
        window.openNutriCanineSponsor();
        return;
      }

      document.querySelector("[data-nutricanine-expand]")?.click();
    });
  </script>
</Layout>
