---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import AdSenseDisplay from "../../components/AdSenseDisplay.astro";
import ContentBlock from "../../components/ContentBlock.astro";
import ImageWithFallback from "../../components/ImageWithFallback.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import Card from "../../components/Card.astro";
import mediaMap from "../../data/media-map.json";
import posts from "../../data/blog-posts.js";
import { breadcrumbSchema, cleanText, dateLabel, excerpt, isPublishedNow } from "../../utils/content.js";
import { resolveMedia } from "../../utils/media.js";

const publishedPosts = posts.filter((post) => isPublishedNow(post));

export function getStaticPaths() {
  return posts.filter((post) => post.slug && isPublishedNow(post)).map((post) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;
const image = resolveMedia(post, "Hero Image", mediaMap);
const tags = post.references["Blog Tags"] || [];
const category = post.references.Category?.[0] || "";
const published = dateLabel(post.raw["Published On"]);
const updated = dateLabel(post.raw["Updated On"]);
const postTitle = cleanText(post.title || post.name);
const pageTitle = cleanText(post.seoTitle || post.title || post.name);
const pageDescription = cleanText(post.metaDescription || post.description);
const related = publishedPosts.filter((candidate) => candidate.slug !== post.slug && candidate.references.Category?.[0] === category).slice(0, 3);
const articleHtml = post.body || post.description;
const firstHeadingMatch = articleHtml.match(/<h2\b/i);
const articleIntroHtml = firstHeadingMatch ? articleHtml.slice(0, firstHeadingMatch.index) : articleHtml;
const articleRemainderHtml = firstHeadingMatch ? articleHtml.slice(firstHeadingMatch.index) : "";
const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Blog", href: "/blog/" },
  { label: postTitle }
];
const structuredData = [
  breadcrumbSchema(breadcrumbs),
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: postTitle,
    description: cleanText(post.metaDescription || post.description),
    datePublished: post.raw["Published On"] || undefined,
    dateModified: post.raw["Updated On"] || undefined,
    url: post.canonicalUrl,
    image: image.src
  }
];
---

<Layout title={pageTitle} description={pageDescription} canonical={post.canonicalUrl} ogImage={image.src} structuredData={structuredData}>
  <section class="page-header">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="hero-grid">
        <div>
          <div class="eyebrow">Blog</div>
          <h1>{postTitle}</h1>
          <p class="summary">{excerpt(post.description, post.metaDescription)}</p>
          {(category || published || updated) && (
            <div class="badges">
              {category && <span class="badge">{category}</span>}
              {published && <span class="badge">Published {published}</span>}
              {updated && updated !== published && <span class="badge">Updated {updated}</span>}
            </div>
          )}
        </div>
        <ImageWithFallback src={image.src} alt={`${postTitle} featured image`} variant="hero" loading="eager" />
      </div>
    </div>
  </section>

  <Section>
    <div class="split">
      <article>
        <ContentBlock html={articleIntroHtml} />
        <AdSenseDisplay
          slot="2975877653"
          className="blog-post-ad"
          format="fluid"
          layout="in-article"
          fullWidthResponsive={false}
          centered
        />
        <ContentBlock html={articleRemainderHtml} />
      </article>
      <aside class="sidebar">
        {(category || tags.length > 0) && (
          <section class="card">
            <div class="card-body">
              <h2>Article details</h2>
              <ul>
                {category && <li><strong>Category:</strong> {category}</li>}
                {tags.length > 0 && <li><strong>Tags:</strong> {tags.join(", ")}</li>}
              </ul>
            </div>
          </section>
        )}
      </aside>
    </div>
  </Section>

  {related.length > 0 && (
    <Section title="Related articles" alt>
      <div class="grid">
        {related.map((item) => (
          <Card
            title={item.title || item.name}
            href={`/blog/${item.slug}/`}
            description={excerpt(item.metaDescription, item.description)}
            image={resolveMedia(item, "Hero Image", mediaMap).src}
            imageAlt={`${item.title || item.name} featured image`}
            ctaLabel="Read article"
          />
        ))}
      </div>
    </Section>
  )}
</Layout>
