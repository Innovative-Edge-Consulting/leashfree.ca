---
import Layout from "../../components/Layout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ImageWithFallback from "../../components/ImageWithFallback.astro";
import Section from "../../components/Section.astro";
import { breadcrumbSchema } from "../../utils/content.js";

const breadcrumbs = [{ label: "Home", href: "/" }, { label: "Resources", href: "/resources/" }];
const tools = [
  { title: "Dog Breed Match Quiz", description: "Find breeds that fit your lifestyle, home, activity level, and household.", href: "/resources/dog-breed-match-quiz/", cta: "Find your match", icon: "🐕", meta: ["2-minute quiz", "Personalized results"], group: "Find the right dog", featured: true },
  { title: "Dog Cost Calculator", description: "Estimate first-year, monthly, annual, and lifetime dog ownership costs in Canada.", href: "/resources/dog-cost-calculator-canada/", cta: "Plan your budget", icon: "🧾", meta: ["Canada-specific", "Adjustable estimate"], group: "Plan and protect", featured: true },
  { title: "Breed Guessing Game", description: "Test your breed recognition with 20 photo questions and learn as you play.", href: "/games/dog-breed-guessing-game/", cta: "Play the game", icon: "🧩", meta: ["20 questions", "Photo-based"], group: "Find the right dog" },
  { title: "Calorie Calculator", description: "Estimate daily calorie needs using standard RER and MER formulas.", href: "/resources/dog-calorie-calculator/", cta: "Calculate calories", icon: "🥣", meta: ["Research-guided", "Instant estimate"], group: "Care and feeding" },
  { title: "Dog Food Comparison", description: "Compare nutrition, ingredients, calories, and estimated cost from product labels.", href: "/dog-food-comparison-canada/", cta: "Compare dog food", icon: "⚖️", meta: ["Canada-specific", "Side-by-side"], group: "Care and feeding" },
  { title: "Dog Insurance Comparison", description: "Review Canadian providers by coverage, limits, reimbursement, and waiting periods.", href: "/dog-insurance-canada/", cta: "Compare insurance", icon: "🛡️", meta: ["Canada-specific", "No signup"], group: "Plan and protect" },
  { title: "Dog Name Finder", description: "Get name ideas matched to your dog's personality, style, and overall vibe.", href: "/dog-name-finder/", cta: "Find a name", icon: "✨", meta: ["Personalized ideas", "Instant results"], group: "Names and gear" },
  { title: "Dog Gear Finder", description: "Find gear recommendations suited to your dog's activities, environment, and routine.", href: "/resources/dog-gear-finder/", cta: "Find dog gear", icon: "🎒", meta: ["Personalized picks", "No signup"], group: "Names and gear" }
];
const groups = ["Find the right dog", "Care and feeding", "Plan and protect", "Names and gear"];
const featuredTools = tools.filter((tool) => tool.featured);
const structuredData = [breadcrumbSchema(breadcrumbs), { "@context": "https://schema.org", "@type": "ItemList", name: "Free dog tools and resources", itemListElement: tools.map((tool, index) => ({ "@type": "ListItem", position: index + 1, name: tool.title, url: `https://leashfree.ca${tool.href}` })) }];
---

<Layout title="Free Dog Tools & Resources for Canadian Dog Owners | LeashFree.ca" description="Use free Canadian tools to choose a dog breed, plan ownership costs, compare dog food and insurance, calculate calories, find names, and more." canonical="https://leashfree.ca/resources/" structuredData={structuredData}>
  <section class="page-header resources-hero">
    <div class="container detail-layout">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="eyebrow">Free tools for Canadian dog owners</div>
        <h1>Make better decisions for your dog</h1>
        <p class="summary">Choose a breed, plan costs, compare food, calculate calories, and get personalized recommendations—all in one place.</p>
        <div class="button-row">
          <a class="button primary" href="#all-tools">Browse all tools</a>
          <a class="button secondary" href="/resources/dog-breed-match-quiz/">Find your breed match</a>
        </div>
      </div>
      <ImageWithFallback src="/images/general/blog-category-dog-gear-card.jpg" alt="Dog and owner exploring outdoors together" variant="hero" loading="eager" />
    </div>
  </section>

  <div class="trust-strip" aria-label="About our tools">
    <div class="container trust-list">
      <span><strong>Free</strong> to use</span><span><strong>Canada-focused</strong> information</span><span><strong>Research-guided</strong> methods</span><span><strong>No signup</strong> required</span>
    </div>
  </div>

  <Section eyebrow="Start here" title="Popular tools" intro="Two helpful places to begin, whether you're choosing a dog or planning for one.">
    <div class="featured-grid">
      {featuredTools.map((tool) => (
        <a class="featured-card" href={tool.href}>
          <span class="tool-icon" aria-hidden="true">{tool.icon}</span>
          <div class="featured-card-copy">
            <div class="tag-row">{tool.meta.map((item) => <span>{item}</span>)}</div>
            <h3>{tool.title}</h3><p>{tool.description}</p>
            <span class="card-cta">{tool.cta}<span aria-hidden="true"> →</span></span>
          </div>
        </a>
      ))}
    </div>
  </Section>

  <Section id="all-tools" alt eyebrow="Explore by goal" title="What can we help you with?" intro="Choose a goal to find the right free tool.">
    <div class="tool-groups">
      {groups.map((group) => (
        <section class="tool-group" aria-labelledby={`group-${group.toLowerCase().replaceAll(" ", "-")}`}>
          <h3 id={`group-${group.toLowerCase().replaceAll(" ", "-")}`}>{group}</h3>
          <div class="tool-grid">
            {tools.filter((tool) => tool.group === group).map((tool) => (
              <a class="tool-card" href={tool.href}>
                <span class="tool-icon small" aria-hidden="true">{tool.icon}</span>
                <div><h4>{tool.title}</h4><p>{tool.description}</p><div class="tag-row compact">{tool.meta.map((item) => <span>{item}</span>)}</div><span class="card-cta">{tool.cta}<span aria-hidden="true"> →</span></span></div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </Section>

  <Section eyebrow="Beyond the tools" title="Explore more on LeashFree.ca" intro="Keep learning, find a place to play, or research your next dog.">
    <div class="explore-grid">
      <a class="explore-card" href="/dog-parks/"><span class="explore-kicker">Go somewhere</span><h3>Find off-leash dog parks</h3><p>Search parks and amenities in communities across Canada.</p><span class="card-cta">Explore dog parks →</span></a>
      <a class="explore-card" href="/dog-breeds/"><span class="explore-kicker">Learn about breeds</span><h3>Browse the breed directory</h3><p>Compare size, temperament, care needs, and more.</p><span class="card-cta">Browse dog breeds →</span></a>
      <a class="explore-card" href="/blog/"><span class="explore-kicker">Get practical advice</span><h3>Read Canadian dog guides</h3><p>Helpful articles about health, gear, training, and everyday life.</p><span class="card-cta">Read the latest guides →</span></a>
    </div>
  </Section>

  <Section alt tight>
    <div class="method-note"><div><h2>Clear guidance, without the hype</h2><p>Our tools use transparent assumptions and research-guided methods. Results are educational estimates and do not replace advice from your veterinarian or another qualified professional.</p></div><a href="/terms-of-use/">Read our terms and methodology notes</a></div>
  </Section>
</Layout>

<style>
  .resources-hero { padding-bottom: var(--space-7); }
  .resources-hero .summary { max-width: 640px; }
  .trust-strip { border-block: 1px solid var(--color-border); background: var(--color-surface); }
  .trust-list { display: grid; grid-template-columns: repeat(4, 1fr); }
  .trust-list span { padding: 1rem 1.25rem; color: var(--color-muted); text-align: center; }
  .trust-list span + span { border-left: 1px solid var(--color-border); }
  .trust-list strong { color: var(--color-primary-dark); }
  .featured-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-5); margin-top: var(--space-5); }
  .featured-card, .tool-card, .explore-card { color: var(--color-text); text-decoration: none; transition: transform .18s ease, box-shadow .18s ease, border-color .18s ease; }
  .featured-card { display: grid; grid-template-columns: auto 1fr; gap: var(--space-5); min-height: 270px; border: 1px solid rgba(73, 127, 100, .25); border-radius: var(--radius-card); background: linear-gradient(145deg, #fff, var(--color-primary-soft)); padding: var(--space-6); box-shadow: 0 10px 30px rgba(49, 95, 73, .08); }
  .featured-card-copy { display: flex; flex-direction: column; align-items: flex-start; }
  .featured-card h3 { margin-top: var(--space-4); font-size: clamp(1.4rem, 2.3vw, 1.85rem); }
  .featured-card p { color: var(--color-muted); }
  .tool-icon { display: grid; place-items: center; width: 66px; height: 66px; border-radius: 18px; background: #fff; box-shadow: 0 7px 20px rgba(49, 95, 73, .12); font-size: 2rem; }
  .tool-icon.small { width: 48px; height: 48px; border: 1px solid var(--color-border); border-radius: 14px; box-shadow: none; font-size: 1.45rem; }
  .tag-row { display: flex; flex-wrap: wrap; gap: .45rem; }
  .tag-row span { border-radius: var(--radius-pill); background: rgba(73, 127, 100, .12); color: var(--color-primary-dark); padding: .28rem .6rem; font-size: .72rem; font-weight: 850; }
  .tag-row.compact { margin: var(--space-3) 0; }
  .card-cta { margin-top: auto; color: var(--color-primary-dark); font-weight: 900; }
  .tool-groups { display: grid; gap: var(--space-6); margin-top: var(--space-6); }
  .tool-group > h3 { margin-bottom: var(--space-3); color: var(--color-primary-dark); font-size: .92rem; letter-spacing: .05em; text-transform: uppercase; }
  .tool-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-4); }
  .tool-card { display: grid; grid-template-columns: auto 1fr; gap: var(--space-4); min-height: 240px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); padding: var(--space-5); }
  .tool-card > div { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
  .tool-card h4 { margin: 0 0 var(--space-2); font-size: 1.16rem; line-height: 1.25; }
  .tool-card p { margin-bottom: 0; color: var(--color-muted); }
  .explore-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-5); }
  .explore-card { display: flex; flex-direction: column; min-height: 260px; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); padding: var(--space-5); }
  .explore-card::before { content: ""; width: 48px; height: 6px; margin-bottom: var(--space-5); border-radius: var(--radius-pill); background: var(--color-primary); }
  .explore-kicker { color: var(--color-primary-dark); font-size: .76rem; font-weight: 900; letter-spacing: .05em; text-transform: uppercase; }
  .explore-card h3 { margin-top: var(--space-2); font-size: 1.35rem; }
  .explore-card p { color: var(--color-muted); }
  .method-note { display: flex; align-items: center; justify-content: space-between; gap: var(--space-7); }
  .method-note h2 { margin-bottom: var(--space-2); font-size: 1.35rem; }
  .method-note p { max-width: 780px; margin: 0; color: var(--color-muted); font-size: .94rem; }
  .method-note > a { flex: 0 0 auto; font-weight: 850; }
  .featured-card:hover, .tool-card:hover, .explore-card:hover { border-color: var(--color-primary); box-shadow: var(--shadow-card); transform: translateY(-3px); }
  .featured-card:focus-visible, .tool-card:focus-visible, .explore-card:focus-visible { outline: 3px solid rgba(73, 127, 100, .4); outline-offset: 4px; }
  @media (max-width: 820px) {
    .trust-list { grid-template-columns: repeat(2, 1fr); }
    .trust-list span:nth-child(3) { border-left: 0; border-top: 1px solid var(--color-border); }
    .trust-list span:nth-child(4) { border-top: 1px solid var(--color-border); }
    .featured-grid, .tool-grid, .explore-grid { grid-template-columns: 1fr; }
    .explore-card { min-height: 220px; }
    .method-note { align-items: flex-start; flex-direction: column; gap: var(--space-4); }
  }
  @media (max-width: 540px) {
    .resources-hero .button { width: 100%; }
    .trust-list { grid-template-columns: 1fr; }
    .trust-list span + span, .trust-list span:nth-child(3) { border-top: 1px solid var(--color-border); border-left: 0; }
    .featured-card, .tool-card { grid-template-columns: 1fr; min-height: 0; padding: var(--space-5); }
    .featured-card .card-cta, .tool-card .card-cta { margin-top: var(--space-4); }
  }
</style>
