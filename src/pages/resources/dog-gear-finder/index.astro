---
import Layout from "../../../components/Layout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import ImageWithFallback from "../../../components/ImageWithFallback.astro";
import RockyMountainDogSponsorWidget from "../../../components/RockyMountainDogSponsorWidget.astro";
import productIndex from "../../../data/generated/rocky-mountain-dog-products.json";
import { breadcrumbSchema } from "../../../utils/content.js";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Resources", href: "/resources/" },
  { label: "Dog Gear Finder", href: "/resources/dog-gear-finder/" }
];

const products = productIndex.products.map((product) => ({
  title: product.title,
  category: product.category,
  sourceUrl: product.sourceUrl,
  image: product.image,
  caption: product.caption || `${product.title} by Rocky Mountain Dog`
}));

const totalProducts = products.length;
const featuredProducts = products
  .filter((product) => ["Harnesses & packs", "Leashes", "Safety & care", "Cleanup"].includes(product.category))
  .slice(0, 8);
---

<Layout
  title="Dog Gear Finder | LeashFree.ca"
  description="Find the best dog gear recommendations for your dog's lifestyle, activity level, and daily routine."
  canonical="https://leashfree.ca/resources/dog-gear-finder/"
  structuredData={breadcrumbSchema(breadcrumbs)}
>
  <section class="page-header">
    <div class="container detail-layout">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="eyebrow">Resources</div>
        <h1>Dog Gear Finder</h1>
        <p class="summary">
          Tell us about your dog and get practical gear recommendations for everyday walks and outdoor adventures.
        </p>
      </div>
      <ImageWithFallback src="/images/general/blog-category-dog-gear-card.jpg" alt="Dog gear finder" variant="hero" loading="eager" />
    </div>
  </section>

  <section class="section">
    <div class="container gear-finder-layout">
      <div class="gear-finder-main">
        <section class="gear-tool" aria-labelledby="gear-tool-heading">
          <div class="gear-tool-heading">
            <div>
              <p class="eyebrow">Gear matcher</p>
              <h2 id="gear-tool-heading">Build a walking kit</h2>
              <p class="summary">Match your dog's size, routine, and walking conditions to a practical gear setup.</p>
            </div>
            <div class="gear-index-count">
              <strong>{totalProducts}</strong>
              <span>sponsor products indexed</span>
            </div>
          </div>

          <form class="gear-form" data-gear-form>
            <label>
              Dog size
              <select name="size">
                <option value="medium">Medium dog</option>
                <option value="small">Small dog</option>
                <option value="large">Large dog</option>
                <option value="giant">Extra large dog</option>
              </select>
            </label>
            <label>
              Main routine
              <select name="routine">
                <option value="daily">Daily neighbourhood walks</option>
                <option value="trail">Hiking and trail days</option>
                <option value="park">Dog park and errands</option>
                <option value="travel">Travel and road trips</option>
                <option value="winter">Winter walks</option>
              </select>
            </label>
            <label>
              Walking challenge
              <select name="challenge">
                <option value="pulling">Pulling or extra control</option>
                <option value="mud">Mud, rain, or easy cleanup</option>
                <option value="low-light">Low-light visibility</option>
                <option value="hands-free">Hands-free walking</option>
                <option value="comfort">Comfort and simple handling</option>
              </select>
            </label>
            <label>
              Add-on priority
              <select name="priority">
                <option value="safety">Safety and care</option>
                <option value="cleanup">Cleanup kit</option>
                <option value="treats">Treats and enrichment</option>
                <option value="travel">Packable travel gear</option>
              </select>
            </label>
            <button class="button primary" type="submit">Find Gear</button>
          </form>

          <div class="gear-result" data-gear-result aria-live="polite"></div>
        </section>

        <section class="gear-content">
          <h2>How the Finder Chooses Gear</h2>
          <p>
            The matcher starts with a core walking setup: a harness or collar, a leash, and one supporting item for the
            conditions you selected. Trail and winter profiles lean toward more durable, outdoor-focused products;
            city and park profiles prioritize simple handling, cleanup, and visibility.
          </p>
          <p>
            Product matches are pulled from the current Rocky Mountain Dog sponsor index generated for LeashFree.ca.
            The recommendations are a starting point, not a substitute for measuring your dog and checking each product's
            sizing guidance before ordering.
          </p>

          <h2>Popular Starting Points</h2>
          <div class="gear-product-grid">
            {featuredProducts.map((product) => (
              <a class="gear-product-card" href={product.sourceUrl} target="_blank" rel="noopener sponsored">
                <span class="gear-card-media">
                  <img src={product.image} alt={product.caption} loading="lazy" />
                </span>
                <span>{product.category}</span>
                <strong>{product.title}</strong>
              </a>
            ))}
          </div>
        </section>
      </div>

      <aside class="gear-sidebar">
        <p class="sponsored-label">Sponsored</p>
        <RockyMountainDogSponsorWidget />
      </aside>
    </div>
  </section>
</Layout>

<script is:inline define:vars={{ products }}>
  (() => {
    const form = document.querySelector("[data-gear-form]");
    const result = document.querySelector("[data-gear-result]");
    if (!form || !result) return;

    const escapeHtml = (value) =>
      String(value || "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");

    const profileCopy = {
      daily: {
        title: "Everyday Walking Kit",
        intro: "A simple, dependable setup for neighbourhood routes, quick outings, and regular leash practice."
      },
      trail: {
        title: "Trail Ready Kit",
        intro: "A more rugged setup for uneven ground, longer outings, water stops, and outdoor handling."
      },
      park: {
        title: "Park and Errands Kit",
        intro: "A practical kit for car-to-park transitions, cleanup, and short controlled walks."
      },
      travel: {
        title: "Travel Day Kit",
        intro: "Packable gear for road trips, cabin weekends, and keeping essentials organized."
      },
      winter: {
        title: "Cold Weather Kit",
        intro: "A visibility and comfort-focused setup for short days, snow, slush, and colder walks."
      }
    };

    const productText = (product) => `${product.title} ${product.category} ${product.caption}`.toLowerCase();
    const hasAny = (text, terms) => terms.some((term) => text.includes(term));

    const scoreProduct = (product, values) => {
      const text = productText(product);
      let score = 0;
      const reasons = [];

      if (product.category === "Harnesses & packs") {
        score += 18;
        reasons.push("secure fit");
      }
      if (product.category === "Leashes") {
        score += 16;
        reasons.push("daily control");
      }
      if (values.challenge === "pulling" && product.category === "Harnesses & packs") {
        score += 20;
        reasons.push("pulling support");
      }
      if (values.challenge === "pulling" && hasAny(text, ["tactical", "all mountain", "biothane"])) {
        score += 12;
      }
      if (values.challenge === "mud" && hasAny(text, ["biothane", "waterproof", "poop", "waste", "cleanup"])) {
        score += 22;
        reasons.push("easy cleanup");
      }
      if (values.challenge === "low-light" && hasAny(text, ["led", "safety", "beacon", "reflect", "light"])) {
        score += 26;
        reasons.push("visibility");
      }
      if (values.challenge === "hands-free" && hasAny(text, ["hands-free", "fanny", "pack", "backpack"])) {
        score += 24;
        reasons.push("hands-free friendly");
      }
      if (values.challenge === "comfort" && hasAny(text, ["canmore", "paw", "rope", "collar", "harness"])) {
        score += 10;
        reasons.push("simple handling");
      }

      if (values.routine === "trail" && hasAny(text, ["mountain", "trail", "summit", "hiking", "collapsible", "bowl", "pack"])) {
        score += 20;
        reasons.push("trail use");
      }
      if (values.routine === "park" && ["Cleanup", "Leashes", "Collars"].includes(product.category)) {
        score += 14;
        reasons.push("park ready");
      }
      if (values.routine === "travel" && ["Beds & travel", "Adventure gear", "Safety & care"].includes(product.category)) {
        score += 18;
        reasons.push("travel friendly");
      }
      if (values.routine === "winter" && hasAny(text, ["parka", "winter", "snow", "paw", "nose", "safety", "led"])) {
        score += 22;
        reasons.push("cold weather");
      }

      if (values.priority === "safety" && product.category === "Safety & care") {
        score += 22;
        reasons.push("care item");
      }
      if (values.priority === "cleanup" && product.category === "Cleanup") {
        score += 26;
        reasons.push("cleanup");
      }
      if (values.priority === "treats" && ["Treats", "Toys"].includes(product.category)) {
        score += 24;
        reasons.push("enrichment");
      }
      if (values.priority === "travel" && ["Beds & travel", "Adventure gear"].includes(product.category)) {
        score += 18;
        reasons.push("portable");
      }

      if (values.size === "small" && hasAny(text, ["small", "extra small", "xs", "sky pack", "air 2"])) {
        score += 10;
      }
      if ((values.size === "large" || values.size === "giant") && hasAny(text, ["large", "extra large", "kolossus", "tactical", "summit"])) {
        score += 10;
      }

      return { product, score, reasons: [...new Set(reasons)].slice(0, 3) };
    };

    const uniqueByCategory = (matches) => {
      const selected = [];
      const categories = new Set();

      for (const match of matches) {
        if (!categories.has(match.product.category) || selected.length < 2) {
          selected.push(match);
          categories.add(match.product.category);
        }
        if (selected.length === 4) break;
      }

      return selected;
    };

    const renderProduct = ({ product, reasons }) => `
      <a class="gear-match-card" href="${escapeHtml(product.sourceUrl)}" target="_blank" rel="noopener sponsored">
        <span class="gear-card-media">
          <img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.caption)}" loading="lazy" />
        </span>
        <span class="gear-card-category">${escapeHtml(product.category)}</span>
        <strong>${escapeHtml(product.title)}</strong>
        ${reasons.length ? `<em>${reasons.map(escapeHtml).join(" + ")}</em>` : ""}
      </a>
    `;

    const buildResult = () => {
      const values = Object.fromEntries(new FormData(form).entries());
      const profile = profileCopy[values.routine] || profileCopy.daily;
      const matches = products
        .map((product) => scoreProduct(product, values))
        .filter((match) => match.score > 0)
        .sort((a, b) => b.score - a.score || a.product.title.localeCompare(b.product.title));
      const selected = uniqueByCategory(matches).slice(0, 4);

      result.innerHTML = `
        <div class="gear-result-heading">
          <div>
            <span>Recommended profile</span>
            <h2>${escapeHtml(profile.title)}</h2>
            <p>${escapeHtml(profile.intro)}</p>
          </div>
          <button class="button secondary" type="button" data-rmd-open>Browse All Gear</button>
        </div>
        <div class="gear-match-grid">
          ${selected.map(renderProduct).join("")}
        </div>
        <p class="gear-result-note">Sponsored recommendations from the current Rocky Mountain Dog product index. Confirm fit, size, and intended use on the product page.</p>
      `;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      buildResult();
    });

    buildResult();
  })();
</script>

<style>
  .gear-finder-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
    gap: var(--space-6);
    align-items: start;
  }
  .gear-finder-main,
  .gear-sidebar {
    display: grid;
    gap: var(--space-5);
    min-width: 0;
  }
  .gear-sidebar {
    position: sticky;
    top: calc(var(--space-6) + 72px);
    align-content: start;
  }
  .gear-tool {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background:
      linear-gradient(180deg, rgba(230, 241, 234, 0.84), rgba(255, 255, 255, 0.98) 38%),
      var(--color-surface);
    box-shadow: var(--shadow-card);
    padding: clamp(1rem, 2vw, 1.5rem);
  }
  .gear-tool-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: start;
    margin-bottom: var(--space-5);
  }
  .gear-tool-heading h2,
  .gear-result-heading h2 {
    margin-bottom: var(--space-2);
  }
  .gear-index-count {
    display: grid;
    justify-items: end;
    min-width: 130px;
    color: var(--color-primary-dark);
    line-height: 1.15;
    text-align: right;
  }
  .gear-index-count strong {
    font-size: 2rem;
    line-height: 1;
  }
  .gear-index-count span,
  .gear-result-heading span,
  .gear-match-card span,
  .gear-product-card span {
    color: var(--color-muted);
    font-size: 0.74rem;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }
  .gear-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }
  .gear-form label {
    display: grid;
    gap: 0.4rem;
    color: var(--color-primary-dark);
    font-size: 0.95rem;
    font-weight: 850;
  }
  .gear-form select {
    width: 100%;
    min-height: 42px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
    font-weight: 650;
    padding: 0.55rem 0.7rem;
  }
  .gear-form select:focus {
    border-color: var(--color-primary);
    outline: 3px solid rgba(73, 127, 100, 0.18);
    outline-offset: 0;
  }
  .gear-form .button {
    grid-column: 1 / -1;
  }
  .gear-result {
    margin-top: var(--space-4);
  }
  .gear-result-heading {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    align-items: start;
    border: 1px solid rgba(73, 127, 100, 0.24);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    padding: var(--space-3) var(--space-4);
  }
  .gear-result-heading p {
    margin-bottom: 0;
    color: var(--color-muted);
  }
  :global(.gear-match-grid),
  .gear-product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
  :global(.gear-match-grid) {
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
  }
  :global(.gear-match-card),
  .gear-product-card {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 0.2rem 0.65rem;
    align-items: center;
    min-height: 88px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    color: var(--color-text);
    overflow: hidden;
    padding: 0.65rem 0.7rem;
    text-decoration: none;
  }
  :global(.gear-match-card:hover),
  .gear-product-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 10px 24px rgba(49, 95, 73, 0.14);
    color: var(--color-text);
    transform: translateY(-1px);
  }
  .gear-card-media {
    grid-row: 1 / span 3;
    grid-column: 1;
    display: block;
    overflow: hidden;
    width: 64px;
    height: 64px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-primary-soft);
  }
  .gear-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  :global(.gear-match-card .gear-card-category),
  :global(.gear-match-card strong),
  :global(.gear-match-card em),
  .gear-product-card > span:not(.gear-card-media),
  .gear-product-card strong {
    grid-column: 2;
    min-width: 0;
  }
  :global(.gear-match-card strong),
  .gear-product-card strong {
    display: -webkit-box;
    overflow: hidden;
    font-size: 0.88rem;
    line-height: 1.2;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  :global(.gear-match-card em) {
    color: var(--color-primary-dark);
    font-size: 0.76rem;
    font-style: normal;
    font-weight: 850;
    line-height: 1.25;
  }
  :global(.gear-match-card) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    align-items: stretch;
    min-height: 0;
    padding: 0.6rem;
  }
  :global(.gear-match-card .gear-card-media) {
    grid-row: auto;
    grid-column: auto;
    display: block;
    width: 100%;
    height: auto;
    min-height: 96px;
    aspect-ratio: 4 / 3;
    flex-shrink: 0;
  }
  :global(.gear-match-card .gear-card-category),
  :global(.gear-match-card strong),
  :global(.gear-match-card em) {
    grid-column: auto;
    min-width: 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  :global(.gear-match-card strong) {
    font-size: 0.84rem;
    -webkit-line-clamp: 3;
  }
  :global(.gear-match-card em) {
    font-size: 0.72rem;
  }
  .gear-result-note {
    margin: var(--space-4) 0 0;
    color: var(--color-muted);
    font-size: 0.92rem;
  }
  .gear-content {
    max-width: 860px;
  }
  .gear-content h2 {
    margin-top: var(--space-5);
  }
  @media (max-width: 980px) {
    .gear-finder-layout {
      grid-template-columns: 1fr;
    }
    .gear-sidebar {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .gear-tool-heading,
    .gear-result-heading {
      display: grid;
    }
    .gear-index-count {
      justify-items: start;
      text-align: left;
    }
    .gear-form {
      grid-template-columns: 1fr;
    }
    :global(.gear-match-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 420px) {
    :global(.gear-match-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
