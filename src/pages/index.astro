---
import Card from "../components/Card.astro";
import Hero from "../components/Hero.astro";
import HomeBreedSearch from "../components/HomeBreedSearch.astro";
import HomeMapSearch from "../components/HomeMapSearch.astro";
import Layout from "../components/Layout.astro";
import Section from "../components/Section.astro";
import CTA from "../components/CTA.astro";
import { originalCityHeroImages, originalParkHeroImages } from "../data/dog-park-image-overrides.js";
import mediaMap from "../data/media-map.json";
import parks from "../data/generated/parks.json";
import cities from "../data/generated/cities.json";
import provinces from "../data/generated/provinces.json";
import breeds from "../data/generated/dog-breeds.json";
import directories from "../data/generated/directories.json";
import blogPosts from "../data/blog-posts.js";
import { excerpt, websiteSchema } from "../utils/content.js";
import { resolveMedia } from "../utils/media.js";
import { withoutRedirectedRecords } from "../utils/redirects.js";

const activeParks = withoutRedirectedRecords(parks);
const featuredCitySlugs = ["toronto", "vancouver", "calgary", "montreal"];
const featuredCities = featuredCitySlugs
  .map((slug) => cities.find((city) => city.slug === slug))
  .filter(Boolean);
const cityCardImage = (city) => originalCityHeroImages[city.slug] || resolveMedia(city, "Hero Image", mediaMap).src;
const parkCardImage = (park) => {
  const override = originalParkHeroImages[park.slug];
  if (override) return override;

  const resolved = resolveMedia(park, undefined, mediaMap);
  if (typeof resolved.status === "string" && resolved.status.startsWith("defaulted")) {
    const city = cities.find((cityItem) => cityItem.name === park.raw.City);
    if (city?.slug && originalCityHeroImages[city.slug]) return originalCityHeroImages[city.slug];
  }

  return resolved.src;
};

const parkActivityDate = (park) => {
  const rawDate = park.raw["Reviewed On"] || park.raw["Updated On"] || park.raw["Published On"];
  const timestamp = Date.parse(rawDate || "");
  return Number.isNaN(timestamp) ? 0 : timestamp;
};

const parkActivityLabel = (park) => {
  const reviewedOn = park.raw["Reviewed On"];
  const rawDate = reviewedOn || park.raw["Updated On"] || park.raw["Published On"];
  const timestamp = Date.parse(rawDate || "");
  if (Number.isNaN(timestamp)) return "";

  const date = new Intl.DateTimeFormat("en-CA", {
    month: "short",
    day: "numeric",
    year: "numeric",
    timeZone: "UTC"
  }).format(timestamp);

  return `${reviewedOn ? "Verified" : "Updated"} ${date}`;
};

const featuredParks = [...activeParks]
  .sort((a, b) => parkActivityDate(b) - parkActivityDate(a) || a.name.localeCompare(b.name))
  .slice(0, 6);
const homeHeroImage = "/images/home/leashfree-canada-dog-parks-hero-1600.jpg";
const homeHeroAlt = "Dogs walking off leash in a Toronto park with the city skyline, representing Canadian dog parks and LeashFree.ca resources";
const homeHeroSizes = "(min-width: 960px) 44vw, 100vw";
const homeHeroSrcset = [
  "/images/home/leashfree-canada-dog-parks-hero-800.jpg 800w",
  "/images/home/leashfree-canada-dog-parks-hero-1200.jpg 1200w",
  "/images/home/leashfree-canada-dog-parks-hero-1600.jpg 1600w"
].join(", ");
const homeHeroSourceSets = [
  {
    type: "image/avif",
    srcset: [
      "/images/home/leashfree-canada-dog-parks-hero-800.avif 800w",
      "/images/home/leashfree-canada-dog-parks-hero-1200.avif 1200w",
      "/images/home/leashfree-canada-dog-parks-hero-1600.avif 1600w"
    ].join(", ")
  },
  {
    type: "image/webp",
    srcset: [
      "/images/home/leashfree-canada-dog-parks-hero-800.webp 800w",
      "/images/home/leashfree-canada-dog-parks-hero-1200.webp 1200w",
      "/images/home/leashfree-canada-dog-parks-hero-1600.webp 1600w"
    ].join(", ")
  }
];

const resourceCards = [
  {
    title: "Dog Breed Match Quiz",
    href: "/resources/dog-breed-match-quiz/",
    description: `Get matched with breeds from our ${breeds.length}-profile dog breed library based on your home, routine, activity level, and preferences.`,
    image: "/images/blog/blog-dog-breed-match-quiz-hero.png",
    imageAlt: "Dog breed match quiz",
    ctaLabel: "Start quiz"
  },
  {
    title: "Dog Food Comparison Canada",
    href: "/dog-food-comparison-canada/",
    description: "Compare dog food products by label-based nutrition, ingredients, calories, and estimated cost for Canadian shoppers.",
    image: "/images/resources/dog-food-comparison-canada-hero-1600.jpg",
    imageAlt: "Dog food comparison tool",
    ctaLabel: "Compare food"
  },
  {
    title: "Dog Cost Calculator",
    href: "/resources/dog-cost-calculator-canada/",
    description: "Estimate monthly, first-year, annual, and lifetime dog ownership costs using transparent Canadian assumptions.",
    image: "/images/blog/blog-real-cost-of-owning-a-dog-canada-hero.png",
    imageAlt: "Dog ownership cost calculator",
    ctaLabel: "Estimate costs"
  },
  {
    title: "Dog Name Finder",
    href: "/dog-name-finder/",
    description: "Find personalized dog name ideas, then browse the Top 1,000 dog and puppy names for 2025.",
    image: "/images/blog/blog-trending-dog-names-2025-hero.jpg",
    imageAlt: "Dog name ideas",
    ctaLabel: "Find names"
  },
  {
    title: "Dog Services Directory",
    href: "/directory/",
    description: `Browse ${directories.length} Canadian dog service and pet resource listings, including rescues, clinics, stores, trainers, and groomers.`,
    image: "/images/general/directory-services-hero.png",
    imageAlt: "Dog services directory",
    ctaLabel: "Browse directory"
  },
  {
    title: "Dog Care Guides",
    href: "/blog/",
    description: `Read ${blogPosts.length} practical dog care articles covering behaviour, park etiquette, health costs, gear, names, breeds, and everyday ownership.`,
    image: "/images/general/blog-category-dog-gear-card.jpg",
    imageAlt: "Dog care guides",
    ctaLabel: "Read guides"
  }
];
---

<Layout
  title="LeashFree.ca | Dog Parks, Breeds, Tools & Dog Owner Resources in Canada"
  description="Find leash-free dog parks, compare dog breeds, use dog owner calculators, explore dog names, browse local pet services, and read Canadian dog care guides."
  canonical="https://leashfree.ca/"
  ogImage="/images/home/leashfree-canada-dog-parks-social.jpg"
  structuredData={websiteSchema()}
>
  <Hero
    eyebrow="Canadian dog owner resource hub"
    title="Dog Parks, Breeds, Tools & Resources for Canadian Dog Owners"
    summary="Find leash-free dog parks, compare dog breeds, browse local pet services, explore dog names, and use practical tools for life with your dog in Canada."
    primaryHref="/resources/"
    primaryLabel="Explore Dog Owner Tools"
    secondaryHref="/dog-parks/"
    secondaryLabel="Find Dog Parks Near You"
    image={homeHeroImage}
    imageAlt={homeHeroAlt}
    imageWidth={1600}
    imageHeight={900}
    imageSizes={homeHeroSizes}
    imageSrcset={homeHeroSrcset}
    imageSourceSets={homeHeroSourceSets}
    imageFetchPriority="high"
  />

  <Section
    title="Everything Canadian dog owners need in one starting point"
    intro="LeashFree.ca helps dog owners across Canada discover safe places to play, research breeds, estimate care costs, compare food, choose names, find local services, and read practical dog care guidance. The map is still here when you need a place to go, and the rest of the site helps with the decisions that come before and after the walk."
  />

  <Section
    title="Find dog-friendly places near you"
    intro="Search leash-free parks and local pet services across Canada, or switch to the breed finder when you are researching the right dog for your home."
  >
    <div class="home-search-tabs" data-home-search-tabs>
      <div class="home-search-tablist" role="tablist" aria-label="Homepage search tools">
        <button id="home-search-map-tab" class="home-search-tab is-active" type="button" role="tab" aria-selected="true" aria-controls="home-search-map-panel" data-search-tab="map">
          Map search
        </button>
        <button id="home-search-breeds-tab" class="home-search-tab" type="button" role="tab" aria-selected="false" aria-controls="home-search-breeds-panel" data-search-tab="breeds">
          Dog breed search
        </button>
      </div>

      <div id="home-search-map-panel" role="tabpanel" aria-labelledby="home-search-map-tab" data-search-panel="map">
        <HomeMapSearch />
      </div>

      <div id="home-search-breeds-panel" role="tabpanel" aria-labelledby="home-search-breeds-tab" data-search-panel="breeds" hidden>
        <HomeBreedSearch />
      </div>
    </div>
  </Section>

  <Section
    title="Dog owner tools and resources"
    intro="Use LeashFree.ca for the practical dog ownership questions that go beyond finding a park."
    alt
  >
    <div class="grid">
      {resourceCards.map((card) => (
        <Card
          title={card.title}
          href={card.href}
          description={card.description}
          image={card.image}
          imageAlt={card.imageAlt}
          ctaLabel={card.ctaLabel}
        />
      ))}
    </div>
  </Section>

  <Section
    title="Explore dog breeds, names, and care topics"
    intro="Start with the research path that fits your next decision, whether you are choosing a breed, naming a puppy, planning expenses, or learning everyday care."
  >
    <div class="grid">
      <Card
        title="Explore Dog Breeds"
        href="/dog-breeds/"
        description={`Compare ${breeds.length} breed profiles by size, activity level, grooming needs, temperament, family fit, trainability, and care requirements.`}
        image="/images/general/blog-category-dog-breeds-card.avif"
        imageAlt="Dog breed profiles"
        ctaLabel="Browse breeds"
      />
      <Card
        title="Browse Dog Names"
        href="/dog-names/"
        description="Search popular, cute, unique, strong, nature-inspired, colour-inspired, Canadian-inspired, and breed-specific dog name ideas."
        image="/images/blog/blog-trending-dog-names-2025-hero.jpg"
        imageAlt="Popular dog names"
        ctaLabel="Browse names"
      />
      <Card
        title="Use Dog Calculators"
        href="/resources/"
        description="Open calculators and tools for calories, ownership costs, breed matching, food comparison, names, and dog gear decisions."
        image="/images/general/category-pet-stores-and-boutiques-hero.jpg"
        imageAlt="Dog owner calculators and tools"
        ctaLabel="View tools"
      />
      <Card
        title="Read Dog Care Guides"
        href="/blog/"
        description="Learn from practical Canadian articles about behaviour, training, park safety, seasonal care, health costs, gear, food, and breed fit."
        image="/images/blog/blog-how-to-socialize-your-puppy-hero.jpg"
        imageAlt="Dog care article library"
        ctaLabel="Read articles"
      />
    </div>
  </Section>

  <Section
    title="Find off-leash dog parks across Canada"
    intro={`Browse ${activeParks.length} dog park pages, city guides, and province guides, including our most recently added and verified local information.`}
    alt
  >
    <div class="grid compact">
      {provinces.map((province) => (
        <Card
          title={province.name}
          href={`/dog-parks/${province.slug}/`}
          description={`Find city and dog park pages in ${province.name}.`}
          ctaLabel="View province"
        />
      ))}
    </div>

    <div class="grid">
      {featuredCities.map((city) => (
        <Card
          title={`${city.name} dog parks`}
          href={`/dog-parks/${city.slug}/`}
          description={excerpt(city.description, city.metaDescription)}
          image={cityCardImage(city)}
          imageAlt={`${city.name} dog park guide`}
          badges={[city.raw.Province].filter(Boolean)}
          ctaLabel="View city"
        />
      ))}
      {featuredParks.map((park) => (
        <Card
          title={park.name}
          href={`/dog-parks/${park.slug}/`}
          description={excerpt(park.description, park.raw["Street Address"])}
          image={parkCardImage(park)}
          imageAlt={`${park.name} dog park`}
          meta={[
            [park.raw.City, park.raw.Province].filter(Boolean).join(", "),
            parkActivityLabel(park)
          ].filter(Boolean).join(" · ")}
          ctaLabel="View park"
        />
      ))}
    </div>
  </Section>

  <Section title="Start with the tool you need" intro="Use the map when you are heading out, or jump into breed research, dog names, food comparison, cost planning, and care guides when you are making ownership decisions.">
    <CTA
      title="Choose the right next step for you and your dog"
      text="LeashFree.ca brings Canadian dog parks, breed research, pet service listings, calculators, dog names, food comparison, and care guides into one practical starting point."
      primaryHref="/resources/"
      primaryLabel="Explore dog owner tools"
      secondaryHref="/dog-parks/"
      secondaryLabel="Find dog parks"
    />
  </Section>
</Layout>

<script is:inline>
  (() => {
    const root = document.querySelector("[data-home-search-tabs]");
    if (!root) return;

    const tabs = Array.from(root.querySelectorAll("[data-search-tab]"));
    const panels = Array.from(root.querySelectorAll("[data-search-panel]"));

    const activate = (name) => {
      for (const tab of tabs) {
        const isActive = tab.dataset.searchTab === name;
        tab.classList.toggle("is-active", isActive);
        tab.setAttribute("aria-selected", isActive ? "true" : "false");
      }

      for (const panel of panels) {
        panel.hidden = panel.dataset.searchPanel !== name;
      }

      window.dispatchEvent(new Event("resize"));
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => activate(tab.dataset.searchTab));
    }
  })();
</script>
