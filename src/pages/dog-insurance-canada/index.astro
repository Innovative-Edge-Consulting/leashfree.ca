---
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";
import ImageWithFallback from "../../components/ImageWithFallback.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import providers from "../../data/generated/pet-insurance-providers.json";
import { breadcrumbSchema, cleanText } from "../../utils/content.js";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Dog Insurance Canada", href: "/dog-insurance-canada/" }
];

const text = (value) => cleanText(value) || "Confirm with provider";
const sortedProviders = [...providers].sort((a, b) => Number(a.raw?.DisplayRank || 999) - Number(b.raw?.DisplayRank || 999));
const verificationDates = sortedProviders.map((provider) => new Date(provider.raw?.LastVerified)).filter((date) => !Number.isNaN(date.valueOf()));
const latestVerification = verificationDates.length
  ? new Intl.DateTimeFormat("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" }).format(new Date(Math.max(...verificationDates.map((date) => date.valueOf()))))
  : "Check provider sources";

const providerFacts = sortedProviders.map((provider) => {
  const raw = provider.raw || {};
  const planTypes = text(raw.PlanTypes);
  const reimbursement = text(raw.ReimbursementPercents);
  const annualLimit = text(raw.AnnualLimit);
  const availability = text(raw.ProvincesAvailable);
  return {
    name: text(provider.name),
    slug: provider.slug,
    planTypes,
    annualLimit,
    reimbursement,
    deductible: text(raw.DeductibleOptions),
    accidentWait: text(raw.WaitingPeriodAccident),
    illnessWait: text(raw.WaitingPeriodIllness),
    availability,
    sourceUrl: raw.SourceURL,
    hasUnlimited: annualLimit.toLowerCase().includes("unlimited"),
    hasNinety: reimbursement.includes("90%"),
    hasAccidentOnly: planTypes.toLowerCase().includes("accident-only"),
    hasWellness: /wellness|preventive/i.test(planTypes),
    monogram: text(provider.name).split(/\s+/).map((word) => word[0]).join("").slice(0, 2).toUpperCase()
  };
});

const faqs = [
  { question: "Is there one best dog insurance provider in Canada?", answer: "No single provider is best for every dog or household. Availability, age limits, exclusions, deductible structure, reimbursement, annual limits, and price all affect fit. Compare policy wording and personalized quotes before enrolling." },
  { question: "Does pet insurance cover pre-existing conditions?", answer: "Most policies exclude conditions that began or showed signs before coverage, although definitions and treatment of temporary conditions vary. Read the provider's policy wording for the exact definition." },
  { question: "Why are monthly prices not shown?", answer: "Premiums are personalized using factors such as your dog's age, breed, postal code, selected deductible, reimbursement, and coverage limit. A single advertised price would not be a reliable comparison." },
  { question: "What is a waiting period?", answer: "A waiting period is the time after enrollment before coverage for certain accidents, illnesses, or conditions begins. Different waiting periods can apply to different categories of care." }
];

const structuredData = [
  breadcrumbSchema(breadcrumbs),
  { "@context": "https://schema.org", "@type": "ItemList", name: "Dog insurance providers in Canada", itemListElement: providerFacts.map((provider, index) => ({ "@type": "ListItem", position: index + 1, name: provider.name, url: `https://leashfree.ca/dog-insurance-canada/${provider.slug}/` })) },
  { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((faq) => ({ "@type": "Question", name: faq.question, acceptedAnswer: { "@type": "Answer", text: faq.answer } })) }
];
---

<Layout
  title="Dog Insurance Canada: Compare Pet Insurance Providers | LeashFree.ca"
  description="Compare Canadian dog insurance providers by coverage, annual limit, reimbursement, deductible structure, waiting periods, and availability."
  canonical="https://leashfree.ca/dog-insurance-canada/"
  structuredData={structuredData}
>
  <section class="page-header insurance-hero">
    <div class="container insurance-hero-grid">
      <div>
        <Breadcrumbs items={breadcrumbs} />
        <div class="eyebrow">Independent Canadian comparison</div>
        <h1>Compare dog insurance with confidence</h1>
        <p class="summary">Review coverage limits, reimbursement, deductibles, waiting periods, and availability across Canadian providers.</p>
        <div class="button-row">
          <a class="button primary" href="#compare-providers">Compare providers</a>
          <a class="button secondary" href="/blog/pet-insurance-canada-dog-owners-guide/">Learn how insurance works</a>
        </div>
      </div>
      <figure class="insurance-hero-media">
        <ImageWithFallback
          src="/images/blog/blog-dog-insurance-waiting-periods-canada-hero.jpg"
          alt="A Canadian dog owner discussing her dog's care with a veterinarian"
          variant="hero"
          loading="eager"
          fetchPriority="high"
          width={913}
          height={609}
          sizes="(max-width: 820px) calc(100vw - 32px), 44vw"
          imagePosition="center"
        />
        <figcaption><span aria-hidden="true">🛡️</span> Compare coverage before you need to make a claim.</figcaption>
      </figure>
    </div>
  </section>

  <div class="editorial-strip">
    <div class="container editorial-grid">
      <span><strong>8 providers</strong> reviewed</span>
      <span><strong>Last verified</strong> {latestVerification}</span>
      <span><strong>Neutral order</strong> — not a ranking</span>
      <span><strong>Source-linked</strong> policy facts</span>
    </div>
  </div>

  <Section eyebrow="Insurance basics" title="Understand the policy before the price" intro="A lower premium is not always better value. Compare these features together.">
    <div class="concept-grid">
      <article><span>01</span><h3>Coverage</h3><p>Check accidents, illnesses, dental care, medication, exam fees, rehabilitation, and exclusions.</p></article>
      <article><span>02</span><h3>Annual limit</h3><p>The maximum the insurer may reimburse during a policy year. Some plans offer unlimited coverage.</p></article>
      <article><span>03</span><h3>Reimbursement</h3><p>The percentage of eligible costs paid after the applicable deductible and policy adjustments.</p></article>
      <article><span>04</span><h3>Deductible</h3><p>Confirm whether it applies annually, per condition, or on another schedule—and whether it changes with age.</p></article>
    </div>
  </Section>

  <Section id="compare-providers" alt eyebrow="Comparison tool" title="Compare Canadian providers" intro="Filter the research below, then open a provider profile for exclusions, claims notes, source links, and more.">
    <div class="comparison-controls" aria-label="Filter insurance providers">
      <label><span>Show providers with</span><select id="feature-filter"><option value="all">All policy features</option><option value="unlimited">Unlimited annual limit</option><option value="ninety">Up to 90% reimbursement</option><option value="accident">Accident-only option</option><option value="wellness">Wellness or preventive option</option></select></label>
      <label><span>Sort by</span><select id="provider-sort"><option value="default">Editorial order</option><option value="name">Provider name</option><option value="reimbursement">Reimbursement</option></select></label>
      <button class="button secondary comparison-reset" id="comparison-reset" type="button">Reset filters</button>
    </div>
    <div class="comparison-status" id="comparison-status" role="status">Showing all {providerFacts.length} providers</div>

    <div class="comparison-table-wrap">
      <table class="comparison-table">
        <thead><tr><th scope="col">Provider</th><th scope="col">Coverage</th><th scope="col">Annual limit</th><th scope="col">Reimbursement</th><th scope="col">Deductible</th><th scope="col">Waiting periods</th><th scope="col">Details</th></tr></thead>
        <tbody id="provider-table-body">
          {providerFacts.map((provider, index) => (
            <tr data-provider-row data-index={index} data-name={provider.name} data-reimbursement={provider.reimbursement} data-unlimited={String(provider.hasUnlimited)} data-ninety={String(provider.hasNinety)} data-accident={String(provider.hasAccidentOnly)} data-wellness={String(provider.hasWellness)}>
              <th scope="row"><span class="provider-name"><span class="provider-mark" aria-hidden="true">{provider.monogram}</span><span><a href={`/dog-insurance-canada/${provider.slug}/`}>{provider.name}</a><small>{provider.availability}</small></span></span></th>
              <td>{provider.planTypes}</td><td>{provider.annualLimit}</td><td><strong>{provider.reimbursement}</strong></td><td>{provider.deductible}</td><td><span class="waiting-facts"><span><small>Accident</small>{provider.accidentWait}</span><span><small>Illness</small>{provider.illnessWait}</span></span></td>
              <td><a class="details-link" href={`/dog-insurance-canada/${provider.slug}/`}>Details <span aria-hidden="true">→</span></a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="provider-card-list" id="provider-card-list">
      {providerFacts.map((provider, index) => (
        <article class="provider-card" data-provider-card data-index={index} data-name={provider.name} data-reimbursement={provider.reimbursement} data-unlimited={String(provider.hasUnlimited)} data-ninety={String(provider.hasNinety)} data-accident={String(provider.hasAccidentOnly)} data-wellness={String(provider.hasWellness)}>
          <div class="provider-card-head"><span class="provider-mark" aria-hidden="true">{provider.monogram}</span><div><h3><a href={`/dog-insurance-canada/${provider.slug}/`}>{provider.name}</a></h3><span>{provider.availability}</span></div></div>
          <dl><div><dt>Coverage</dt><dd>{provider.planTypes}</dd></div><div><dt>Annual limit</dt><dd>{provider.annualLimit}</dd></div><div><dt>Reimbursement</dt><dd>{provider.reimbursement}</dd></div><div><dt>Deductible</dt><dd>{provider.deductible}</dd></div><div><dt>Accident wait</dt><dd>{provider.accidentWait}</dd></div><div><dt>Illness wait</dt><dd>{provider.illnessWait}</dd></div></dl>
          <a class="button secondary" href={`/dog-insurance-canada/${provider.slug}/`}>Review {provider.name}</a>
        </article>
      ))}
    </div>
    <p class="comparison-note">Policy information can change. Confirm current wording, exclusions, eligibility, pricing, and waiting periods directly with the provider. Display order is not a recommendation or ranking.</p>
  </Section>

  <Section eyebrow="Quick decision guide" title="Match policy features to your priorities" intro="These are starting points—not provider recommendations.">
    <div class="scenario-grid">
      <article><span aria-hidden="true">🐶</span><h3>New puppy</h3><p>Look closely at illness waiting periods, hereditary-condition wording, exam fees, and how future bilateral conditions are handled.</p></article>
      <article><span aria-hidden="true">🏔️</span><h3>Active or adventurous dog</h3><p>Prioritize strong accident coverage, imaging, rehabilitation, annual limits, and a deductible you could manage during an emergency.</p></article>
      <article><span aria-hidden="true">💰</span><h3>Budget-first household</h3><p>Compare accident-only options, lower reimbursement choices, and higher deductibles—but test the out-of-pocket impact first.</p></article>
    </div>
  </Section>

  <Section alt eyebrow="See the math" title="How reimbursement can affect your bill">
    <div class="math-layout">
      <div class="math-card"><div><span>Eligible veterinary bill</span><strong>$5,000</strong></div><div><span>Less example deductible</span><strong>− $300</strong></div><div><span>Amount used for calculation</span><strong>$4,700</strong></div><div class="math-highlight"><span>Example insurer payment at 80%</span><strong>$3,760</strong></div><div><span>Estimated amount you pay</span><strong>$1,240</strong></div></div>
      <div><h3>This example is intentionally simple</h3><p>Actual payments depend on eligible expenses, policy limits, coinsurance, taxes, exam-fee coverage, deductible structure, and exclusions.</p><p>Use it to understand the relationship between a deductible and reimbursement—not to predict a claim payment.</p><a class="button secondary" href="/blog/is-dog-insurance-worth-it-canada/">Explore whether insurance is worth it</a></div>
    </div>
  </Section>

  <Section eyebrow="Before enrolling" title="Read beyond the headline coverage">
    <div class="check-grid">
      <article><h3>Coverage and exclusions</h3><p>Review pre-existing, hereditary, dental, orthopedic, behavioural, bilateral, and preventive-care wording.</p></article>
      <article><h3>Limits and reimbursement</h3><p>Compare annual and condition limits together with reimbursement percentages and eligible-expense definitions.</p></article>
      <article><h3>Deductible structure</h3><p>Determine when the deductible resets, whether it applies per condition, and whether age changes the amount.</p></article>
      <article><h3>Claims and payment</h3><p>Ask about processing timelines, required records, direct-to-vet payment, appeals, and renewal changes.</p></article>
    </div>
  </Section>

  <Section alt eyebrow="Keep researching" title="Canadian dog insurance guides">
    <div class="grid insurance-guide-grid">
      <Card
        title="How pet insurance works in Canada"
        href="/blog/pet-insurance-canada-dog-owners-guide/"
        description="Start with the key terms, tradeoffs, and questions to ask before buying."
        image="/images/blog/blog-is-dog-insurance-worth-it-canada-hero.jpg"
        imageAlt="Dog owner and veterinarian discussing pet insurance in Canada"
        imageLabel="Buyer guide"
        ctaLabel="Read article"
      />
      <Card
        title="Dog insurance waiting periods explained"
        href="/blog/dog-insurance-waiting-periods-canada/"
        description="Understand when accident, illness, and orthopedic coverage can begin."
        image="/images/blog/blog-dog-insurance-waiting-periods-canada-hero.jpg"
        imageAlt="Dog owner discussing insurance waiting periods with a veterinarian"
        imageLabel="Policy details"
        ctaLabel="Read article"
      />
      <Card
        title="Unlimited versus $10,000 annual limits"
        href="/blog/unlimited-vs-10000-annual-limit/"
        description="Compare catastrophic protection, annual caps, and premium tradeoffs."
        image="/images/blog/blog-unlimited-vs-10000-annual-limit-hero.jpg"
        imageAlt="Dog insurance annual limit comparison"
        imageLabel="Coverage limits"
        ctaLabel="Read article"
      />
      <Card
        title="Estimate your total dog costs"
        href="/resources/dog-cost-calculator-canada/"
        description="Put insurance into a broader Canadian dog-ownership budget."
        image="/images/resources/dog-cost-calculator-hero.png"
        imageAlt="Dog cost calculator for Canadian owners"
        imageLabel="Planning tool"
        ctaLabel="Open calculator"
      />
    </div>
  </Section>

  <Section eyebrow="Common questions" title="Dog insurance FAQ">
    <div class="faq-list">{faqs.map((faq) => <details><summary>{faq.question}</summary><p>{faq.answer}</p></details>)}</div>
  </Section>

  <script is:inline>
    const featureFilter = document.querySelector("#feature-filter");
    const providerSort = document.querySelector("#provider-sort");
    const comparisonReset = document.querySelector("#comparison-reset");
    const comparisonStatus = document.querySelector("#comparison-status");
    const tableBody = document.querySelector("#provider-table-body");
    const cardList = document.querySelector("#provider-card-list");
    const matchesFeature = (element, feature) => feature === "all" || element.dataset[feature] === "true";
    const sortItems = (items, sort) => items.sort((a, b) => {
      if (sort === "name") return a.dataset.name.localeCompare(b.dataset.name);
      if (sort === "reimbursement") return (parseInt(b.dataset.reimbursement) || 0) - (parseInt(a.dataset.reimbursement) || 0);
      return Number(a.dataset.index) - Number(b.dataset.index);
    });
    const updateComparison = () => {
      const feature = featureFilter.value;
      const sort = providerSort.value;
      const rows = sortItems([...document.querySelectorAll("[data-provider-row]")], sort);
      const cards = sortItems([...document.querySelectorAll("[data-provider-card]")], sort);
      rows.forEach((row) => { row.hidden = !matchesFeature(row, feature); tableBody.append(row); });
      cards.forEach((card) => { card.hidden = !matchesFeature(card, feature); cardList.append(card); });
      const count = rows.filter((row) => !row.hidden).length;
      comparisonStatus.textContent = `Showing ${count} provider${count === 1 ? "" : "s"}`;
    };
    featureFilter?.addEventListener("change", updateComparison);
    providerSort?.addEventListener("change", updateComparison);
    comparisonReset?.addEventListener("click", () => { featureFilter.value = "all"; providerSort.value = "default"; updateComparison(); });
  </script>
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .insurance-hero { padding-bottom: var(--space-7); }
  .insurance-hero-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(330px, .8fr); gap: var(--space-7); align-items: center; }
  .insurance-hero .summary { max-width: 680px; }
  .insurance-hero-media { position: relative; overflow: hidden; margin: 0; border: 1px solid rgba(73,127,100,.2); border-radius: 22px; background: var(--color-primary-soft); box-shadow: 0 18px 42px rgba(31,41,51,.16); }
  .insurance-hero-media :global(.hero-media) { width: 100%; min-height: 390px; aspect-ratio: 3 / 2; object-fit: cover; }
  .insurance-hero-media figcaption { position: absolute; right: var(--space-4); bottom: var(--space-4); left: var(--space-4); display: flex; align-items: center; gap: .55rem; border: 1px solid rgba(255,255,255,.72); border-radius: 12px; background: rgba(255,255,255,.9); color: var(--color-text); padding: .7rem .85rem; box-shadow: 0 8px 24px rgba(31,41,51,.14); backdrop-filter: blur(10px); font-size: .82rem; font-weight: 850; }
  .editorial-strip { border-block: 1px solid var(--color-border); background: var(--color-surface); }
  .editorial-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .editorial-grid span { padding: 1rem; color: var(--color-muted); text-align: center; }
  .editorial-grid span + span { border-left: 1px solid var(--color-border); }
  .editorial-grid strong { color: var(--color-primary-dark); }
  .concept-grid, .check-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-4); margin-top: var(--space-5); }
  .concept-grid article, .check-grid article { border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); padding: var(--space-5); }
  .concept-grid article > span { color: var(--color-primary); font-size: .8rem; font-weight: 950; }
  .concept-grid h3, .check-grid h3 { margin-top: var(--space-3); }
  .concept-grid p, .check-grid p { margin: 0; color: var(--color-muted); font-size: .94rem; }
  .comparison-controls { display: grid; grid-template-columns: minmax(220px, 1fr) minmax(190px, .65fr) auto; gap: var(--space-3); align-items: end; margin-top: var(--space-5); border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); padding: var(--space-4); }
  .comparison-controls label { display: grid; gap: .35rem; color: var(--color-muted); font-size: .8rem; font-weight: 850; }
  .comparison-controls select { width: 100%; min-height: 46px; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #fff; color: var(--color-text); padding: .65rem .8rem; font: 750 .92rem var(--font-sans); }
  .comparison-reset { cursor: pointer; font: 850 .9rem var(--font-sans); }
  .comparison-status { margin: var(--space-3) 0; color: var(--color-muted); font-size: .86rem; font-weight: 800; }
  .comparison-table-wrap { overflow-x: auto; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: var(--color-surface); box-shadow: 0 8px 24px rgba(31,41,51,.05); }
  .comparison-table { width: 100%; min-width: 1240px; border-collapse: separate; border-spacing: 0; font-size: .82rem; line-height: 1.45; }
  .comparison-table th, .comparison-table td { border-bottom: 1px solid var(--color-border); padding: var(--space-4); text-align: left; vertical-align: top; }
  .comparison-table thead th { background: var(--color-primary-dark); color: #fff; font-size: .75rem; letter-spacing: .03em; vertical-align: middle; text-transform: uppercase; }
  .comparison-table thead th:first-child { border-top-left-radius: calc(var(--radius-card) - 1px); }
  .comparison-table thead th:last-child { border-top-right-radius: calc(var(--radius-card) - 1px); }
  .comparison-table tbody tr:last-child > * { border-bottom: 0; }
  .comparison-table tbody tr:hover > * { background: #f5f9f6; }
  .comparison-table tbody th { width: 190px; background: #fbfdfb; }
  .provider-name { display: flex; align-items: flex-start; gap: var(--space-3); }
  .provider-name a, .provider-card-head h3 a { color: var(--color-text); text-decoration-color: rgba(73,127,100,.45); text-decoration-thickness: 2px; text-underline-offset: .18em; }
  .provider-name a:hover, .provider-card-head h3 a:hover { color: var(--color-primary-dark); text-decoration-color: currentColor; }
  .provider-name a:focus-visible, .provider-card-head h3 a:focus-visible { border-radius: 3px; outline: 3px solid rgba(73,127,100,.28); outline-offset: 3px; }
  .provider-name small { display: block; margin-top: .25rem; color: var(--color-muted); font-weight: 650; }
  .provider-mark { display: grid; place-items: center; width: 42px; height: 42px; flex: 0 0 auto; border-radius: 12px; background: var(--color-primary-soft); color: var(--color-primary-dark); font-size: .78rem; font-weight: 950; }
  .waiting-facts { display: grid; gap: .55rem; }
  .waiting-facts small { display: block; color: var(--color-primary-dark); font-weight: 900; text-transform: uppercase; }
  .details-link { font-weight: 900; white-space: nowrap; }
  [hidden] { display: none !important; }
  .provider-card-list { display: none; }
  .comparison-note { margin: var(--space-4) 0 0; color: var(--color-muted); font-size: .82rem; }
  .scenario-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-4); margin-top: var(--space-5); }
  .scenario-grid article { border: 1px solid rgba(73,127,100,.22); border-radius: var(--radius-card); background: linear-gradient(145deg, #fff, var(--color-primary-soft)); padding: var(--space-5); }
  .scenario-grid article > span { font-size: 1.8rem; }
  .scenario-grid h3 { margin-top: var(--space-3); }
  .scenario-grid p { margin: 0; color: var(--color-muted); }
  .math-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr); gap: var(--space-7); align-items: center; }
  .math-card { overflow: hidden; border: 1px solid var(--color-border); border-radius: var(--radius-card); background: #fff; box-shadow: var(--shadow-card); }
  .math-card > div { display: flex; justify-content: space-between; gap: var(--space-4); border-bottom: 1px solid var(--color-border); padding: .9rem var(--space-5); }
  .math-card > div:last-child { border-bottom: 0; }
  .math-card span { color: var(--color-muted); }
  .math-highlight { background: var(--color-primary-soft); color: var(--color-primary-dark); }
  .math-highlight span { color: var(--color-primary-dark); font-weight: 850; }
  .insurance-guide-grid { margin-top: var(--space-5); }
  .insurance-guide-grid :global(.card) { height: 100%; }
  .faq-list { display: grid; gap: var(--space-3); max-width: 900px; margin-top: var(--space-5); }
  .faq-list details { border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: #fff; padding: var(--space-4) var(--space-5); }
  .faq-list summary { cursor: pointer; font-weight: 900; }
  .faq-list p { margin: var(--space-3) 0 0; color: var(--color-muted); }

  @media (max-width: 980px) {
    .concept-grid, .check-grid { grid-template-columns: repeat(2, 1fr); }
    .editorial-grid { grid-template-columns: repeat(2, 1fr); }
    .editorial-grid span:nth-child(3) { border-top: 1px solid var(--color-border); border-left: 0; }
    .editorial-grid span:nth-child(4) { border-top: 1px solid var(--color-border); }
  }
  @media (max-width: 820px) {
    .insurance-hero-grid, .math-layout { grid-template-columns: 1fr; }
    .comparison-controls { grid-template-columns: 1fr 1fr; }
    .comparison-reset { grid-column: 1 / -1; }
    .comparison-table-wrap { display: none; }
    .provider-card-list { display: grid; gap: var(--space-4); }
    .provider-card { border: 1px solid var(--color-border); border-radius: var(--radius-card); background: #fff; padding: var(--space-5); }
    .provider-card-head { display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4); }
    .provider-card-head h3 { margin: 0; }
    .provider-card-head div > span { color: var(--color-muted); font-size: .84rem; }
    .provider-card dl { margin: 0 0 var(--space-4); }
    .provider-card dl div { display: grid; grid-template-columns: minmax(100px, .45fr) 1fr; gap: var(--space-3); border-top: 1px solid var(--color-border); padding: .68rem 0; }
    .provider-card dt { color: var(--color-primary-dark); font-size: .8rem; font-weight: 900; }
    .provider-card dd { margin: 0; color: var(--color-muted); }
    .provider-card .button { width: 100%; }
