---
import CTA from "../components/CTA.astro";
import Layout from "../components/Layout.astro";
import Section from "../components/Section.astro";

const quickLinks = [
  { href: "/dog-parks/", label: "Dog parks by city and province" },
  { href: "/dog-breeds/", label: "Dog breed profiles" },
  { href: "/dog-breeds/", label: "Breed groups" },
  { href: "/dog-names/", label: "Dog name ideas" },
  { href: "/resources/", label: "Resources and tools" },
  { href: "/blog/", label: "Blog articles" },
  { href: "/directory/", label: "Business directory" }
];
---

<Layout title="Page Not Found" description="The requested LeashFree.ca page was not found." canonical="https://leashfree.ca/404/">
  <section class="page-header">
    <div class="container narrow">
      <div class="eyebrow">404</div>
      <h1>Page not found</h1>
      <p class="summary">This URL may have moved after our site migration. Use one of the quick links below to continue.</p>
      <div class="button-row">
        <a class="button primary" href="/dog-parks/">Find dog parks</a>
        <a class="button secondary" href="/dog-breeds/">Browse breeds</a>
        <a class="button secondary" href="/">Go home</a>
      </div>
    </div>
  </section>

  <Section title="Popular paths">
    <ul class="not-found-links">
      {quickLinks.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
    </ul>
  </Section>

  <Section>
    <CTA
      title="Keep exploring LeashFree.ca"
      text="Browse dog park guides, dog breed profiles, and practical articles for Canadian dog owners."
      primaryHref="/dog-breeds/"
      primaryLabel="Browse dog breeds"
      secondaryHref="/blog/"
      secondaryLabel="Read the blog"
    />
  </Section>
</Layout>

<style>
  .not-found-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .not-found-links a {
    display: block;
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 700;
  }

  .not-found-links a:hover {
    border-color: var(--color-primary);
  }
 </style>
