---
import Card from "../../components/Card.astro";
import BusinessDirectorySearch from "../../components/BusinessDirectorySearch.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import mediaMap from "../../data/media-map.json";
import directories from "../../data/generated/directories.json";
import { excerpt, breadcrumbSchema } from "../../utils/content.js";
import {
  DIRECTORY_CATEGORY_LABELS,
  directoryCategory,
  directoryCategoryCopy,
  directoryCategoryPath
} from "../../utils/directory.js";
import { resolveMedia } from "../../utils/media.js";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Directory", href: "/directory/" }
];

const activeCategoryPaths = new Set([
  "/directory/animal-shelters-and-rescues/",
  "/directory/veterinarians/"
]);
const categoryCounts = directories.reduce((counts, item) => {
  const category = directoryCategory(item);
  if (!category) return counts;
  counts.set(category, (counts.get(category) || 0) + 1);
  return counts;
}, new Map());
const categories = Object.keys(DIRECTORY_CATEGORY_LABELS).map((slug) => {
  const copy = directoryCategoryCopy(slug);
  const count = categoryCounts.get(slug) || 0;
  const href = directoryCategoryPath(slug);
  return {
    slug,
    title: DIRECTORY_CATEGORY_LABELS[slug],
    href: activeCategoryPaths.has(href) ? href : "#add-business",
    image: copy.image,
    summary: copy.summary,
    count,
    status: count > 0 ? `${count} listings` : "Coming soon",
    cta: activeCategoryPaths.has(href) ? "Browse category" : "Add a business"
  };
});
---

<Layout
  title="Dog Services Directory"
  description="Browse LeashFree.ca directory listings for dog services and pet resources."
  canonical="https://leashfree.ca/directory/"
  structuredData={breadcrumbSchema(breadcrumbs)}
>
  <Hero
    eyebrow="Directory"
    title="Dog services and pet resources"
    summary="Find rescues, clinics, pet stores, trainers, groomers, and other dog-related services."
    primaryHref="#listings"
    primaryLabel="Browse listings"
    secondaryHref="#add-business"
    secondaryLabel="Add a Business"
    image="/images/general/directory-services-hero.png"
    imageAlt="Dog services and pet resources"
  />

  <Section
    title="Browse by business type"
    intro="Start with a dog service category, then search by business name, city, province, or nearby location."
  >
    <div class="directory-category-grid">
      {categories.map((category) => (
        <article class="directory-category-card">
          <img src={category.image} alt={`${category.title} category`} loading="lazy" decoding="async" />
          <div class="directory-category-card-body">
            <p class="small">{category.status}</p>
            <h3><a href={category.href}>{category.title}</a></h3>
            <p>{category.summary}</p>
            <a class="button secondary" href={category.href}>{category.cta}</a>
          </div>
        </article>
      ))}
    </div>
  </Section>

  <Section
    title="Search dog businesses"
    intro="Find dog services and pet resources by name, category, city, province, or nearby location."
  >
    <BusinessDirectorySearch />
  </Section>

  <Section
    id="add-business"
    title="Add a business listing"
    intro="Submit a Canadian dog service, pet business, rescue, shelter, or veterinary clinic for review in the LeashFree.ca directory."
    alt
  >
    <div class="add-business-listing-panel">
      <div data-quizflow-embed="add-a-business-listing-leashfree-ca" data-quizflow-mode="fullpage"></div>
    </div>
    <script async src="https://quizflowlabs.com/embed.js"></script>
  </Section>

  <Section id="listings" title="Directory listings" intro={`${directories.length} dog service and pet resource listings.`}>
    <div class="grid">
      {directories.map((item) => (
        <Card
          title={item.name}
          href={`/directory/${item.slug}/`}
          description={excerpt(item.metaDescription, item.description)}
          image={resolveMedia(item, "Featured Image", mediaMap).src}
          imageAlt={`${item.name} listing`}
          meta={[item.raw.City, item.raw.Province].filter(Boolean).join(", ")}
          badges={[item.references.Category?.[0] || item.raw.Category || ""].filter(Boolean)}
          ctaLabel="View listing"
        />
      ))}
    </div>
  </Section>
</Layout>
