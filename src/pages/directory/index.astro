---
import Card from "../../components/Card.astro";
import BusinessDirectorySearch from "../../components/BusinessDirectorySearch.astro";
import Hero from "../../components/Hero.astro";
import Layout from "../../components/Layout.astro";
import Section from "../../components/Section.astro";
import mediaMap from "../../data/media-map.json";
import directories from "../../data/generated/directories.json";
import { excerpt, breadcrumbSchema } from "../../utils/content.js";
import { resolveMedia } from "../../utils/media.js";

const breadcrumbs = [
  { label: "Home", href: "/" },
  { label: "Directory", href: "/directory/" }
];
---

<Layout
  title="Dog Services Directory"
  description="Browse LeashFree.ca directory listings for dog services and pet resources."
  canonical="https://leashfree.ca/directory/"
  structuredData={breadcrumbSchema(breadcrumbs)}
>
  <Hero
    eyebrow="Directory"
    title="Dog services and pet resources"
    summary="Find rescues, clinics, pet stores, trainers, groomers, and other dog-related services."
    primaryHref="#listings"
    primaryLabel="Browse listings"
    image="/images/general/category-veterinarians-hero.jpg"
    imageAlt="Dog services and pet resources"
  />

  <Section
    title="Search dog businesses"
    intro="Find dog services and pet resources by name, category, city, province, or nearby location."
  >
    <BusinessDirectorySearch />
  </Section>

  <Section id="listings" title="Directory listings" intro={`${directories.length} dog service and pet resource listings.`}>
    <div class="grid">
      {directories.map((item) => (
        <Card
          title={item.name}
          href={`/directory/${item.slug}/`}
          description={excerpt(item.metaDescription, item.description)}
          image={resolveMedia(item, "Featured Image", mediaMap).src}
          imageAlt={`${item.name} listing`}
          meta={[item.raw.City, item.raw.Province].filter(Boolean).join(", ")}
          badges={[item.references.Category?.[0] || item.raw.Category || ""].filter(Boolean)}
          ctaLabel="View listing"
        />
      ))}
    </div>
  </Section>
</Layout>
